+func TestOutputFeedback(t *testing.T) {
+	report := make([]byte, OutputReportSize)
+	report[0] = ReportIDOutput
+	report[1] = 0x03
+	report[2] = 0x04
+	report[3] = 0x21
+	report[4] = 0xDC
+	report[11] = 0xAA
+	report[21] = 0xBB
+	report[22] = 0xCC
+	report[32] = 0xDD
+	report[39] = 0x40
+
+	feedback, ok := parseOutputReport(report)
+	if !ok {
+		t.Fatal("output report was not parsed")
+	}
+	requireEqual(t, feedback.EnableBits1, uint8(0x03), "enable bits 1")
+	requireEqual(t, feedback.EnableBits2, uint8(0x04), "enable bits 2")
+	requireEqual(t, feedback.RumbleRight, uint8(0x21), "right rumble")
+	requireEqual(t, feedback.RumbleLeft, uint8(0xDC), "left rumble")
+	requireEqual(t, feedback.RightTriggerEffect[0], uint8(0xAA), "right trigger first byte")
+	requireEqual(t, feedback.RightTriggerEffect[10], uint8(0xBB), "right trigger last byte")
+	requireEqual(t, feedback.LeftTriggerEffect[0], uint8(0xCC), "left trigger first byte")
+	requireEqual(t, feedback.LeftTriggerEffect[10], uint8(0xDD), "left trigger last byte")
+	requireEqual(t, feedback.EnableBits3, uint8(0x40), "enable bits 3")
+
+	bluetoothReport := make([]byte, 78)
+	bluetoothReport[0] = ReportIDBluetoothEffects
+	bluetoothReport[2] = 0x10
+	bluetoothReport[3] = 0x01
+	bluetoothReport[5] = 0x77
+	bluetoothReport[6] = 0x88
+	bluetoothFeedback, ok := parseOutputReport(bluetoothReport)
+	if !ok {
+		t.Fatal("bluetooth-style output report was not parsed")
+	}
+	requireEqual(t, bluetoothFeedback.RumbleRight, uint8(0x77), "bluetooth right rumble")
+	requireEqual(t, bluetoothFeedback.RumbleLeft, uint8(0x88), "bluetooth left rumble")
+
+	data, err := feedback.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireEqual(t, len(data), 27, "feedback wire size")
+
+	var roundTrip OutputState
+	if err := roundTrip.UnmarshalBinary(data); err != nil {
+		t.Fatal(err)
+	}
+	requireEqual(t, roundTrip, feedback, "feedback round trip")
+}
+
+func containsReportID(report []byte, id byte) bool {
+	for i := 0; i+1 < len(report); i++ {
+		if report[i] == 0x85 && report[i+1] == id {
+			return true
+		}
+	}
+	return false
+}
+
+func TestOutputCallback(t *testing.T) {
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got OutputState
+	called := false
+	dev.SetOutputCallback(func(frame FeedbackFrame) {
+		got = frame.HID
+		called = true
+	})
+
+	report := make([]byte, OutputReportSize)
+	report[0] = ReportIDOutput
+	report[3] = 0x44
+	report[4] = 0x55
+	dev.HandleTransfer(3, usbip.DirOut, report)
+
+	if !called {
+		t.Fatal("output callback was not called")
+	}
+	requireEqual(t, got.RumbleRight, uint8(0x44), "callback right rumble")
+	requireEqual(t, got.RumbleLeft, uint8(0x55), "callback left rumble")
+}
+
+func TestAudioHapticsIsoFeedback(t *testing.T) {
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got FeedbackFrame
+	called := false
+	dev.SetOutputCallback(func(frame FeedbackFrame) {
+		got = frame
+		called = true
+	})
+
+	pcm := make([]byte, 240*8)
+	leftSample := int16(12000)
+	rightSample := int16(-18000)
+	for i := 0; i < 240; i++ {
+		base := i * 8
+		binary.LittleEndian.PutUint16(pcm[base+4:base+6], uint16(leftSample))
+		binary.LittleEndian.PutUint16(pcm[base+6:base+8], uint16(rightSample))
+	}
+	resp, packets := dev.HandleIsoTransfer(1, usbip.DirOut, pcm, []usb.IsoPacket{
+		{Offset: 0, Length: uint32(len(pcm))},
+	})
+	if len(resp) != 0 {
+		t.Fatal("audio OUT should not return payload")
+	}
+	requireEqual(t, len(packets), 1, "iso response packet count")
+	requireEqual(t, packets[0].ActualLength, uint32(len(pcm)), "iso actual length")
+	if !called {
+		t.Fatal("audio haptics callback was not called")
+	}
+	requireEqual(t, got.Type, uint8(FeedbackFrameAudioHaptics), "audio frame type")
+	requireEqual(t, got.Audio.Sequence, uint32(1), "audio sequence")
+	if got.Audio.LeftEnergy == 0 || got.Audio.RightEnergy == 0 {
+		t.Fatal("audio energy was not extracted from haptic channels")
+	}
+	if got.Audio.RightEnergy <= got.Audio.LeftEnergy {
+		t.Fatal("right audio energy should be higher than left in test PCM")
+	}
+}
+
+func TestAudioHapticsIgnoresSpeakerAudio(t *testing.T) {
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	called := false
+	dev.SetOutputCallback(func(frame FeedbackFrame) {
+		if frame.Type == FeedbackFrameAudioHaptics {
+			called = true
+		}
+	})
+
+	pcm := make([]byte, 240*8)
+	putS16 := func(dst []byte, v int16) {
+		binary.LittleEndian.PutUint16(dst, uint16(v))
+	}
+	for i := 0; i < 240; i++ {
+		base := i * 8
+		putS16(pcm[base:base+2], 18000)
+		putS16(pcm[base+2:base+4], -16000)
+		putS16(pcm[base+4:base+6], 60)
+		putS16(pcm[base+6:base+8], -40)
+	}
+	dev.HandleIsoTransfer(1, usbip.DirOut, pcm, []usb.IsoPacket{
+		{Offset: 0, Length: uint32(len(pcm))},
+	})
+	if called {
+		t.Fatal("speaker audio was incorrectly emitted as haptic feedback")
+	}
+}
