+package dualsense
+
+const (
+	DefaultVID = 0x054C
+	DefaultPID = 0x0CE6
+)
+
+const (
+	EndpointAudioOut = 0x01
+	EndpointAudioIn  = 0x82
+	EndpointIn       = 0x84
+	EndpointOut      = 0x03
+)
+
+const (
+	ReportIDInput            = 0x01
+	ReportIDOutput           = 0x02
+	ReportIDBluetoothEffects = 0x31
+)
+
+const (
+	InputReportSize  = 64
+	OutputReportSize = 48
+)
+
+const (
+	FeedbackFrameHIDOutput    = 0x01
+	FeedbackFrameAudioHaptics = 0x02
+)
+
+const (
+	ButtonPS            uint16 = 0x0001
+	ButtonTouchpadClick uint16 = 0x0002
+	ButtonMute          uint16 = 0x0004
+	ButtonSquare        uint16 = 0x0010
+	ButtonCross         uint16 = 0x0020
+	ButtonCircle        uint16 = 0x0040
+	ButtonTriangle      uint16 = 0x0080
+	ButtonL1            uint16 = 0x0100
+	ButtonR1            uint16 = 0x0200
+	ButtonL2            uint16 = 0x0400
+	ButtonR2            uint16 = 0x0800
+	ButtonCreate        uint16 = 0x1000
+	ButtonOptions       uint16 = 0x2000
+	ButtonL3            uint16 = 0x4000
+	ButtonR3            uint16 = 0x8000
+)
+
+const (
+	DPadUp    = 0x01
+	DPadDown  = 0x02
+	DPadLeft  = 0x04
+	DPadRight = 0x08
+)
+
+const (
+	DPadUSBUp        = 0x00
+	DPadUSBUpRight   = 0x01
+	DPadUSBRight     = 0x02
+	DPadUSBDownRight = 0x03
+	DPadUSBDown      = 0x04
+	DPadUSBDownLeft  = 0x05
+	DPadUSBLeft      = 0x06
+	DPadUSBUpLeft    = 0x07
+	DPadUSBNeutral   = 0x08
+)
+
+const (
+	TouchInactiveMask uint8  = 0x80
+	TouchpadMaxX      uint16 = 1919
+	TouchpadMaxY      uint16 = 1069
+)
+
+const (
+	DS5EnableRumbleEmulation  = 0x01
+	DS5DisableAudioHaptics    = 0x02
+	DS5EnableImprovedRumble   = 0x04
+	DS5ConnectionStateUSB     = 0x08
+	DS5BatteryStatusDischarge = 0x00
+	DS5BatteryStatusCharging  = 0x01
+	DS5BatteryStatusFull      = 0x02
+)
diff --git a/device/dualsense/device.go b/device/dualsense/device.go
new file mode 100644
index 0000000..9957b97
--- /dev/null
+++ b/device/dualsense/device.go
@@ -0,0 +1,920 @@
+package dualsense
+
+import (
+	"encoding/binary"
+	"log/slog"
+	"sync"
+
+	"github.com/Alia5/VIIPER/device"
+	"github.com/Alia5/VIIPER/usb"
+	"github.com/Alia5/VIIPER/usb/hid"
+	"github.com/Alia5/VIIPER/usbip"
+)
+
+type DualSense struct {
+	inputState *InputState
+	stateMu    sync.Mutex
+	outputFunc func(FeedbackFrame)
+	descriptor usb.Descriptor
+
+	reportCounter   uint8
+	packetSequence  uint32
+	sensorTimestamp uint32
+	touch1Tracking  uint8
+	touch2Tracking  uint8
+	touch1WasActive bool
+	touch2WasActive bool
+
+	interfaceAlt   [4]uint8
+	audioMu        sync.Mutex
+	audioSeq       uint32
+	audioFrames    uint32
+	audioFrontSum  uint64
+	audioLeftSum   uint64
+	audioRightSum  uint64
+	audioFrontPeak uint16
+	audioLeftPeak  uint16
+	audioRightPeak uint16
+	audioLastLeft  uint16
+	audioLastRight uint16
+}
+
+type inputReportState struct {
+	input           InputState
+	reportCounter   uint8
+	packetSequence  uint32
+	sensorTimestamp uint32
+	touch1Tracking  uint8
+	touch2Tracking  uint8
+}
+
+func New(o *device.CreateOptions) (*DualSense, error) {
+	d := &DualSense{
+		descriptor: defaultDescriptor,
+	}
+	if o != nil {
+		if o.IdVendor != nil {
+			d.descriptor.Device.IDVendor = *o.IdVendor
+		}
+		if o.IdProduct != nil {
+			d.descriptor.Device.IDProduct = *o.IdProduct
+		}
+	}
+
+	d.inputState = &InputState{
+		LX:                  0x80,
+		LY:                  0x80,
+		RX:                  0x80,
+		RY:                  0x80,
+		BatteryLevelPercent: 100,
+		ChargeState:         DS5BatteryStatusFull,
+	}
+
+	return d, nil
+}
+
+func (d *DualSense) SetOutputCallback(f func(FeedbackFrame)) {
+	d.outputFunc = f
+}
+
+func (d *DualSense) UpdateInputState(state *InputState) {
+	d.stateMu.Lock()
+	defer d.stateMu.Unlock()
+
+	if state.Touch1Active && !d.touch1WasActive {
+		d.touch1Tracking = (d.touch1Tracking + 1) & 0x7F
+	}
+	if state.Touch2Active && !d.touch2WasActive {
+		d.touch2Tracking = (d.touch2Tracking + 1) & 0x7F
+	}
+	d.touch1WasActive = state.Touch1Active
+	d.touch2WasActive = state.Touch2Active
+	d.reportCounter++
+	d.packetSequence++
+	d.sensorTimestamp += 12000
+	st := *state
+	d.inputState = &st
+}
+
+func (d *DualSense) inputReportState() inputReportState {
+	d.stateMu.Lock()
+	defer d.stateMu.Unlock()
+	return inputReportState{
+		input:           *d.inputState,
+		reportCounter:   d.reportCounter,
+		packetSequence:  d.packetSequence,
+		sensorTimestamp: d.sensorTimestamp,
+		touch1Tracking:  d.touch1Tracking,
+		touch2Tracking:  d.touch2Tracking,
+	}
+}
+
+func (d *DualSense) HandleTransfer(ep uint32, dir uint32, out []byte) []byte {
+	if dir == usbip.DirIn {
+		switch ep {
+		case 4:
+			return d.buildUSBInputReport(d.inputReportState())
+		default:
+			return nil
+		}
+	}
+
+	if dir == usbip.DirOut && ep == 3 {
+		if feedback, ok := parseOutputReport(out); ok && d.outputFunc != nil {
+			d.outputFunc(FeedbackFrame{Type: FeedbackFrameHIDOutput, HID: feedback})
+		}
+	}
+
+	return nil
+}
+
+func (d *DualSense) HandleIsoTransfer(ep uint32, dir uint32, out []byte, packets []usb.IsoPacket) ([]byte, []usb.IsoPacket) {
+	if dir == usbip.DirOut && ep == 1 {
+		d.consumeAudioHaptics(out)
+		return nil, completeIsoPackets(packets, out)
+	}
+	if dir == usbip.DirIn && ep == 2 {
+		data := make([]byte, isoPayloadLength(packets, 196))
+		return data, completeIsoPackets(packets, data)
+	}
+	return nil, completeIsoPackets(packets, out)
+}
+
+func (d *DualSense) SetInterfaceAlt(interfaceNumber, alternateSetting uint8) {
+	if int(interfaceNumber) >= len(d.interfaceAlt) {
+		return
+	}
+	d.interfaceAlt[interfaceNumber] = alternateSetting
+}
+
+func (d *DualSense) GetInterfaceAlt(interfaceNumber uint8) uint8 {
+	if int(interfaceNumber) >= len(d.interfaceAlt) {
+		return 0
+	}
+	return d.interfaceAlt[interfaceNumber]
+}
+
+func (d *DualSense) HandleControl(bmRequestType, bRequest uint8, wValue, wIndex, wLength uint16, data []byte) ([]byte, bool) {
+	const (
+		hidGetReport = 0x01
+		hidSetIdle   = 0x0A
+		hidSetReport = 0x09
+	)
+	const (
+		reportTypeInput   = 0x01
+		reportTypeOutput  = 0x02
+		reportTypeFeature = 0x03
+	)
+
+	reportType := uint8(wValue >> 8)
+	reportID := uint8(wValue & 0xFF)
+
+	if bmRequestType == 0xA1 && bRequest == hidGetReport {
+		if reportType == reportTypeInput && reportID == ReportIDInput {
+			report := d.buildUSBInputReport(d.inputReportState())
+			if wLength > 0 && int(wLength) < len(report) {
+				return report[:wLength], true
+			}
+			return report, true
+		}
+
+		if reportType == reportTypeFeature {
+			var report []byte
+			switch reportID {
+			case 0x03:
+				report = buildCapabilitiesFeatureReport()
+			case 0x05:
+				report = buildCalibrationFeatureReport()
+			case 0x09:
+				report = buildSerialFeatureReport()
+			case 0x20:
+				report = buildFirmwareFeatureReport()
+			default:
+				report = buildGenericFeatureReport(reportID)
+			}
+			if len(report) > 0 {
+				return fitReportLength(report, wLength), true
+			}
+		}
+	}
+
+	if bmRequestType == 0x21 && bRequest == hidSetReport {
+		if reportType == reportTypeOutput &&
+			(reportID == ReportIDOutput || reportID == ReportIDBluetoothEffects) {
+			if feedback, ok := parseOutputReport(data); ok {
+				if d.outputFunc != nil {
+					d.outputFunc(FeedbackFrame{Type: FeedbackFrameHIDOutput, HID: feedback})
+				}
+				return nil, true
+			}
+		}
+	}
+
+	if bmRequestType == 0x21 && bRequest == hidSetIdle {
+		return nil, true
+	}
+
+	if (bmRequestType == 0x21 || bmRequestType == 0x22 ||
+		bmRequestType == 0xA1 || bmRequestType == 0xA2) &&
+		uint8(wIndex&0xff) != 0x03 {
+		return d.handleAudioClassControl(bRequest, wValue, wLength, data), true
+	}
+
+	slog.Warn("Unsupported DualSense control request",
+		"bmRequestType", bmRequestType,
+		"bRequest", bRequest,
+		"reportType", reportType,
+		"reportID", reportID)
+
+	return nil, false
+}
+
+func parseOutputReport(data []byte) (OutputState, bool) {
+	if len(data) >= OutputReportSize && data[0] == ReportIDOutput {
+		data = data[1:]
+	} else if len(data) >= 78 && data[0] == ReportIDBluetoothEffects {
+		data = data[3:]
+	}
+	if len(data) < 47 {
+		return OutputState{}, false
+	}
+
+	var feedback OutputState
+	feedback.EnableBits1 = data[0]
+	feedback.EnableBits2 = data[1]
+	feedback.RumbleRight = data[2]
+	feedback.RumbleLeft = data[3]
+	copy(feedback.RightTriggerEffect[:], data[10:21])
+	copy(feedback.LeftTriggerEffect[:], data[21:32])
+	feedback.EnableBits3 = data[38]
+	return feedback, true
+}
+
+func isoPayloadLength(packets []usb.IsoPacket, fallback uint32) int {
+	var total uint32
+	for _, pkt := range packets {
+		total += pkt.Length
+	}
+	if total == 0 && len(packets) > 0 {
+		total = fallback * uint32(len(packets))
+	}
+	return int(total)
+}
+
+func completeIsoPackets(packets []usb.IsoPacket, data []byte) []usb.IsoPacket {
+	out := make([]usb.IsoPacket, len(packets))
+	for i, pkt := range packets {
+		out[i] = pkt
+		if pkt.Length > 0 {
+			out[i].ActualLength = pkt.Length
+		}
+		if int(pkt.Offset+pkt.Length) > len(data) && pkt.Offset < uint32(len(data)) {
+			out[i].ActualLength = uint32(len(data)) - pkt.Offset
+		}
+		out[i].Status = 0
+	}
+	return out
+}
+
+func (d *DualSense) consumeAudioHaptics(data []byte) {
+	if len(data) < 8 {
+		return
+	}
+
+	d.audioMu.Lock()
+	defer d.audioMu.Unlock()
+
+	for i := 0; i+7 < len(data); i += 8 {
+		frontLeft := absS16(int16(binary.LittleEndian.Uint16(data[i : i+2])))
+		frontRight := absS16(int16(binary.LittleEndian.Uint16(data[i+2 : i+4])))
+		left := absS16(int16(binary.LittleEndian.Uint16(data[i+4 : i+6])))
+		right := absS16(int16(binary.LittleEndian.Uint16(data[i+6 : i+8])))
+		d.audioFrontSum += uint64(frontLeft) + uint64(frontRight)
+		d.audioLeftSum += uint64(left)
+		d.audioRightSum += uint64(right)
+		if frontLeft > d.audioFrontPeak {
+			d.audioFrontPeak = frontLeft
+		}
+		if frontRight > d.audioFrontPeak {
+			d.audioFrontPeak = frontRight
+		}
+		if left > d.audioLeftPeak {
+			d.audioLeftPeak = left
+		}
+		if right > d.audioRightPeak {
+			d.audioRightPeak = right
+		}
+		d.audioFrames++
+		if d.audioFrames >= 240 {
+			d.flushAudioHapticsLocked()
+		}
+	}
+}
+
+func (d *DualSense) flushAudioHapticsLocked() {
+	if d.audioFrames == 0 || d.outputFunc == nil {
+		d.resetAudioAccumulatorLocked()
+		return
+	}
+
+	frontAvg := d.audioFrontSum / uint64(d.audioFrames*2)
+	hapticAvg := (d.audioLeftSum + d.audioRightSum) / uint64(d.audioFrames*2)
+	if looksLikeSpeakerAudio(frontAvg, hapticAvg, d.audioFrontPeak, d.audioLeftPeak, d.audioRightPeak) {
+		d.resetAudioAccumulatorLocked()
+		return
+	}
+
+	left := scaleAudioEnergy(d.audioLeftSum / uint64(d.audioFrames))
+	right := scaleAudioEnergy(d.audioRightSum / uint64(d.audioFrames))
+	leftPeak := scaleAudioEnergy(uint64(d.audioLeftPeak))
+	rightPeak := scaleAudioEnergy(uint64(d.audioRightPeak))
+	leftTransient := uint16(0)
+	rightTransient := uint16(0)
+	if left > d.audioLastLeft {
+		leftTransient = left - d.audioLastLeft
+	}
+	if right > d.audioLastRight {
+		rightTransient = right - d.audioLastRight
+	}
+
+	d.audioSeq++
+	frame := FeedbackFrame{
+		Type: FeedbackFrameAudioHaptics,
+		Audio: AudioHapticsState{
+			Sequence:       d.audioSeq,
+			LeftEnergy:     left,
+			RightEnergy:    right,
+			LeftPeak:       leftPeak,
+			RightPeak:      rightPeak,
+			LeftTransient:  leftTransient,
+			RightTransient: rightTransient,
+		},
+	}
+	d.audioLastLeft = left
+	d.audioLastRight = right
+	d.resetAudioAccumulatorLocked()
+
+	d.outputFunc(frame)
+}
+
+func (d *DualSense) resetAudioAccumulatorLocked() {
+	d.audioFrames = 0
+	d.audioFrontSum = 0
+	d.audioLeftSum = 0
+	d.audioRightSum = 0
+	d.audioFrontPeak = 0
+	d.audioLeftPeak = 0
+	d.audioRightPeak = 0
+}
+
+func absS16(v int16) uint16 {
+	if v == -32768 {
+		return 32768
+	}
+	if v < 0 {
+		return uint16(-v)
+	}
+	return uint16(v)
+}
+
+func scaleAudioEnergy(value uint64) uint16 {
+	const noiseFloor = 128
+	if value <= noiseFloor {
+		return 0
+	}
+	scaled := (value - noiseFloor) * 3
+	if scaled > 0xFFFF {
+		scaled = 0xFFFF
+	}
+	return uint16(scaled)
+}
+
+func looksLikeSpeakerAudio(frontAvg, hapticAvg uint64, frontPeak, leftPeak, rightPeak uint16) bool {
+	const speakerNoiseFloor = 256
+	if frontAvg <= speakerNoiseFloor || frontPeak <= 1000 {
+		return false
+	}
+	hapticPeak := leftPeak
+	if rightPeak > hapticPeak {
+		hapticPeak = rightPeak
+	}
+	if hapticAvg <= 48 && hapticPeak <= 256 {
+		return true
+	}
+	return hapticAvg*8 <= frontAvg &&
+		uint64(hapticPeak)*8 <= uint64(frontPeak) &&
+		hapticPeak < 1200
+}
+
+func (d *DualSense) handleAudioClassControl(bRequest uint8, wValue, wLength uint16, data []byte) []byte {
+	const (
+		audioSetCur = 0x01
+		audioGetCur = 0x81
+		audioGetMin = 0x82
+		audioGetMax = 0x83
+		audioGetRes = 0x84
+	)
+
+	control := uint8(wValue >> 8)
+	switch bRequest {
+	case audioSetCur:
+		return nil
+	case audioGetCur, audioGetMin, audioGetMax, audioGetRes:
+		resp := make([]byte, wLength)
+		if control == 0x01 && len(resp) >= 1 {
+			resp[0] = 0 // mute off
+		}
+		if control == 0x02 && len(resp) >= 2 {
+			// UAC1 signed 8.8 dB volume. Use a sane 0 dB current/max.
+			if bRequest == audioGetMin {
+				binary.LittleEndian.PutUint16(resp[:2], 0xD000)
+			} else if bRequest == audioGetRes {
+				binary.LittleEndian.PutUint16(resp[:2], 0x0100)
+			}
+		}
+		if control == 0x01 && len(resp) >= 3 {
+			resp[0] = 0x80
+			resp[1] = 0xBB
+			resp[2] = 0x00
+		}
+		_ = data
+		return resp
+	default:
+		return make([]byte, wLength)
+	}
+}
+
+func (d *DualSense) GetDescriptor() *usb.Descriptor {
+	return &d.descriptor
+}
+
+func (d *DualSense) GetDeviceSpecificArgs() map[string]any {
+	return map[string]any{}
+}
+
+func (d *DualSense) buildUSBInputReport(snapshot inputReportState) []byte {
+	s := snapshot.input
+	b := make([]byte, InputReportSize)
+	b[0] = ReportIDInput
+	b[1] = s.LX
+	b[2] = s.LY
+	b[3] = s.RX
+	b[4] = s.RY
+	b[5] = s.L2
+	b[6] = s.R2
+	b[7] = snapshot.reportCounter
+
+	b[8] = dpadToHat(s.DPad) | faceButtonsNibble(s.Buttons)
+	b[9] = shoulderButtonsByte(s.Buttons)
+	b[10] = systemButtonsByte(s.Buttons)
+	b[11] = 0
+
+	binary.LittleEndian.PutUint32(b[12:16], snapshot.packetSequence)
+	binary.LittleEndian.PutUint16(b[16:18], uint16(s.GyroX))
+	binary.LittleEndian.PutUint16(b[18:20], uint16(s.GyroY))
+	binary.LittleEndian.PutUint16(b[20:22], uint16(s.GyroZ))
+	binary.LittleEndian.PutUint16(b[22:24], uint16(s.AccelX))
+	binary.LittleEndian.PutUint16(b[24:26], uint16(s.AccelY))
+	binary.LittleEndian.PutUint16(b[26:28], uint16(s.AccelZ))
+	binary.LittleEndian.PutUint32(b[28:32], snapshot.sensorTimestamp)
+	b[32] = 0
+
+	touch1Counter := snapshot.touch1Tracking & 0x7F
+	if !s.Touch1Active {
+		touch1Counter |= TouchInactiveMask
+	}
+	b[33] = touch1Counter
+	encodeTouchCoords(b[34:37], s.Touch1X, s.Touch1Y)
+
+	touch2Counter := snapshot.touch2Tracking & 0x7F
+	if !s.Touch2Active {
+		touch2Counter |= TouchInactiveMask
+	}
+	b[37] = touch2Counter
+	encodeTouchCoords(b[38:41], s.Touch2X, s.Touch2Y)
+
+	binary.LittleEndian.PutUint32(b[49:53], snapshot.sensorTimestamp)
+	b[53] = batteryByte(s.BatteryLevelPercent, s.ChargeState)
+	b[54] = DS5ConnectionStateUSB
+	return b
+}
+
+func dpadToHat(dpad uint8) uint8 {
+	if dpad&DPadUp != 0 && dpad&DPadRight != 0 {
+		return DPadUSBUpRight
+	}
+	if dpad&DPadUp != 0 && dpad&DPadLeft != 0 {
+		return DPadUSBUpLeft
+	}
+	if dpad&DPadDown != 0 && dpad&DPadRight != 0 {
+		return DPadUSBDownRight
+	}
+	if dpad&DPadDown != 0 && dpad&DPadLeft != 0 {
+		return DPadUSBDownLeft
+	}
+	if dpad&DPadUp != 0 {
+		return DPadUSBUp
+	}
+	if dpad&DPadDown != 0 {
+		return DPadUSBDown
+	}
+	if dpad&DPadLeft != 0 {
+		return DPadUSBLeft
+	}
+	if dpad&DPadRight != 0 {
+		return DPadUSBRight
+	}
+	return DPadUSBNeutral
+}
+
+func faceButtonsNibble(buttons uint16) uint8 {
+	var face uint8
+	if buttons&ButtonSquare != 0 {
+		face |= 0x01
+	}
+	if buttons&ButtonCross != 0 {
+		face |= 0x02
+	}
+	if buttons&ButtonCircle != 0 {
+		face |= 0x04
+	}
+	if buttons&ButtonTriangle != 0 {
+		face |= 0x08
+	}
+	return face << 4
+}
+
+func shoulderButtonsByte(buttons uint16) uint8 {
+	var out uint8
+	if buttons&ButtonL1 != 0 {
+		out |= 0x01
+	}
+	if buttons&ButtonR1 != 0 {
+		out |= 0x02
+	}
+	if buttons&ButtonL2 != 0 {
+		out |= 0x04
+	}
+	if buttons&ButtonR2 != 0 {
+		out |= 0x08
+	}
+	if buttons&ButtonCreate != 0 {
+		out |= 0x10
+	}
+	if buttons&ButtonOptions != 0 {
+		out |= 0x20
+	}
+	if buttons&ButtonL3 != 0 {
+		out |= 0x40
+	}
+	if buttons&ButtonR3 != 0 {
+		out |= 0x80
+	}
+	return out
+}
+
+func systemButtonsByte(buttons uint16) uint8 {
+	var out uint8
+	if buttons&ButtonPS != 0 {
+		out |= 0x01
+	}
+	if buttons&ButtonTouchpadClick != 0 {
+		out |= 0x02
+	}
+	if buttons&ButtonMute != 0 {
+		out |= 0x04
+	}
+	return out
+}
+
+func encodeTouchCoords(b []byte, x, y uint16) {
+	if x > TouchpadMaxX {
+		x = TouchpadMaxX
+	}
+	if y > TouchpadMaxY {
+		y = TouchpadMaxY
+	}
+
+	b[0] = uint8(x & 0xFF)
+	b[1] = uint8((x>>8)&0x0F) | uint8((y&0x0F)<<4)
+	b[2] = uint8(y >> 4)
+}
+
+func batteryByte(levelPercent, chargeState uint8) uint8 {
+	level := levelPercent / 10
+	if level > 10 {
+		level = 10
+	}
+
+	status := uint8(DS5BatteryStatusDischarge)
+	switch chargeState {
+	case 2:
+		status = DS5BatteryStatusCharging
+	case 4:
+		status = DS5BatteryStatusFull
+	}
+	return (status << 4) | (level & 0x0F)
+}
+
+func buildCalibrationFeatureReport() []byte {
+	b := make([]byte, 41)
+	b[0] = 0x05
+	putS16 := func(offset int, value int16) {
+		binary.LittleEndian.PutUint16(b[offset:offset+2], uint16(value))
+	}
+	putS16(1, 0)
+	putS16(3, 0)
+	putS16(5, 0)
+	putS16(7, 1024)
+	putS16(9, -1024)
+	putS16(11, 1024)
+	putS16(13, -1024)
+	putS16(15, 1024)
+	putS16(17, -1024)
+	putS16(19, 64)
+	putS16(21, 64)
+	putS16(23, 8192)
+	putS16(25, -8192)
+	putS16(27, 8192)
+	putS16(29, -8192)
+	putS16(31, 8192)
+	putS16(33, -8192)
+	return b
+}
+
+func buildSerialFeatureReport() []byte {
+	b := make([]byte, 20)
+	b[0] = 0x09
+	copy(b[1:], []byte{0xC0, 0x13, 0x37, 0x05, 0x02, 0x06})
+	copy(b[7:], []byte{0x08, 0x25, 0x00})
+	return b
+}
+
+func buildCapabilitiesFeatureReport() []byte {
+	b := make([]byte, 48)
+	b[0] = 0x03
+	b[2] = 0x28
+	b[4] = 0x02 | 0x04 | 0x08 | 0x40
+	b[5] = 0x00
+	b[20] = 0x80 | 0x01
+	return b
+}
+
+func buildGenericFeatureReport(reportID uint8) []byte {
+	sizes := map[uint8]int{
+		0x08: 48,
+		0x0A: 27,
+		0x21: 5,
+		0x22: 64,
+		0x80: 64,
+		0x81: 64,
+		0x82: 10,
+		0x83: 64,
+		0x84: 64,
+		0x85: 3,
+		0xA0: 2,
+		0xE0: 64,
+		0xF0: 64,
+		0xF1: 64,
+		0xF2: 16,
+		0xF4: 64,
+		0xF5: 4,
+	}
+	size, ok := sizes[reportID]
+	if !ok {
+		return nil
+	}
+	b := make([]byte, size)
+	b[0] = reportID
+	return b
+}
+
+func fitReportLength(report []byte, wLength uint16) []byte {
+	if wLength == 0 {
+		return report
+	}
+	size := int(wLength)
+	if len(report) == size {
+		return report
+	}
+	fit := make([]byte, size)
+	copy(fit, report)
+	return fit
+}
+
+func buildFirmwareFeatureReport() []byte {
+	b := make([]byte, 64)
+	b[0] = 0x20
+
+	// Mirror VIIPER v0.7.0's report captured from a current BDM-050/060
+	// DualSense. Native PC games gate compatible-vibration v2 and adaptive
+	// trigger support on this report; the old 0x0224 value is rejected by
+	// newer titles as obsolete controller firmware.
+	copy(b[1:12], []byte("Jul 04 2025"))
+	copy(b[12:20], []byte("10:10:32"))
+	b[20] = 0x03 // HardwareType
+	b[21] = 0x01
+	b[22] = 0x44
+	binary.LittleEndian.PutUint32(b[24:28], 0x01000208) // HardwareInfo
+	b[28] = 0x36
+	b[31] = 0x01
+	b[32] = 0xC1
+	b[33] = 0xC8
+	binary.LittleEndian.PutUint16(b[44:46], 0x0630) // UpdateVersion
+	b[48] = 0x14
+	b[52] = 0x0B
+	b[54] = 0x01
+	b[56] = 0x06
+	return b
+}
