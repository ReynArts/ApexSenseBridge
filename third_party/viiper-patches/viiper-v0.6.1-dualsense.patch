+func TestDescriptorAndFeatureReports(t *testing.T) {
+	vendor := uint16(0x1234)
+	product := uint16(0x5678)
+	dev, err := New(&device.CreateOptions{IdVendor: &vendor, IdProduct: &product})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	desc := dev.GetDescriptor()
+	requireEqual(t, desc.Device.IDVendor, vendor, "vendor override")
+	requireEqual(t, desc.Device.IDProduct, product, "product override")
+	requireEqual(t, desc.Device.ISerialNumber, uint8(0), "usb serial string index")
+	requireEqual(t, desc.Strings[1], "Sony Interactive Entertainment", "manufacturer string")
+	requireEqual(t, desc.Strings[2], "Wireless Controller", "product string")
+	requireEqual(t, desc.Interfaces[0].Descriptor.BInterfaceClass, uint8(0x01), "audio control interface class")
+	requireEqual(t, desc.Interfaces[2].Endpoints[0].BEndpointAddress, uint8(EndpointAudioOut), "audio output endpoint")
+	requireEqual(t, desc.Interfaces[4].Endpoints[0].BEndpointAddress, uint8(EndpointAudioIn), "audio input endpoint")
+	requireEqual(t, desc.Interfaces[5].Descriptor.BInterfaceClass, uint8(0x03), "hid interface class")
+	requireEqual(t, desc.Interfaces[5].Endpoints[0].BEndpointAddress, uint8(EndpointIn), "input endpoint")
+	requireEqual(t, desc.Interfaces[5].Endpoints[1].BEndpointAddress, uint8(EndpointOut), "output endpoint")
+
+	report, err := desc.Interfaces[5].HID.ReportBytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(report) == 0 {
+		t.Fatal("empty report descriptor")
+	}
+	requireEqual(t, len(report), 273, "hid report descriptor length")
+	if !containsReportID(report, 0x05) {
+		t.Fatal("report descriptor does not declare calibration feature report 0x05")
+	}
+
+	for _, tc := range []struct {
+		name    string
+		wValue  uint16
+		wLength uint16
+		wantID  byte
+	}{
+		{"capabilities", 0x0303, 48, 0x03},
+		{"calibration", 0x0305, 41, 0x05},
+		{"serial", 0x0309, 20, 0x09},
+		{"firmware", 0x0320, 64, 0x20},
+		{"generic", 0x0380, 64, 0x80},
+	} {
+		resp, handled := dev.HandleControl(0xA1, 0x01, tc.wValue, 0, tc.wLength, nil)
+		if !handled {
+			t.Fatalf("%s: feature report was not handled", tc.name)
+		}
+		requireEqual(t, len(resp), int(tc.wLength), tc.name+" length")
+		requireEqual(t, resp[0], tc.wantID, tc.name+" report id")
+		if tc.name == "serial" {
+			requireEqual(t, resp[7], byte(0x08), "serial pairing constant 0")
+			requireEqual(t, resp[8], byte(0x25), "serial pairing constant 1")
+			requireEqual(t, resp[9], byte(0x00), "serial pairing constant 2")
+		}
+		if tc.name == "firmware" {
+			requireEqual(t, string(resp[1:12]), "Jul 04 2025", "firmware build date")
+			requireEqual(t, string(resp[12:20]), "10:10:32", "firmware build time")
+			requireEqual(t, binary.LittleEndian.Uint16(resp[20:22]), uint16(0x0103), "firmware type")
+			requireEqual(t, binary.LittleEndian.Uint32(resp[24:28]), uint32(0x01000208), "hardware info")
+			requireEqual(t, binary.LittleEndian.Uint32(resp[28:32]), uint32(0x01000036), "firmware version")
+			requireEqual(t, binary.LittleEndian.Uint16(resp[44:46]), uint16(0x0630), "firmware update version")
+		}
+	}
+}
