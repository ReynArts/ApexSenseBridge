+func TestASBShortUSBOutputReportKeepsFieldAlignment(t *testing.T) {
+	// The HID descriptor declares 47 output bytes after report ID 0x02. COD
+	// uses this exact 48-byte transfer instead of padding it to 64 bytes.
+	report := make([]byte, 48)
+	report[0] = ReportIDOutput
+	report[1] = 0x0F
+	report[2] = 0xD7
+	report[3] = 68
+	report[4] = 215
+	report[11] = 0x21
+	report[21] = 0xAA
+	report[22] = 0x05
+	report[32] = 0xBB
+	report[39] = 0x04
+	report[45], report[46], report[47] = 21, 43, 65
+
+	feedback, ok := parseASBOutputReport(report)
+	if !ok {
+		t.Fatal("48-byte USB output report was not parsed")
+	}
+	if feedback.EnableBits1 != 0x0F || feedback.EnableBits2 != 0xD7 ||
+		feedback.RumbleRight != 68 || feedback.RumbleLeft != 215 ||
+		feedback.RightTriggerEffect[0] != 0x21 || feedback.RightTriggerEffect[10] != 0xAA ||
+		feedback.LeftTriggerEffect[0] != 0x05 || feedback.LeftTriggerEffect[10] != 0xBB ||
+		feedback.EnableBits3 != 0x04 || feedback.LightbarRed != 21 ||
+		feedback.LightbarGreen != 43 || feedback.LightbarBlue != 65 {
+		t.Fatalf("48-byte USB output fields were shifted: %+v", feedback)
+	}
+}
