+package usbip
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestDetachLocalAttachmentRetriesFailures(t *testing.T) {
+	meta := ExportMeta{BusID: 999, DevID: 999}
+	calls := 0
+	RegisterLocalAttachment(&meta, func() error {
+		calls++
+		if calls == 1 {
+			return errors.New("busy")
+		}
+		return nil
+	})
+	if DetachLocalAttachment(&meta) == nil {
+		t.Fatal("lost detach failure")
+	}
+	if err := DetachLocalAttachment(&meta); err != nil {
+		t.Fatal(err)
+	}
+	if err := DetachLocalAttachment(&meta); err != nil || calls != 2 {
+		t.Fatal("detach was not idempotent")
+	}
+}
