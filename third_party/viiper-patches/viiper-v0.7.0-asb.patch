+func TestASBWeaponTriggerStateReachesUSBInputReport(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	neutral := ds.HandleTransfer(4, usbip.DirIn, nil)
+	if neutral[42] != triggerStatusNeutral || neutral[43] != triggerStatusNeutral ||
+		neutral[48] != 0 || neutral[54] != 0x08 ||
+		binary.LittleEndian.Uint32(neutral[49:53]) != binary.LittleEndian.Uint32(neutral[28:32]) {
+		t.Fatalf("neutral DualSense metadata is invalid: % x", neutral[42:55])
+	}
+
+	output := make([]byte, OutputReportSize)
+	output[0] = ReportIDOutput
+	output[1] = 0x04
+	output[11] = triggerEffectWeapon
+	output[12] = 1 << 2
+	output[13] = 1 << (8 - 8)
+	binary.LittleEndian.PutUint32(output[33:37], 0x78563412)
+	ds.HandleTransfer(3, usbip.DirOut, output)
+
+	state := *ds.inputState
+	state.R2 = 100
+	state.Buttons |= ButtonR2
+	ds.UpdateInputState(&state)
+	firing := ds.HandleTransfer(4, usbip.DirIn, nil)
+	if firing[6] != 100 || firing[9]&0x08 == 0 || firing[42] != 0x13 ||
+		firing[48]&0x0F != 2 || binary.LittleEndian.Uint32(firing[44:48]) != 0x78563412 {
+		t.Fatalf("weapon firing state was not synthesized: % x", firing[:55])
+	}
+
+	state.R2 = 255
+	ds.UpdateInputState(&state)
+	fired := ds.HandleTransfer(4, usbip.DirIn, nil)
+	if fired[6] != 255 || fired[42] != 0x29 || fired[48]&0x0F != 2 {
+		t.Fatalf("weapon fired state was not synthesized: % x", fired[:55])
+	}
