+func TestASBOutputKeepsOfficialAndExtendedCallbacks(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var official OutputState
+	var extended FeedbackFrame
+	ds.SetOutputCallback(func(state OutputState) { official = state })
+	ds.SetRawOutputCallback(func(frame FeedbackFrame) { extended = frame })
+
+	report := make([]byte, OutputReportSize)
+	report[0] = ReportIDOutput
+	report[1], report[2], report[3], report[4] = 0x0F, 0x04, 77, 155
+	report[11], report[22], report[39] = 0x21, 0x22, 0x08
+	ds.HandleTransfer(3, usbip.DirOut, report)
+
+	if official.RumbleSmall != 77 || official.RumbleLarge != 155 {
+		t.Fatalf("official callback regressed: %+v", official)
+	}
+	if extended.Type != FeedbackFrameHIDOutput || extended.HID.EnableBits1 != 0x0F ||
+		extended.HID.EnableBits2 != 0x04 || extended.HID.EnableBits3 != 0x08 ||
+		extended.HID.RightTriggerEffect[0] != 0x21 || extended.HID.LeftTriggerEffect[0] != 0x22 {
+		t.Fatalf("extended callback lost output fields: %+v", extended)
+	}
+	encoded, err := extended.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(encoded) != 30 || encoded[0] != FeedbackFrameHIDOutput || binary.LittleEndian.Uint16(encoded[1:3]) != 27 {
+		t.Fatalf("unexpected framed output: %x", encoded)
+	}
+}
+
+func TestASBShortUSBOutputReportKeepsFieldAlignment(t *testing.T) {
+	// The HID descriptor declares 47 output bytes after report ID 0x02. COD
+	// uses this exact 48-byte transfer instead of padding it to 64 bytes.
+	report := make([]byte, 48)
+	report[0] = ReportIDOutput
+	report[1] = 0x0F
+	report[2] = 0xD7
+	report[3] = 68
+	report[4] = 215
+	report[11] = 0x21
+	report[21] = 0xAA
+	report[22] = 0x05
+	report[32] = 0xBB
+	report[39] = 0x04
+
+	feedback, ok := parseASBOutputReport(report)
+	if !ok {
+		t.Fatal("48-byte USB output report was not parsed")
+	}
+	if feedback.EnableBits1 != 0x0F || feedback.EnableBits2 != 0xD7 ||
+		feedback.RumbleRight != 68 || feedback.RumbleLeft != 215 ||
+		feedback.RightTriggerEffect[0] != 0x21 || feedback.RightTriggerEffect[10] != 0xAA ||
+		feedback.LeftTriggerEffect[0] != 0x05 || feedback.LeftTriggerEffect[10] != 0xBB ||
+		feedback.EnableBits3 != 0x04 {
+		t.Fatalf("48-byte USB output fields were shifted: %+v", feedback)
+	}
+}
+
+func TestASBCompositeDescriptorAndFirmware(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	desc := ds.GetDescriptor()
+	if desc.NumInterfaces() != 4 || len(desc.Interfaces) != 6 {
+		t.Fatalf("composite interfaces = %d distinct/%d descriptors, want 4/6", desc.NumInterfaces(), len(desc.Interfaces))
+	}
+	if desc.Interfaces[0].Descriptor.BInterfaceClass != 1 || desc.Interfaces[5].Descriptor.BInterfaceNumber != 3 ||
+		desc.Interfaces[5].Descriptor.BInterfaceClass != 3 {
+		t.Fatal("audio/HID interface layout is invalid")
+	}
+	audioOut := desc.Interfaces[2].Endpoints[0]
+	if audioOut.BEndpointAddress != EndpointAudioOut || audioOut.WMaxPacketSize != 392 || len(audioOut.Extra) != 2 {
+		t.Fatalf("audio output endpoint is invalid: %+v", audioOut)
+	}
+	report, err := desc.Interfaces[5].HID.ReportBytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := fmt.Sprintf("%x", sha256.Sum256(report)); len(report) != 273 ||
+		got != "7587a72ee49550f24da50cbbad203742a0eb9aefbb753c2aaa5bedf8466c0d33" {
+		t.Fatalf("standard DualSense HID descriptor is not exact: len=%d sha256=%s", len(report), got)
+	}
+	firmware := ds.featureReportFirmware()
+	if got := binary.LittleEndian.Uint16(firmware[44:46]); got != 0x0630 {
+		t.Fatalf("firmware = %#x, want 0x0630", got)
+	}
+
+	edge, err := NewEdge(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if edge.GetDescriptor().NumInterfaces() != 1 {
+		t.Fatal("DualSense Edge should retain upstream v0.7's HID-only descriptor")
+	}
+}
+
+func TestASBAudioIsoFeedback(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got FeedbackFrame
+	ds.SetRawOutputCallback(func(frame FeedbackFrame) { got = frame })
+	pcm := make([]byte, 240*8)
+	for i := 0; i < len(pcm); i += 8 {
+		binary.LittleEndian.PutUint16(pcm[i+4:i+6], 1000)
+		binary.LittleEndian.PutUint16(pcm[i+6:i+8], 2000)
+	}
+	packets := []usb.IsoPacket{{Offset: 0, Length: uint32(len(pcm))}}
+	data, completed := ds.HandleIsoTransfer(1, usbip.DirOut, pcm, packets)
+	if data != nil || len(completed) != 1 || completed[0].ActualLength != uint32(len(pcm)) || completed[0].Status != 0 {
+		t.Fatalf("ISO completion is invalid: data=%v packets=%+v", data, completed)
+	}
+	if got.Type != FeedbackFrameAudioHaptics || got.Audio.Sequence != 1 ||
+		got.Audio.LeftEnergy == 0 || got.Audio.RightEnergy <= got.Audio.LeftEnergy {
+		t.Fatalf("audio haptics were not extracted: %+v", got)
+	}
+}
