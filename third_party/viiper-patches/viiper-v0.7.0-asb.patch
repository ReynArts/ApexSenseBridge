+				{DescriptorType: 0x24, Payload: usb.Data{0x01, 0x01, 0x01, 0x01, 0x00}},
+				{DescriptorType: 0x24, Payload: usb.Data{0x02, 0x01, 0x04, 0x02, 0x10, 0x01, 0x80, 0xBB, 0x00}},
+			},
