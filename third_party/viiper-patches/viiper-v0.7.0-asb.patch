+func TestASBRawAudioDiagnosticsSurviveDecimationAndReset(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var waveform AudioWaveformState
+	ds.SetRawOutputCallback(func(frame FeedbackFrame) {
+		if frame.Type == FeedbackFrameAudioWaveform {
+			waveform = frame.Waveform
+		}
+	})
+	input := make([]byte, asbInputStateSize)
+	input[32] = 0x80
+	if err := ds.UpdateASBInputState(input); err != nil {
+		t.Fatal(err)
+	}
+	pcm := make([]byte, 384*8)
+	for i := 0; i < 384; i++ {
+		binary.LittleEndian.PutUint16(pcm[i*8:i*8+2], 1234)
+		binary.LittleEndian.PutUint16(pcm[i*8+2:i*8+4], 5678)
+		value := int16(10000)
+		if i%2 == 1 {
+			value = -value
+		}
+		binary.LittleEndian.PutUint16(pcm[i*8+4:i*8+6], uint16(value))
+		binary.LittleEndian.PutUint16(pcm[i*8+6:i*8+8], 0x8000)
+	}
+	ds.consumeAudioHaptics(pcm)
+	if waveform.Left != [8]int16{} || waveform.RawPeaks != [4]uint16{1234, 5678, 10000, 32768} ||
+		waveform.RawLeftSumSquares != 384*10000*10000 || waveform.RawRightSumSquares != 384*32768*32768 {
+		t.Fatalf("pre-filter signal is not distinguishable from silence: %+v", waveform)
+	}
+	ds.consumeAudioHaptics(make([]byte, len(pcm)))
+	if waveform.Sequence != 2 || waveform.RawFrames != 384 || waveform.RawPeaks != [4]uint16{} ||
+		waveform.RawLeftSumSquares != 0 || waveform.RawRightSumSquares != 0 || waveform.Right != [8]int16{} {
+		t.Fatalf("raw measurements leaked between blocks: %+v", waveform)
+	}
+}
