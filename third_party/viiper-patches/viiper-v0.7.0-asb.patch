+func TestASBCompositeDescriptorAndFirmware(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	desc := ds.GetDescriptor()
+	if desc.NumInterfaces() != 4 || len(desc.Interfaces) != 6 {
+		t.Fatalf("composite interfaces = %d distinct/%d descriptors, want 4/6", desc.NumInterfaces(), len(desc.Interfaces))
+	}
+	if desc.Interfaces[0].Descriptor.BInterfaceClass != 1 || desc.Interfaces[5].Descriptor.BInterfaceNumber != 3 ||
+		desc.Interfaces[5].Descriptor.BInterfaceClass != 3 {
+		t.Fatal("audio/HID interface layout is invalid")
+	}
+	audioOut := desc.Interfaces[2].Endpoints[0]
+	if audioOut.BEndpointAddress != EndpointAudioOut || audioOut.WMaxPacketSize != 392 || len(audioOut.Extra) != 2 {
+		t.Fatalf("audio output endpoint is invalid: %+v", audioOut)
+	}
+	report, err := desc.Interfaces[5].HID.ReportBytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := fmt.Sprintf("%x", sha256.Sum256(report)); len(report) != 273 ||
+		got != "7587a72ee49550f24da50cbbad203742a0eb9aefbb753c2aaa5bedf8466c0d33" {
+		t.Fatalf("standard DualSense HID descriptor is not exact: len=%d sha256=%s", len(report), got)
+	}
+	firmware := ds.featureReportFirmware()
+	wantFirmware := []byte{
+		0x20, 0x4A, 0x75, 0x6C, 0x20, 0x20, 0x34, 0x20,
+		0x32, 0x30, 0x32, 0x35, 0x31, 0x30, 0x3A, 0x31,
+		0x30, 0x3A, 0x33, 0x32, 0x03, 0x00, 0x04, 0x00,
+		0x10, 0x13, 0x00, 0x00, 0x2A, 0x00, 0x10, 0x01,
+		0x01, 0xC8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x00, 0x00, 0x00, 0x30, 0x06, 0x00, 0x00,
+		0x3C, 0x00, 0x01, 0x00, 0x0A, 0x00, 0x02, 0x00,
+		0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	}
+	if !bytes.Equal(firmware, wantFirmware) {
+		t.Fatalf("firmware report does not match current physical DualSense capture:\n got %x\nwant %x", firmware, wantFirmware)
+	}
+
+	edge, err := NewEdge(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if edge.GetDescriptor().NumInterfaces() != 1 {
+		t.Fatal("DualSense Edge should retain upstream v0.7's HID-only descriptor")
+	}
+}
