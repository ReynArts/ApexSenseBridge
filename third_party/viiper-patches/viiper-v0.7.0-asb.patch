--- /dev/null
+++ b/device/dualsense/asb_extensions.go
@@ -0,0 +1,539 @@
+package dualsense
+
+import (
+	"encoding/binary"
+	"io"
+
+	"github.com/Alia5/VIIPER/usb"
+	"github.com/Alia5/VIIPER/usbip"
+)
+
+const asbInputStateSize = 33
+
+// ASBOutputState preserves the complete DualSense output report fields needed
+// by ApexSenseBridge. Upstream OutputState intentionally exposes only rumble
+// and LEDs, so this extension is kept separate from libVIIPER's public API.
+type ASBOutputState struct {
+	EnableBits1        uint8
+	EnableBits2        uint8
+	RumbleRight        uint8
+	RumbleLeft         uint8
+	EnableBits3        uint8
+	RightTriggerEffect [11]uint8
+	LeftTriggerEffect  [11]uint8
+	LightbarRed        uint8
+	LightbarGreen      uint8
+	LightbarBlue       uint8
+	hostTimestamp      uint32
+}
+
+func (f *ASBOutputState) MarshalBinary() ([]byte, error) {
+	b := make([]byte, 30)
+	b[0] = f.EnableBits1
+	b[1] = f.EnableBits2
+	b[2] = f.RumbleRight
+	b[3] = f.RumbleLeft
+	b[4] = f.EnableBits3
+	copy(b[5:16], f.RightTriggerEffect[:])
+	copy(b[16:27], f.LeftTriggerEffect[:])
+	b[27] = f.LightbarRed
+	b[28] = f.LightbarGreen
+	b[29] = f.LightbarBlue
+	return b, nil
+}
+
+type AudioHapticsState struct {
+	Sequence       uint32
+	LeftEnergy     uint16
+	RightEnergy    uint16
+	LeftPeak       uint16
+	RightPeak      uint16
+	LeftTransient  uint16
+	RightTransient uint16
+}
+
+func (s *AudioHapticsState) MarshalBinary() ([]byte, error) {
+	b := make([]byte, 16)
+	binary.LittleEndian.PutUint32(b[0:4], s.Sequence)
+	binary.LittleEndian.PutUint16(b[4:6], s.LeftEnergy)
+	binary.LittleEndian.PutUint16(b[6:8], s.RightEnergy)
+	binary.LittleEndian.PutUint16(b[8:10], s.LeftPeak)
+	binary.LittleEndian.PutUint16(b[10:12], s.RightPeak)
+	binary.LittleEndian.PutUint16(b[12:14], s.LeftTransient)
+	binary.LittleEndian.PutUint16(b[14:16], s.RightTransient)
+	return b, nil
+}
+
+type AudioWaveformState struct {
+	Sequence uint32
+	Left     [8]int16
+	Right    [8]int16
+	// Measurements precede decimation and do not change the haptic samples.
+	RawPeaks           [4]uint16 // speaker L/R, haptic L/R
+	RawLeftSumSquares  uint64
+	RawRightSumSquares uint64
+	RawFrames          uint32
+}
+
+func (s *AudioWaveformState) MarshalBinary() ([]byte, error) {
+	// The original 36-byte prefix stays compatible with older ASB clients.
+	b := make([]byte, 64)
+	binary.LittleEndian.PutUint32(b[0:4], s.Sequence)
+	for i := 0; i < 8; i++ {
+		binary.LittleEndian.PutUint16(b[4+i*4:6+i*4], uint16(s.Left[i]))
+		binary.LittleEndian.PutUint16(b[6+i*4:8+i*4], uint16(s.Right[i]))
+	}
+	for i, peak := range s.RawPeaks {
+		binary.LittleEndian.PutUint16(b[36+i*2:38+i*2], peak)
+	}
+	binary.LittleEndian.PutUint64(b[44:52], s.RawLeftSumSquares)
+	binary.LittleEndian.PutUint64(b[52:60], s.RawRightSumSquares)
+	binary.LittleEndian.PutUint32(b[60:64], s.RawFrames)
+	return b, nil
+}
+
+type FeedbackFrame struct {
+	Type       uint8
+	HID        ASBOutputState
+	Audio      AudioHapticsState
+	Waveform   AudioWaveformState
+	Waveform2k AudioWaveform2kState
+}
+
+func (f *FeedbackFrame) MarshalBinary() ([]byte, error) {
+	var payload []byte
+	var err error
+	switch f.Type {
+	case FeedbackFrameHIDOutput:
+		payload, err = f.HID.MarshalBinary()
+	case FeedbackFrameAudioHaptics:
+		payload, err = f.Audio.MarshalBinary()
+	case FeedbackFrameAudioWaveform:
+		payload, err = f.Waveform.MarshalBinary()
+	case FeedbackFrameAudioWaveform2k:
+		payload, err = f.Waveform2k.MarshalBinary()
+	}
+	if err != nil {
+		return nil, err
+	}
+	b := make([]byte, 3+len(payload))
+	b[0] = f.Type
+	binary.LittleEndian.PutUint16(b[1:3], uint16(len(payload)))
+	copy(b[3:], payload)
+	return b, nil
+}
+
+func parseASBOutputReport(data []byte) (ASBOutputState, bool) {
+	// A USB DualSense output report contains one report-ID byte followed by
+	// 47 bytes of common output data. Windows normally writes all 64 bytes to
+	// the interrupt endpoint, but some games (notably Call of Duty) submit only
+	// the descriptor-declared 48 bytes through HID SET_REPORT. In both cases the
+	// report ID is present and must be removed before reading the common fields.
+	if len(data) >= 48 && data[0] == ReportIDOutput {
+		data = data[1:]
+	} else if len(data) >= 78 && data[0] == 0x31 {
+		data = data[3:]
+	}
+	if len(data) < 47 {
+		return ASBOutputState{}, false
+	}
+	var feedback ASBOutputState
+	feedback.EnableBits1 = data[0]
+	feedback.EnableBits2 = data[1]
+	feedback.RumbleRight = data[2]
+	feedback.RumbleLeft = data[3]
+	copy(feedback.RightTriggerEffect[:], data[10:21])
+	copy(feedback.LeftTriggerEffect[:], data[21:32])
+	feedback.EnableBits3 = data[38]
+	feedback.LightbarRed = data[44]
+	feedback.LightbarGreen = data[45]
+	feedback.LightbarBlue = data[46]
+	feedback.hostTimestamp = binary.LittleEndian.Uint32(data[32:36])
+	return feedback, true
+}
+
+const (
+	triggerEffectFeedback  = 0x21
+	triggerEffectWeapon    = 0x25
+	triggerEffectVibration = 0x26
+	triggerEffectOff       = 0x05
+	triggerStatusNeutral   = 0x09
+)
+
+func (d *DualSense) updateASBTriggerState(feedback ASBOutputState) {
+	d.mtx.Lock()
+	defer d.mtx.Unlock()
+	if feedback.EnableBits1&0x04 != 0 {
+		d.rightTriggerEffect = feedback.RightTriggerEffect
+	}
+	if feedback.EnableBits1&0x08 != 0 {
+		d.leftTriggerEffect = feedback.LeftTriggerEffect
+	}
+	d.hostTimestamp = feedback.hostTimestamp
+}
+
+func synthesizeTriggerFeedback(effect [11]uint8, position uint8) (uint8, uint8) {
+	// DualSense firmware reports the adaptive-trigger mechanism separately
+	// from the analog axis. Native Sony input consumers (including Stellar
+	// Blade) use this state to observe a weapon crossing its break point.
+	zone := uint8(uint16(position) * 10 / 256)
+	switch effect[0] {
+	case triggerEffectFeedback:
+		start, _, ok := triggerEffectZones(effect)
+		if !ok {
+			return triggerStatusNeutral, 0
+		}
+		status := uint8(0)
+		if zone >= start {
+			status = 1
+		}
+		return status<<4 | start, 1
+	case triggerEffectWeapon:
+		start, end, ok := triggerEffectZones(effect)
+		if !ok {
+			return triggerStatusNeutral, 0
+		}
+		if zone < start {
+			return start, 2
+		}
+		if zone < end {
+			return 0x10 | zone, 2
+		}
+		return 0x29, 2
+	case triggerEffectVibration:
+		start, _, ok := triggerEffectZones(effect)
+		if !ok {
+			return triggerStatusNeutral, 0
+		}
+		status := uint8(0)
+		if zone >= start {
+			status = 1
+		}
+		return status<<4 | start, 3
+	case triggerEffectOff, 0:
+		return triggerStatusNeutral, 0
+	default:
+		return triggerStatusNeutral, 0
+	}
+}
+
+func triggerEffectZones(effect [11]uint8) (uint8, uint8, bool) {
+	switch effect[0] {
+	case triggerEffectFeedback, triggerEffectWeapon, triggerEffectVibration:
+		mask := uint16(effect[1]) | uint16(effect[2])<<8
+		first, second := uint8(0), uint8(0)
+		found := 0
+		for zone := uint8(0); zone < 10; zone++ {
+			if mask&(uint16(1)<<zone) == 0 {
+				continue
+			}
+			if found == 0 {
+				first = zone
+			}
+			second = zone
+			found++
+		}
+		if effect[0] == triggerEffectWeapon {
+			return first, second, found >= 2
+		}
+		return first, first, found >= 1
+	default:
+		return 0, 0, false
+	}
+}
+
+// unmarshalASBInputState decodes the wire format used by ApexSenseBridge
+// 0.3.x. Keeping this adapter in the sidecar avoids breaking libVIIPER's
+// official v0.7 InputState wire format and public API.
+func unmarshalASBInputState(data []byte) (InputState, error) {
+	if len(data) < asbInputStateSize {
+		return InputState{}, io.ErrUnexpectedEOF
+	}
+	legacyButtons := binary.LittleEndian.Uint16(data[7:9])
+	buttons := uint32(legacyButtons & 0xFFF0)
+	if legacyButtons&0x0001 != 0 {
+		buttons |= ButtonPS
+	}
+	if legacyButtons&0x0002 != 0 {
+		buttons |= ButtonTouchpad
+	}
+	if legacyButtons&0x0004 != 0 {
+		buttons |= ButtonMicMute
+	}
+	return InputState{
+		LX: int8(data[0] - 128), LY: int8(data[1] - 128),
+		RX: int8(data[2] - 128), RY: int8(data[3] - 128),
+		L2: data[4], R2: data[5], DPad: data[6], Buttons: buttons,
+		Touch1X: binary.LittleEndian.Uint16(data[9:11]),
+		Touch1Y: binary.LittleEndian.Uint16(data[11:13]), Touch1Active: data[13] != 0,
+		Touch2X: binary.LittleEndian.Uint16(data[14:16]),
+		Touch2Y: binary.LittleEndian.Uint16(data[16:18]), Touch2Active: data[18] != 0,
+		GyroX:  int16(binary.LittleEndian.Uint16(data[19:21])),
+		GyroY:  int16(binary.LittleEndian.Uint16(data[21:23])),
+		GyroZ:  int16(binary.LittleEndian.Uint16(data[23:25])),
+		AccelX: int16(binary.LittleEndian.Uint16(data[25:27])),
+		AccelY: int16(binary.LittleEndian.Uint16(data[27:29])),
+		AccelZ: int16(binary.LittleEndian.Uint16(data[29:31])),
+	}, nil
+}
+
+// UpdateASBInputState applies ApexSenseBridge's compact 33-byte input state.
+// It is exported for the optional in-process libVIIPER adapter while keeping
+// the stable upstream InputState wire format unchanged.
+func (d *DualSense) UpdateASBInputState(data []byte) error {
+	state, err := unmarshalASBInputState(data)
+	if err != nil {
+		return err
+	}
+	d.audioWaveMode.Store(asbWaveformMode(data[32]))
+	d.UpdateInputState(&state)
+	return nil
+}
+
+// PaceIsoOutTransfers is enabled only for ApexSenseBridge's raw-waveform
+// mode. Legacy ASB sessions retain VIIPER's existing ISO completion timing.
+func (d *DualSense) PaceIsoOutTransfers() bool {
+	return d.audioWaveMode.Load() != audioWaveOff
+}
+
+func (d *DualSense) HandleIsoTransfer(ep uint32, dir uint32, out []byte, packets []usb.IsoPacket) ([]byte, []usb.IsoPacket) {
+	if dir == usbip.DirOut && ep == 1 {
+		d.consumeAudioHaptics(out)
+		return nil, completeIsoPackets(packets, out)
+	}
+	if dir == usbip.DirIn && ep == 2 {
+		data := make([]byte, isoPayloadLength(packets, 196))
+		return data, completeIsoPackets(packets, data)
+	}
+	return nil, completeIsoPackets(packets, out)
+}
+
+func (d *DualSense) SetInterfaceAlt(interfaceNumber, alternateSetting uint8) {
+	if int(interfaceNumber) < len(d.interfaceAlt) {
+		if interfaceNumber == 1 && d.interfaceAlt[interfaceNumber] != alternateSetting {
+			d.resetAudioWaveform2kOnStreamChange()
+		}
+		d.interfaceAlt[interfaceNumber] = alternateSetting
+	}
+}
+
+func (d *DualSense) GetInterfaceAlt(interfaceNumber uint8) uint8 {
+	if int(interfaceNumber) < len(d.interfaceAlt) {
+		return d.interfaceAlt[interfaceNumber]
+	}
+	return 0
+}
+
+func isoPayloadLength(packets []usb.IsoPacket, fallback uint32) int {
+	var total uint32
+	for _, pkt := range packets {
+		total += pkt.Length
+	}
+	if total == 0 && len(packets) > 0 {
+		total = fallback * uint32(len(packets))
+	}
+	return int(total)
+}
+
+func completeIsoPackets(packets []usb.IsoPacket, data []byte) []usb.IsoPacket {
+	out := make([]usb.IsoPacket, len(packets))
+	for i, pkt := range packets {
+		out[i] = pkt
+		out[i].ActualLength = pkt.Length
+		if int(pkt.Offset+pkt.Length) > len(data) {
+			if pkt.Offset < uint32(len(data)) {
+				out[i].ActualLength = uint32(len(data)) - pkt.Offset
+			} else {
+				out[i].ActualLength = 0
+			}
+		}
+		out[i].Status = 0
+	}
+	return out
+}
+
+func (d *DualSense) consumeAudioHaptics(data []byte) {
+	if len(data) < 8 {
+		return
+	}
+	mode := d.audioWaveMode.Load()
+	waveformEnabled := mode != audioWaveOff
+	d.audioMu.Lock()
+	defer d.audioMu.Unlock()
+	d.applyAudioWaveModeLocked(mode)
+	for i := 0; i+7 < len(data); i += 8 {
+		frontLeft := absS16(int16(binary.LittleEndian.Uint16(data[i : i+2])))
+		frontRight := absS16(int16(binary.LittleEndian.Uint16(data[i+2 : i+4])))
+		leftSigned := int16(binary.LittleEndian.Uint16(data[i+4 : i+6]))
+		rightSigned := int16(binary.LittleEndian.Uint16(data[i+6 : i+8]))
+		left := absS16(leftSigned)
+		right := absS16(rightSigned)
+		d.audioFrontSum += uint64(frontLeft) + uint64(frontRight)
+		d.audioLeftSum += uint64(left)
+		d.audioRightSum += uint64(right)
+		if waveformEnabled {
+			peaks := [4]uint16{frontLeft, frontRight, left, right}
+			for channel, peak := range peaks {
+				if peak > d.audioRawPeaks[channel] {
+					d.audioRawPeaks[channel] = peak
+				}
+			}
+			d.audioRawLeftSquares += uint64(int64(leftSigned) * int64(leftSigned))
+			d.audioRawRightSquares += uint64(int64(rightSigned) * int64(rightSigned))
+			d.audioRawFrames++
+			if mode == audioWave1k {
+				d.audioDecimateLeft += int64(leftSigned)
+				d.audioDecimateRight += int64(rightSigned)
+				d.audioDecimateFrames++
+			}
+		}
+		if frontLeft > d.audioFrontPeak {
+			d.audioFrontPeak = frontLeft
+		}
+		if frontRight > d.audioFrontPeak {
+			d.audioFrontPeak = frontRight
+		}
+		if left > d.audioLeftPeak {
+			d.audioLeftPeak = left
+		}
+		if right > d.audioRightPeak {
+			d.audioRightPeak = right
+		}
+		if mode == audioWave2k {
+			d.pushAudioWave2kLocked(leftSigned, rightSigned)
+		}
+		if mode == audioWave1k && d.audioDecimateFrames == 48 {
+			index := d.audioWaveSamples
+			d.audioWaveLeft[index] = int16(d.audioDecimateLeft / 48)
+			d.audioWaveRight[index] = int16(d.audioDecimateRight / 48)
+			d.audioWaveSamples++
+			d.audioDecimateFrames = 0
+			d.audioDecimateLeft = 0
+			d.audioDecimateRight = 0
+			if d.audioWaveSamples == 8 {
+				d.flushAudioWaveformLocked()
+			}
+		}
+		d.audioFrames++
+		if d.audioFrames >= 240 {
+			d.flushAudioHapticsLocked()
+		}
+	}
+}
+
+func (d *DualSense) flushAudioWaveformLocked() {
+	d.audioWaveSeq++
+	frame := FeedbackFrame{Type: FeedbackFrameAudioWaveform, Waveform: AudioWaveformState{
+		Sequence: d.audioWaveSeq, Left: d.audioWaveLeft, Right: d.audioWaveRight,
+		RawPeaks: d.audioRawPeaks, RawLeftSumSquares: d.audioRawLeftSquares,
+		RawRightSumSquares: d.audioRawRightSquares, RawFrames: d.audioRawFrames,
+	}}
+	d.audioWaveSamples = 0
+	d.audioWaveLeft = [8]int16{}
+	d.audioWaveRight = [8]int16{}
+	d.audioRawPeaks = [4]uint16{}
+	d.audioRawLeftSquares, d.audioRawRightSquares, d.audioRawFrames = 0, 0, 0
+	d.emitRawOutput(frame)
+}
+
+func (d *DualSense) flushAudioHapticsLocked() {
+	if d.audioFrames == 0 {
+		d.resetAudioAccumulatorLocked()
+		return
+	}
+	frontAvg := d.audioFrontSum / uint64(d.audioFrames*2)
+	hapticAvg := (d.audioLeftSum + d.audioRightSum) / uint64(d.audioFrames*2)
+	if looksLikeSpeakerAudio(frontAvg, hapticAvg, d.audioFrontPeak, d.audioLeftPeak, d.audioRightPeak) {
+		d.resetAudioAccumulatorLocked()
+		return
+	}
+	left := scaleAudioEnergy(d.audioLeftSum / uint64(d.audioFrames))
+	right := scaleAudioEnergy(d.audioRightSum / uint64(d.audioFrames))
+	leftPeak := scaleAudioEnergy(uint64(d.audioLeftPeak))
+	rightPeak := scaleAudioEnergy(uint64(d.audioRightPeak))
+	var leftTransient, rightTransient uint16
+	if left > d.audioLastLeft {
+		leftTransient = left - d.audioLastLeft
+	}
+	if right > d.audioLastRight {
+		rightTransient = right - d.audioLastRight
+	}
+	d.audioSeq++
+	frame := FeedbackFrame{Type: FeedbackFrameAudioHaptics, Audio: AudioHapticsState{
+		Sequence: d.audioSeq, LeftEnergy: left, RightEnergy: right,
+		LeftPeak: leftPeak, RightPeak: rightPeak,
+		LeftTransient: leftTransient, RightTransient: rightTransient,
+	}}
+	d.audioLastLeft, d.audioLastRight = left, right
+	d.resetAudioAccumulatorLocked()
+	d.emitRawOutput(frame)
+}
+
+func (d *DualSense) resetAudioAccumulatorLocked() {
+	d.audioFrames, d.audioFrontSum, d.audioLeftSum, d.audioRightSum = 0, 0, 0, 0
+	d.audioFrontPeak, d.audioLeftPeak, d.audioRightPeak = 0, 0, 0
+}
+
+func absS16(v int16) uint16 {
+	if v == -32768 {
+		return 32768
+	}
+	if v < 0 {
+		return uint16(-v)
+	}
+	return uint16(v)
+}
+
+func scaleAudioEnergy(value uint64) uint16 {
+	const noiseFloor = 128
+	if value <= noiseFloor {
+		return 0
+	}
+	scaled := (value - noiseFloor) * 3
+	if scaled > 0xFFFF {
+		scaled = 0xFFFF
+	}
+	return uint16(scaled)
+}
+
+func looksLikeSpeakerAudio(frontAvg, hapticAvg uint64, frontPeak, leftPeak, rightPeak uint16) bool {
+	if frontAvg <= 256 || frontPeak <= 1000 {
+		return false
+	}
+	hapticPeak := leftPeak
+	if rightPeak > hapticPeak {
+		hapticPeak = rightPeak
+	}
+	if hapticAvg <= 48 && hapticPeak <= 256 {
+		return true
+	}
+	return hapticAvg*8 <= frontAvg && uint64(hapticPeak)*8 <= uint64(frontPeak) && hapticPeak < 1200
+}
+
+func (d *DualSense) handleAudioClassControl(bRequest uint8, wValue, wLength uint16, data []byte) []byte {
+	control := uint8(wValue >> 8)
+	switch bRequest {
+	case 0x01: // SET_CUR
+		return nil
+	case 0x81, 0x82, 0x83, 0x84: // GET_CUR/MIN/MAX/RES
+		resp := make([]byte, wLength)
+		if control == 0x01 && len(resp) >= 1 {
+			resp[0] = 0
+		}
+		if control == 0x02 && len(resp) >= 2 {
+			if bRequest == 0x82 {
+				binary.LittleEndian.PutUint16(resp[:2], 0xD000)
+			}
+			if bRequest == 0x84 {
+				binary.LittleEndian.PutUint16(resp[:2], 0x0100)
+			}
+		}
+		if control == 0x01 && len(resp) >= 3 {
+			copy(resp[:3], []byte{0x80, 0xBB, 0x00})
+		}
+		_ = data
+		return resp
+	default:
+		return make([]byte, wLength)
+	}
+}
