+	for i := 0; i < len(pcm); i += 8 {
+		binary.LittleEndian.PutUint16(pcm[i+4:i+6], 1000)
+		binary.LittleEndian.PutUint16(pcm[i+6:i+8], 2000)
+	}
+	packets := []usb.IsoPacket{{Offset: 0, Length: uint32(len(pcm))}}
+	data, completed := ds.HandleIsoTransfer(1, usbip.DirOut, pcm, packets)
+	if data != nil || len(completed) != 1 || completed[0].ActualLength != uint32(len(pcm)) || completed[0].Status != 0 {
+		t.Fatalf("ISO completion is invalid: data=%v packets=%+v", data, completed)
+	}
+	if got.Type != FeedbackFrameAudioHaptics || got.Audio.Sequence != 1 ||
+		got.Audio.LeftEnergy == 0 || got.Audio.RightEnergy <= got.Audio.LeftEnergy {
+		t.Fatalf("audio haptics were not extracted: %+v", got)
+	}
