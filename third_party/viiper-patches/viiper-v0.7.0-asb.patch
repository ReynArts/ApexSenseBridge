+package dualsense
+
+import "github.com/Alia5/VIIPER/usb"
+
+func cloneDescriptor(src usb.Descriptor) usb.Descriptor {
+	dst := src
+	dst.Interfaces = append([]usb.InterfaceConfig(nil), src.Interfaces...)
+	for i := range dst.Interfaces {
+		dst.Interfaces[i].Endpoints = append([]usb.EndpointDescriptor(nil), src.Interfaces[i].Endpoints...)
+		dst.Interfaces[i].ClassDescriptors = append([]usb.ClassSpecificDescriptor(nil), src.Interfaces[i].ClassDescriptors...)
+	}
+	dst.Associations = append([]usb.InterfaceAssociationDescriptor(nil), src.Associations...)
+	dst.Strings = make(map[uint8]string, len(src.Strings))
+	for key, value := range src.Strings {
+		dst.Strings[key] = value
+	}
+	return dst
+}
+
+func enableASBCompositeDescriptor(desc *usb.Descriptor) {
+	hidInterface := desc.Interfaces[0]
+	hidInterface.Descriptor.BInterfaceNumber = 3
+	hidInterface.Endpoints = append([]usb.EndpointDescriptor(nil), hidInterface.Endpoints...)
+	hidFunction := *hidInterface.HID
+	hidFunction.ReportDescriptorBytes = dualSenseUSBReportDescriptor()
+	hidInterface.HID = &hidFunction
+	for i := range hidInterface.Endpoints {
+		hidInterface.Endpoints[i].BInterval = 4
+	}
+
+	desc.Configuration = usb.ConfigurationDescriptor{
+		BConfigurationValue: 1,
+		BMAttributes:        0xC0,
+		BMaxPower:           0xFA,
+	}
+	desc.Interfaces = append(audioInterfaces(), hidInterface)
+}
+
+// dualSenseUSBReportDescriptor is the exact 273-byte descriptor exposed by a
+// standard USB DualSense (PID 0x0CE6). Upstream v0.7 appends Edge-only feature
+// reports to a shared 427-byte descriptor, which makes strict games reject the
+// otherwise correctly identified standard controller.
+func dualSenseUSBReportDescriptor() usb.Data {
+	return usb.Data{
+		0x05, 0x01, 0x09, 0x05, 0xa1, 0x01, 0x85, 0x01,
+		0x09, 0x30, 0x09, 0x31, 0x09, 0x32, 0x09, 0x35,
+		0x09, 0x33, 0x09, 0x34, 0x15, 0x00, 0x26, 0xff,
+		0x00, 0x75, 0x08, 0x95, 0x06, 0x81, 0x02, 0x06,
+		0x00, 0xff, 0x09, 0x20, 0x95, 0x01, 0x81, 0x02,
+		0x05, 0x01, 0x09, 0x39, 0x15, 0x00, 0x25, 0x07,
+		0x35, 0x00, 0x46, 0x3b, 0x01, 0x65, 0x14, 0x75,
+		0x04, 0x95, 0x01, 0x81, 0x42, 0x65, 0x00, 0x05,
+		0x09, 0x19, 0x01, 0x29, 0x0f, 0x15, 0x00, 0x25,
+		0x01, 0x75, 0x01, 0x95, 0x0f, 0x81, 0x02, 0x06,
+		0x00, 0xff, 0x09, 0x21, 0x95, 0x0d, 0x81, 0x02,
+		0x06, 0x00, 0xff, 0x09, 0x22, 0x15, 0x00, 0x26,
+		0xff, 0x00, 0x75, 0x08, 0x95, 0x34, 0x81, 0x02,
+		0x85, 0x02, 0x09, 0x23, 0x95, 0x2f, 0x91, 0x02,
+		0x85, 0x05, 0x09, 0x33, 0x95, 0x28, 0xb1, 0x02,
+		0x85, 0x08, 0x09, 0x34, 0x95, 0x2f, 0xb1, 0x02,
+		0x85, 0x09, 0x09, 0x24, 0x95, 0x13, 0xb1, 0x02,
+		0x85, 0x0a, 0x09, 0x25, 0x95, 0x1a, 0xb1, 0x02,
+		0x85, 0x20, 0x09, 0x26, 0x95, 0x3f, 0xb1, 0x02,
+		0x85, 0x21, 0x09, 0x27, 0x95, 0x04, 0xb1, 0x02,
