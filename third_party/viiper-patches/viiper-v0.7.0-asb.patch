diff --git a/internal/server/api/detach_windows.go b/internal/server/api/detach_windows.go
new file mode 100644
index 0000000..ffa1bfb
--- /dev/null
+++ b/internal/server/api/detach_windows.go
@@ -0,0 +1,94 @@
+//go:build windows
+
+package api
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"unsafe"
+
+	"github.com/Alia5/VIIPER/usbip"
+	"golang.org/x/sys/windows"
+)
+
+// usbip-win2 v0.9.8.0 vhci.h: imported_device is 1128 bytes,
+// GET_IMPORTED_DEVICES has a four-byte header followed by these entries.
+const importedDeviceSize = 1128
+
+func importedPorts(data []byte, bus, service string) ([]int32, error) {
+	if len(data) < 4 || (len(data)-4)%importedDeviceSize != 0 {
+		return nil, fmt.Errorf("invalid USBip imported-device response length %d", len(data))
+	}
+	cstr := func(b []byte) string {
+		if i := bytes.IndexByte(b, 0); i >= 0 {
+			return string(b[:i])
+		}
+		return ""
+	}
+	var ports []int32
+	for off := 4; off < len(data); off += importedDeviceSize {
+		d := data[off : off+importedDeviceSize]
+		host := cstr(d[68:1093])
+		if cstr(d[4:36]) == bus && cstr(d[36:68]) == service && (host == "127.0.0.1" || host == "localhost" || host == "::1") {
+			port := int32(binary.LittleEndian.Uint32(d))
+			if port <= 0 {
+				return nil, fmt.Errorf("invalid owned USBip port %d", port)
+			}
+			ports = append(ports, port)
+		}
+	}
+	return ports, nil
+}
+
+func detachLocalhostClientImpl(meta *usbip.ExportMeta, serverPort uint16) error {
+	if serverPort == 0 {
+		return fmt.Errorf("refusing USBip detach with no owned server port")
+	}
+	path, err := getDeviceInterfacePath(&deviceGUID)
+	if err != nil {
+		return err
+	}
+	p, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return err
+	}
+	h, err := windows.CreateFile(p, windows.GENERIC_READ|windows.GENERIC_WRITE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_ATTRIBUTE_NORMAL, 0)
+	if err != nil {
+		return err
+	}
+	defer windows.CloseHandle(h)
+	const getImported = ioctlPluginHardware + (2 << 2)
+	const plugout = ioctlPluginHardware + (1 << 2)
+	var data []byte
+	var n uint32
+	for count := 1; count <= 4096; count *= 2 {
+		data = make([]byte, 4+count*importedDeviceSize)
+		binary.LittleEndian.PutUint32(data, 4+importedDeviceSize)
+		err = windows.DeviceIoControl(h, getImported, &data[0], 4, &data[0], uint32(len(data)), &n, nil)
+		if err == windows.ERROR_INSUFFICIENT_BUFFER {
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("USBip enumeration before detach: %w", err)
+		}
+		break
+	}
+	if err != nil || n > uint32(len(data)) {
+		return fmt.Errorf("USBip enumeration exceeded bounded buffer")
+	}
+	ports, err := importedPorts(data[:n], fmt.Sprintf("%d-%d", meta.BusID, meta.DevID), fmt.Sprint(serverPort))
+	if err != nil {
+		return err
+	}
+	for _, port := range ports {
+		request := struct {
+			Size uint32
+			Port int32
+		}{8, port}
+		if err := windows.DeviceIoControl(h, plugout, (*byte)(unsafe.Pointer(&request)), 8, nil, 0, &n, nil); err != nil {
+			return fmt.Errorf("detach owned USBip port %d: %w", port, err)
+		}
+	}
+	return nil
+}
