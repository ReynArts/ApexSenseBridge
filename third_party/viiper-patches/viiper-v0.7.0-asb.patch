+func TestASBAudioWaveformIsFilteredToOneKilohertz(t *testing.T) {
+	ds, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var waveform FeedbackFrame
+	ds.SetRawOutputCallback(func(frame FeedbackFrame) {
+		if frame.Type == FeedbackFrameAudioWaveform {
+			waveform = frame
+		}
+	})
+	input := make([]byte, asbInputStateSize)
+	input[32] = 0x80
+	if err := ds.UpdateASBInputState(input); err != nil {
+		t.Fatal(err)
+	}
+	if !ds.PaceIsoOutTransfers() {
+		t.Fatal("ISO OUT pacing was not enabled with the waveform opt-in")
+	}
+	pcm := make([]byte, 8*48*8)
+	for i := 0; i < len(pcm); i += 8 {
+		binary.LittleEndian.PutUint16(pcm[i+4:i+6], 4800)
+		binary.LittleEndian.PutUint16(pcm[i+6:i+8], 0xDA80)
+	}
+	packets := []usb.IsoPacket{{Offset: 0, Length: uint32(len(pcm))}}
+	ds.HandleIsoTransfer(1, usbip.DirOut, pcm, packets)
+	if waveform.Type != FeedbackFrameAudioWaveform || waveform.Waveform.Sequence != 1 {
+		t.Fatalf("audio waveform was not emitted: %+v", waveform)
+	}
+	for i := 0; i < 8; i++ {
+		if waveform.Waveform.Left[i] != 4800 || waveform.Waveform.Right[i] != -9600 {
+			t.Fatalf("sample %d = (%d,%d), want (4800,-9600)", i,
+				waveform.Waveform.Left[i], waveform.Waveform.Right[i])
+		}
+	}
+	encoded, err := waveform.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(encoded) != 67 || encoded[0] != FeedbackFrameAudioWaveform ||
+		binary.LittleEndian.Uint16(encoded[1:3]) != 64 {
+		t.Fatalf("unexpected waveform framing: %x", encoded)
+	}
+	if waveform.Waveform.RawFrames != 384 ||
+		waveform.Waveform.RawPeaks != [4]uint16{0, 0, 4800, 9600} ||
+		binary.LittleEndian.Uint64(encoded[47:55]) != 384*4800*4800 ||
+		binary.LittleEndian.Uint64(encoded[55:63]) != 384*9600*9600 ||
+		binary.LittleEndian.Uint32(encoded[63:67]) != 384 {
+		t.Fatalf("raw audio measurements lost or misaligned: %+v", waveform.Waveform)
+	}
+}
