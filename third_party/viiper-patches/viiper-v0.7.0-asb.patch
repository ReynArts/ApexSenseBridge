+++ b/usbip/local_attachment.go
@@ -0,0 +1,24 @@
+package usbip
+
+import "sync"
+
+// Local attachment cleanup runs before the export connection is closed: closing
+// TCP alone lets usbip-win2 schedule an automatic reattach to a dead server.
+var localAttachments sync.Map
+
+type attachmentKey struct{ bus, device uint32 }
+
+func RegisterLocalAttachment(meta *ExportMeta, detach func() error) {
+	localAttachments.Store(attachmentKey{meta.BusID, meta.DevID}, detach)
+}
+
+func DetachLocalAttachment(meta *ExportMeta) error {
+	key := attachmentKey{meta.BusID, meta.DevID}
+	if value, ok := localAttachments.Load(key); ok {
+		if err := value.(func() error)(); err != nil {
+			return err
+		}
+		localAttachments.Delete(key)
+	}
+	return nil
+}
