@@ -0,0 +1,35 @@
+//go:build windows
+
+package api
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestImportedPortsOwnership(t *testing.T) {
+	makeEntry := func(host, service, bus string, port uint32) []byte {
+		d := make([]byte, importedDeviceSize)
+		binary.LittleEndian.PutUint32(d, port)
+		copy(d[4:36], bus)
+		copy(d[36:68], service)
+		copy(d[68:1093], host)
+		return d
+	}
+	data := make([]byte, 4)
+	data = append(data, makeEntry("127.0.0.1", "4567", "1-1", 2)...)
+	data = append(data, makeEntry("127.0.0.1", "9999", "1-1", 3)...)
+	data = append(data, makeEntry("192.168.1.4", "4567", "1-1", 4)...)
+	data = append(data, makeEntry("localhost", "4567", "2-1", 5)...)
+	ports, err := importedPorts(data, "1-1", "4567")
+	if err != nil || len(ports) != 1 || ports[0] != 2 {
+		t.Fatalf("unsafe port selection: %v %v", ports, err)
+	}
+	if _, err := importedPorts(data[:len(data)-1], "1-1", "4567"); err == nil {
+		t.Fatal("accepted truncated response")
+	}
+	invalid := append(make([]byte, 4), makeEntry("127.0.0.1", "4567", "1-1", 0xffffffff)...)
+	if _, err := importedPorts(invalid, "1-1", "4567"); err == nil {
+		t.Fatal("accepted wildcard port")
+	}
+}
