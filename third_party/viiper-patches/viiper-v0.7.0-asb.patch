+package virtualbus_test
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/Alia5/VIIPER/device"
+	"github.com/Alia5/VIIPER/device/dualsense"
+	"github.com/Alia5/VIIPER/usbip"
+	"github.com/Alia5/VIIPER/virtualbus"
+)
+
+func TestDetachBeforeCancellingExport(t *testing.T) {
+	for _, operation := range []string{"device", "bus"} {
+		t.Run(operation, func(t *testing.T) {
+			bus := virtualbus.New(991)
+			dev, err := dualsense.New(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, err := bus.Add(dev)
+			if err != nil {
+				t.Fatal(err)
+			}
+			meta := device.GetDeviceMeta(ctx)
+			fail := true
+			usbip.RegisterLocalAttachment(meta, func() error {
+				if ctx.Err() != nil {
+					t.Fatal("export closed before Windows port was detached")
+				}
+				if fail {
+					return errors.New("driver refused detach")
+				}
+				return nil
+			})
+			remove := func() error {
+				if operation == "bus" {
+					return bus.Close()
+				}
+				return bus.Remove(dev)
+			}
+			if remove() == nil || ctx.Err() != nil || len(bus.Devices()) != 1 {
+				t.Fatal("detach failure discarded the live export")
+			}
+			fail = false
+			if err := remove(); err != nil {
+				t.Fatal(err)
+			}
+			if ctx.Err() == nil {
+				t.Fatal("successful detach did not cancel export")
+			}
+			if operation == "device" {
+				if err := bus.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
