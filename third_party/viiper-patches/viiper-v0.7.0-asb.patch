+func prepareAttachIOCTL(ioctlData *attachIOCTLLegacy, structSize uint32, busID string, service string) error {
+	ioctlData.Size = structSize
+	if len(busID) >= len(ioctlData.BusID) {
+		return fmt.Errorf("argumentValidation: bus ID too long: %s", busID)
+	}
+	copy(ioctlData.BusID[:], busID)
+	if len(service) >= len(ioctlData.Service) {
+		return fmt.Errorf("argumentValidation: service string too long: %s", service)
+	}
+	copy(ioctlData.Service[:], service)
+	// The ASB listener rejects non-loopback peers. Passing a numeric loopback
+	// address also prevents usbip-win2 from trying IPv6 localhost before IPv4.
+	copy(ioctlData.Host[:], "127.0.0.1")
 	return nil
 }
 
+func callAttachIOCTL(handle windows.Handle, ioctlData unsafe.Pointer, ioctlSize uint32) (uint32, error) {
+	var bytesReturned uint32
+	err := windows.DeviceIoControl(
+		handle,
+		ioctlPluginHardware,
+		(*byte)(ioctlData),
+		ioctlSize,
+		(*byte)(ioctlData),
+		ioctlSize,
+		&bytesReturned,
+		nil,
+	)
+	return bytesReturned, err
+}
