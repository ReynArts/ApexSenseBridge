+func TestASBInputWireAdapter(t *testing.T) {
+	wire := make([]byte, asbInputStateSize)
+	copy(wire[:7], []byte{0, 127, 128, 255, 23, 231, DPadUp | DPadLeft})
+	binary.LittleEndian.PutUint16(wire[7:9], 0xFFF7)
+	binary.LittleEndian.PutUint16(wire[9:11], 1234)
+	binary.LittleEndian.PutUint16(wire[11:13], 567)
+	wire[13] = 1
+	binary.LittleEndian.PutUint16(wire[14:16], 1876)
+	binary.LittleEndian.PutUint16(wire[16:18], 999)
+	wire[18] = 1
+	binary.LittleEndian.PutUint16(wire[19:21], 0xFF85)
+	binary.LittleEndian.PutUint16(wire[29:31], 0xE000)
+
+	state, err := unmarshalASBInputState(wire)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if state.LX != -128 || state.LY != -1 || state.RX != 0 || state.RY != 127 {
+		t.Fatalf("unexpected axes: %d %d %d %d", state.LX, state.LY, state.RX, state.RY)
+	}
+	wantButtons := uint32(0xFFF0) | ButtonPS | ButtonTouchpad | ButtonMicMute
+	if state.Buttons != wantButtons {
+		t.Fatalf("buttons = %#x, want %#x", state.Buttons, wantButtons)
+	}
+	if state.DPad != DPadUp|DPadLeft || state.L2 != 23 || state.R2 != 231 {
+		t.Fatalf("unexpected digital/trigger state: dpad=%#x l2=%d r2=%d", state.DPad, state.L2, state.R2)
+	}
+	if state.Touch1X != 1234 || state.Touch1Y != 567 || !state.Touch1Active ||
+		state.Touch2X != 1876 || state.Touch2Y != 999 || !state.Touch2Active {
+		t.Fatal("touch state was not decoded")
+	}
+	if state.GyroX != -123 || state.AccelZ != -8192 {
+		t.Fatalf("sensor state was not decoded: gyroX=%d accelZ=%d", state.GyroX, state.AccelZ)
+	}
+}
