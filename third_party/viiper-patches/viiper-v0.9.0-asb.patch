+func TestASBInterruptINPipesCompleteIndependentlyAndInOrder(t *testing.T) {
+	dev := &asbTwoPipeDevice{
+		pipes: map[uint32]chan []byte{1: make(chan []byte, 1), 2: make(chan []byte, 1)},
+		desc: usbdev.Descriptor{
+			Device: usbdev.DeviceDescriptor{BcdUSB: 0x0200, BMaxPacketSize0: 64, BNumConfigurations: 1, Speed: 2},
+			Interfaces: []usbdev.InterfaceConfig{{
+				Descriptor: usbdev.InterfaceDescriptor{BNumEndpoints: 2, BInterfaceClass: 0xFF},
+				Endpoints: []usbdev.EndpointDescriptor{
+					{BEndpointAddress: 0x81, BMAttributes: 0x03, WMaxPacketSize: 8},
+					{BEndpointAddress: 0x82, BMAttributes: 0x03, WMaxPacketSize: 8},
+				},
+			}},
+		},
+	}
+	s := newASBStreamFor(t, 0, nil, dev)
+	expect := func(t *testing.T, cmd, seq uint32, status int32, payload []byte) {
+		t.Helper()
+		if r := s.next(t, time.Second); r.cmd != cmd || r.seq != seq || r.status != status || !bytes.Equal(r.payload, payload) {
+			t.Fatalf("got %+v, want cmd %d seq %d status %d payload %v", r, cmd, seq, status, payload)
+		}
+	}
+
+	head, queued, other := s.submit(usbip.DirIn, 1, nil, nil, 8), s.submit(usbip.DirIn, 1, nil, nil, 8), s.submit(usbip.DirIn, 2, nil, nil, 8)
+	dev.pipes[2] <- []byte{2}
+	expect(t, usbip.RetSubmitCode, other, 0, []byte{2})
+	expect(t, usbip.RetUnlinkCode, s.unlink(head), -104, nil)
+	dev.pipes[1] <- []byte{1}
+	expect(t, usbip.RetSubmitCode, queued, 0, []byte{1})
+
+	first, second := s.submit(usbip.DirIn, 1, nil, nil, 8), s.submit(usbip.DirIn, 1, nil, nil, 8)
+	expect(t, usbip.RetUnlinkCode, s.unlink(second), -104, nil)
+	dev.pipes[1] <- []byte{3}
+	expect(t, usbip.RetSubmitCode, first, 0, []byte{3})
+	if extra := s.quiet(20 * time.Millisecond); len(extra) != 0 {
+		t.Fatalf("unexpected replies: %+v", extra)
+	}
+}
