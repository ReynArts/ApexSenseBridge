+package usb_test
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"log/slog"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Alia5/VIIPER/device/dualsense"
+	"github.com/Alia5/VIIPER/internal/server/usb"
+	"github.com/Alia5/VIIPER/usbip"
+	"github.com/Alia5/VIIPER/virtualbus"
+)
+
+type asbReply struct {
+	cmd        uint32
+	seq        uint32
+	status     int32
+	actual     uint32
+	startFrame uint32
+	packets    uint32
+	payload    []byte
+	iso        []usbip.IsoPacketDescriptor
+	at         time.Time
+}
+
+type asbURBClient struct {
+	t     *testing.T
+	conn  net.Conn
+	seq   uint32
+	dirIn map[uint32]bool
+}
+
+func (c *asbURBClient) submit(dir, ep, startFrame uint32, setup [8]byte, out []byte, iso []usbip.IsoPacketDescriptor, inLen uint32) uint32 {
+	c.t.Helper()
+	c.seq++
+	c.dirIn[c.seq] = dir == usbip.DirIn
+	numberOfPackets := uint32(0xFFFFFFFF)
+	if len(iso) > 0 {
+		numberOfPackets = uint32(len(iso))
+	}
+	bufLen := inLen
+	if dir == usbip.DirOut {
+		bufLen = uint32(len(out))
+	}
+	cmd := usbip.CmdSubmit{
+		Basic:             usbip.HeaderBasic{Command: usbip.CmdSubmitCode, Seqnum: c.seq, Dir: dir, Ep: ep},
+		TransferBufferLen: bufLen,
+		StartFrame:        startFrame,
+		NumberOfPackets:   numberOfPackets,
+		Setup:             setup,
+	}
+	var b bytes.Buffer
+	if err := cmd.Write(&b); err != nil {
+		c.t.Fatal(err)
+	}
+	b.Write(out)
+	for i := range iso {
+		if err := iso[i].Write(&b); err != nil {
+			c.t.Fatal(err)
+		}
+	}
+	if _, err := c.conn.Write(b.Bytes()); err != nil {
+		c.t.Fatal(err)
+	}
+	return c.seq
+}
+
+func (c *asbURBClient) unlink(target uint32) uint32 {
+	c.t.Helper()
+	c.seq++
+	cmd := usbip.CmdUnlink{Basic: usbip.HeaderBasic{Command: usbip.CmdUnlinkCode, Seqnum: c.seq}, UnlinkSeqnum: target}
+	var b bytes.Buffer
+	if err := cmd.Write(&b); err != nil {
+		c.t.Fatal(err)
+	}
+	if _, err := c.conn.Write(b.Bytes()); err != nil {
+		c.t.Fatal(err)
+	}
+	return c.seq
+}
+
+func (c *asbURBClient) expect(seq uint32) asbReply {
+	c.t.Helper()
+	_ = c.conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	defer func() { _ = c.conn.SetReadDeadline(time.Time{}) }()
+	var hdr [48]byte
+	if err := usbip.ReadExactly(c.conn, hdr[:]); err != nil {
+		c.t.Fatalf("waiting for seq %d: %v", seq, err)
+	}
+	r := asbReply{
+		cmd:        binary.BigEndian.Uint32(hdr[0:4]),
+		seq:        binary.BigEndian.Uint32(hdr[4:8]),
+		status:     int32(binary.BigEndian.Uint32(hdr[20:24])),
+		actual:     binary.BigEndian.Uint32(hdr[24:28]),
+		startFrame: binary.BigEndian.Uint32(hdr[28:32]),
+		packets:    binary.BigEndian.Uint32(hdr[32:36]),
+		at:         time.Now(),
+	}
+	if r.cmd == usbip.RetSubmitCode {
+		if c.dirIn[r.seq] && r.actual > 0 {
+			r.payload = make([]byte, r.actual)
+			if err := usbip.ReadExactly(c.conn, r.payload); err != nil {
+				c.t.Fatal(err)
+			}
+		}
+		for i := uint32(0); i < r.packets; i++ {
+			var d usbip.IsoPacketDescriptor
+			if err := d.Read(c.conn); err != nil {
+				c.t.Fatal(err)
+			}
+			r.iso = append(r.iso, d)
+		}
+	}
+	if r.seq != seq {
+		c.t.Fatalf("got reply for seq %d (cmd %d), want %d", r.seq, r.cmd, seq)
+	}
+	return r
+}
+
+func asbIsoPackets(count int, length uint32) []usbip.IsoPacketDescriptor {
+	out := make([]usbip.IsoPacketDescriptor, count)
+	for i := range out {
+		out[i] = usbip.IsoPacketDescriptor{Offset: uint32(i) * length, Length: length}
+	}
+	return out
+}
+
+func asbPCM(frames int, left, right int16) []byte {
+	b := make([]byte, frames*8)
+	for i := 0; i < frames; i++ {
+		binary.LittleEndian.PutUint16(b[i*8+4:], uint16(left))
+		binary.LittleEndian.PutUint16(b[i*8+6:], uint16(right))
+	}
+	return b
+}
+
+func asbNeutralInput(option byte, r2 uint8) []byte {
+	input := make([]byte, 33)
+	input[0], input[1], input[2], input[3] = 128, 128, 128, 128
+	input[5] = r2
+	input[32] = option
+	return input
+}
+
+func TestASBDualSenseIsoAndInterruptURBs(t *testing.T) {
+	srv := usb.New(usb.ServerConfig{
+		Addr:                    "127.0.0.1:0",
+		ConnectionTimeout:       2 * time.Second,
+		BusCleanupTimeout:       time.Second,
+		WriteBatchFlushInterval: time.Millisecond,
+		LoopbackOnly:            true,
+	}, slog.New(slog.NewTextHandler(io.Discard, nil)), nil)
+	go func() { _ = srv.ListenAndServe() }()
+	<-srv.Ready()
+	defer func() { _ = srv.Close() }()
+
+	bus, err := virtualbus.NewWithBusID(srv.NextFreeBusID())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := srv.AddBus(bus); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = srv.RemoveBus(bus.BusID()) }()
+	ds, err := dualsense.New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := bus.Add(ds); err != nil {
+		t.Fatal(err)
+	}
+	var framesMu sync.Mutex
+	frameCounts := map[uint8]int{}
+	ds.SetRawOutputCallback(func(f dualsense.FeedbackFrame) {
+		framesMu.Lock()
+		frameCounts[f.Type]++
+		framesMu.Unlock()
+	})
+	frameCount := func(frameType uint8) int {
+		framesMu.Lock()
+		defer framesMu.Unlock()
+		return frameCounts[frameType]
+	}
+
+	conn, err := net.Dial("tcp", srv.Addr())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = conn.Close() }()
+	metas := bus.GetAllDeviceMetas()
+	if len(metas) != 1 {
+		t.Fatalf("bus devices = %d, want 1", len(metas))
+	}
+	var importReq bytes.Buffer
+	if err := (&usbip.MgmtHeader{Version: usbip.Version, Command: usbip.OpReqImport}).Write(&importReq); err != nil {
+		t.Fatal(err)
+	}
+	importReq.Write(metas[0].Meta.USBBusID[:])
+	if _, err := conn.Write(importReq.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+	importReply := make([]byte, 8+312)
+	if err := usbip.ReadExactly(conn, importReply); err != nil {
+		t.Fatal(err)
+	}
+	if binary.BigEndian.Uint16(importReply[2:4]) != usbip.OpRepImport || binary.BigEndian.Uint32(importReply[4:8]) != 0 {
+		t.Fatalf("import reply header: % x", importReply[:8])
+	}
+	c := &asbURBClient{t: t, conn: conn, dirIn: map[uint32]bool{}}
+
+	t.Run("standard interface requests", func(t *testing.T) {
+		c.t = t
+		seq := c.submit(usbip.DirOut, 0, 0, [8]byte{0x01, 0x0B, 1, 0, 1, 0, 0, 0}, nil, nil, 0)
+		if r := c.expect(seq); r.status != 0 || r.packets != 0 || len(r.payload) != 0 {
+			t.Fatalf("SET_INTERFACE: %+v", r)
+		}
+		seq = c.submit(usbip.DirIn, 0, 0, [8]byte{0x81, 0x0A, 0, 0, 1, 0, 1, 0}, nil, nil, 1)
+		if r := c.expect(seq); !bytes.Equal(r.payload, []byte{1}) {
+			t.Fatalf("GET_INTERFACE = %x", r.payload)
+		}
+		seq = c.submit(usbip.DirOut, 0, 0, [8]byte{0x02, 0x01, 0, 0, 0x84, 0, 0, 0}, nil, nil, 0)
+		if r := c.expect(seq); r.status != 0 {
+			t.Fatalf("CLEAR_FEATURE: %+v", r)
+		}
+	})
+
+	t.Run("unpaced iso out completes after the fixed delay", func(t *testing.T) {
+		c.t = t
+		payload := asbPCM(4*48, 1000, 2000)
+		start := time.Now()
+		seq := c.submit(usbip.DirOut, 1, 777, [8]byte{}, payload, asbIsoPackets(4, 384), 0)
+		r := c.expect(seq)
+		if r.status != 0 || r.actual != uint32(len(payload)) || r.startFrame != 777 || r.packets != 4 || len(r.payload) != 0 {
+			t.Fatalf("ISO OUT RET_SUBMIT: %+v", r)
+		}
+		for i, d := range r.iso {
+			if d.Offset != uint32(i)*384 || d.Length != 384 || d.ActualLength != 384 || d.Status != 0 {
+				t.Fatalf("ISO OUT descriptor %d: %+v", i, d)
+			}
+		}
+		if elapsed := r.at.Sub(start); elapsed < time.Millisecond {
+			t.Fatalf("unpaced ISO OUT completed after %v", elapsed)
+		}
+	})
+
+	t.Run("iso in completes with a silent payload", func(t *testing.T) {
+		c.t = t
+		seq := c.submit(usbip.DirIn, 2, 55, [8]byte{}, nil, asbIsoPackets(2, 196), 392)
+		r := c.expect(seq)
+		if r.status != 0 || r.actual != 392 || r.packets != 2 || r.startFrame != 55 || !bytes.Equal(r.payload, make([]byte, 392)) {
+			t.Fatalf("ISO IN RET_SUBMIT: %+v", r)
+		}
+		for i, d := range r.iso {
+			if d.ActualLength != 196 || d.Status != 0 {
+				t.Fatalf("ISO IN descriptor %d: %+v", i, d)
+			}
+		}
+	})
+
+	t.Run("paced iso out follows packet duration and feeds the 2 kHz stream", func(t *testing.T) {
+		c.t = t
+		if err := ds.UpdateASBInputState(asbNeutralInput(0xC0, 0)); err != nil {
+			t.Fatal(err)
+		}
+		start := time.Now()
+		var seqs []uint32
+		for i := 0; i < 4; i++ {
+			seqs = append(seqs, c.submit(usbip.DirOut, 1, uint32(100+i), [8]byte{}, asbPCM(8*48, 4000, -4000), asbIsoPackets(8, 384), 0))
+		}
+		var last asbReply
+		for _, seq := range seqs {
+			last = c.expect(seq)
+			if last.packets != 8 || last.status != 0 {
+				t.Fatalf("paced ISO OUT: %+v", last)
+			}
+		}
+		if elapsed := last.at.Sub(start); elapsed < 28*time.Millisecond {
+			t.Fatalf("4 paced URBs of 8 packets completed after %v, want about 32ms", elapsed)
+		}
+		if frameCount(dualsense.FeedbackFrameAudioWaveform2k) == 0 {
+			t.Fatal("no 2 kHz waveform frame was emitted")
+		}
+	})
+
+	t.Run("unlinked pending iso out never completes", func(t *testing.T) {
+		c.t = t
+		seq := c.submit(usbip.DirOut, 1, 9, [8]byte{}, asbPCM(40*48, 0, 0), asbIsoPackets(40, 384), 0)
+		r := c.expect(c.unlink(seq))
+		if r.cmd != usbip.RetUnlinkCode || r.status != -104 {
+			t.Fatalf("RET_UNLINK: %+v", r)
+		}
+		time.Sleep(60 * time.Millisecond)
+		statusSeq := c.submit(usbip.DirIn, 0, 0, [8]byte{0x80, 0x00, 0, 0, 0, 0, 2, 0}, nil, nil, 2)
+		if r := c.expect(statusSeq); r.cmd != usbip.RetSubmitCode || r.status != 0 {
+			t.Fatalf("GET_STATUS: %+v", r)
+		}
+	})
+
+	t.Run("interrupt in carries synthesized trigger state", func(t *testing.T) {
+		c.t = t
+		out := make([]byte, 64)
+		out[0] = dualsense.ReportIDOutput
+		out[1] = 0x04
+		out[11] = 0x25
+		out[12] = 1 << 2
+		out[13] = 1
+		binary.LittleEndian.PutUint32(out[33:37], 0x78563412)
+		seq := c.submit(usbip.DirOut, 3, 0, [8]byte{}, out, nil, 0)
+		if r := c.expect(seq); r.status != 0 || r.actual != 64 || len(r.payload) != 0 {
+			t.Fatalf("HID OUT: %+v", r)
+		}
+		if frameCount(dualsense.FeedbackFrameHIDOutput) == 0 {
+			t.Fatal("HID output frame was not emitted")
+		}
+		if err := ds.UpdateASBInputState(asbNeutralInput(0xC0, 100)); err != nil {
+			t.Fatal(err)
+		}
+		var report []byte
+		for deadline := time.Now().Add(time.Second); time.Now().Before(deadline); {
+			r := c.expect(c.submit(usbip.DirIn, 4, 0, [8]byte{}, nil, nil, 64))
+			if len(r.payload) == 64 && r.payload[6] == 100 && r.payload[42] == 0x13 {
+				report = r.payload
+				break
+			}
+		}
+		if report == nil {
+			t.Fatal("interrupt IN never reported the weapon trigger state")
+		}
+		if report[48]&0x0F != 2 || binary.LittleEndian.Uint32(report[44:48]) != 0x78563412 {
+			t.Fatalf("trigger metadata: % x", report[40:55])
+		}
+	})
+}
