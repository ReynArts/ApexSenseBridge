+func TestASBDeviceRemovalWhileReadingAnURBClosesTheStreamCleanly(t *testing.T) {
+	header := func(dir, ep, length, packets uint32) []byte {
+		var b bytes.Buffer
+		_ = (&usbip.CmdSubmit{
+			Basic:             usbip.HeaderBasic{Command: usbip.CmdSubmitCode, Seqnum: 1, Dir: dir, Ep: ep},
+			TransferBufferLen: length,
+			NumberOfPackets:   packets,
+		}).Write(&b)
+		return b.Bytes()
+	}
+	cases := []struct {
+		name    string
+		partial []byte
+	}{
+		{name: "between URBs"},
+		{name: "inside an OUT payload", partial: append(header(usbip.DirOut, 3, 64, 0xFFFFFFFF), make([]byte, 10)...)},
+		{name: "inside ISO packet descriptors", partial: append(append(header(usbip.DirOut, 1, 768, 2), make([]byte, 768)...), make([]byte, 20)...)},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			logs := &asbLogBuffer{}
+			s := newASBStream(t, time.Millisecond, logs)
+			s.send(tc.partial)
+			time.Sleep(20 * time.Millisecond)
+			busID := s.bus.BusID()
+			if err := s.bus.Remove(s.ds); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case <-s.done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("URB stream stayed open after device removal")
+			}
+			for deadline := time.Now().Add(2 * time.Second); s.srv.GetBus(busID) != nil; time.Sleep(5 * time.Millisecond) {
+				if time.Now().After(deadline) {
+					t.Fatalf("empty bus %d was not removed\n%s", busID, logs)
+				}
+			}
+			if out := logs.String(); strings.Contains(out, "level=ERROR") || !strings.Contains(out, "device removed, closing URB stream") {
+				t.Fatalf("device removal log:\n%s", out)
+			}
+		})
+	}
+}
