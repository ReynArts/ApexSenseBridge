+func TestASBIsoInCompletesAtThePacketRate(t *testing.T) {
+	s := newASBStream(t, 0, nil)
+	const inFlight, packets = 2, 10
+	submitIn := func(n int) uint32 {
+		return s.submit(usbip.DirIn, 2, nil, asbIsoPackets(n, 196), uint32(n)*196)
+	}
+	s.retryTiming(t, "real-time completion rate", func(t *testing.T) (string, bool) {
+		for i := 0; i < inFlight; i++ {
+			submitIn(packets)
+		}
+		start := time.Now()
+		completed := 0
+		for time.Since(start) < 200*time.Millisecond {
+			r := s.next(t, time.Second)
+			if r.cmd != usbip.RetSubmitCode {
+				continue
+			}
+			if r.actual != packets*196 || len(r.iso) != packets || !bytes.Equal(r.payload, make([]byte, packets*196)) {
+				t.Fatalf("ISO IN RET_SUBMIT: %+v", r)
+			}
+			completed++
+			submitIn(packets)
+		}
+		elapsed := time.Since(start)
+		realTime := int(elapsed / (packets * time.Millisecond))
+		s.quiet(3 * packets * time.Millisecond)
+		return fmt.Sprintf("ISO IN completed %d URBs of %d packets in %v (real time: about %d)", completed, packets, elapsed, realTime),
+			completed <= realTime+inFlight+1 && completed >= realTime/2
+	})
+
+	unlinkSeq := s.unlink(submitIn(40))
+	got := append([]asbReply{s.next(t, time.Second)}, s.quiet(60*time.Millisecond)...)
+	if len(got) != 1 || got[0].cmd != usbip.RetUnlinkCode || got[0].seq != unlinkSeq || got[0].status != -104 {
+		t.Fatalf("replies to an unlinked pending ISO IN: %+v", got)
+	}
+}
