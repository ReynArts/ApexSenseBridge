+func (s *asbStream) retryTiming(t *testing.T, name string, run func(t *testing.T) (string, bool)) {
+	t.Run(name, func(t *testing.T) {
+		const attempts = 3
+		for attempt := 1; ; attempt++ {
+			msg, ok := run(t)
+			t.Logf("attempt %d: %s", attempt, msg)
+			if ok {
+				return
+			}
+			if attempt == attempts {
+				t.Fatalf("failed %d attempts in a row: %s", attempts, msg)
+			}
+			s.quiet(100 * time.Millisecond)
+		}
+	})
+}
