+package usb_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"log/slog"
+	"math/rand"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Alia5/VIIPER/device/dualsense"
+	"github.com/Alia5/VIIPER/internal/server/usb"
+	usbdev "github.com/Alia5/VIIPER/usb"
+	"github.com/Alia5/VIIPER/usbip"
+	"github.com/Alia5/VIIPER/virtualbus"
+)
+
+type asbStream struct {
+	srv     *usb.Server
+	bus     *virtualbus.VirtualBus
+	ds      *dualsense.DualSense
+	conn    net.Conn
+	mu      sync.Mutex
+	wmu     sync.Mutex
+	seq     uint32
+	dirIn   map[uint32]bool
+	replies chan asbReply
+	done    chan struct{}
+}
+
+type asbLogBuffer struct {
+	mu sync.Mutex
+	b  bytes.Buffer
+}
+
+func (l *asbLogBuffer) Write(p []byte) (int, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.b.Write(p)
+}
+
+func (l *asbLogBuffer) String() string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.b.String()
+}
+
+func newASBStream(t *testing.T, batch time.Duration, logs io.Writer) *asbStream {
+	t.Helper()
+	ds, err := dualsense.New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := newASBStreamFor(t, batch, logs, ds)
+	s.ds = ds
+	return s
+}
+
+func newASBStreamFor(t *testing.T, batch time.Duration, logs io.Writer, dev usbdev.Device) *asbStream {
+	t.Helper()
+	handler := slog.DiscardHandler
+	if logs != nil {
+		handler = slog.NewTextHandler(logs, &slog.HandlerOptions{Level: slog.LevelDebug})
+	}
+	srv := usb.New(usb.ServerConfig{
+		Addr:                    "127.0.0.1:0",
+		ConnectionTimeout:       2 * time.Second,
+		BusCleanupTimeout:       20 * time.Millisecond,
+		WriteBatchFlushInterval: batch,
+		LoopbackOnly:            true,
+	}, slog.New(handler), nil)
+	go func() { _ = srv.ListenAndServe() }()
+	<-srv.Ready()
+	bus, err := virtualbus.NewWithBusID(srv.NextFreeBusID())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := srv.AddBus(bus); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := bus.Add(dev); err != nil {
+		t.Fatal(err)
+	}
+	conn, err := net.Dial("tcp", srv.Addr())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &asbStream{srv: srv, bus: bus, conn: conn, dirIn: map[uint32]bool{}, replies: make(chan asbReply, 16384), done: make(chan struct{})}
+	t.Cleanup(func() {
+		_ = conn.Close()
+		<-s.done
+		_ = srv.RemoveBus(bus.BusID())
+		_ = srv.Close()
+	})
+	var importReq bytes.Buffer
+	if err := (&usbip.MgmtHeader{Version: usbip.Version, Command: usbip.OpReqImport}).Write(&importReq); err != nil {
+		t.Fatal(err)
+	}
+	importReq.Write(bus.GetAllDeviceMetas()[0].Meta.USBBusID[:])
+	if _, err := conn.Write(importReq.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+	importReply := make([]byte, 8+312)
+	if err := usbip.ReadExactly(conn, importReply); err != nil {
+		t.Fatal(err)
+	}
+	go s.readLoop()
+	return s
+}
+
+func (s *asbStream) readLoop() {
+	defer close(s.done)
+	for {
+		var hdr [48]byte
+		if err := usbip.ReadExactly(s.conn, hdr[:]); err != nil {
+			return
+		}
+		r := asbReply{
+			cmd:        binary.BigEndian.Uint32(hdr[0:4]),
+			seq:        binary.BigEndian.Uint32(hdr[4:8]),
+			status:     int32(binary.BigEndian.Uint32(hdr[20:24])),
+			actual:     binary.BigEndian.Uint32(hdr[24:28]),
+			startFrame: binary.BigEndian.Uint32(hdr[28:32]),
+			packets:    binary.BigEndian.Uint32(hdr[32:36]),
+			at:         time.Now(),
+		}
+		if r.cmd == usbip.RetSubmitCode {
+			s.mu.Lock()
+			in := s.dirIn[r.seq]
+			s.mu.Unlock()
+			if in && r.actual > 0 {
+				r.payload = make([]byte, r.actual)
+				if err := usbip.ReadExactly(s.conn, r.payload); err != nil {
+					return
+				}
+			}
+			if r.packets > 0 {
+				r.iso = make([]usbip.IsoPacketDescriptor, r.packets)
+				if err := binary.Read(s.conn, binary.BigEndian, r.iso); err != nil {
+					return
+				}
+			}
+		}
+		s.replies <- r
+	}
+}
+
+func (s *asbStream) nextSeq(dirIn bool) uint32 {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.seq++
+	s.dirIn[s.seq] = dirIn
+	return s.seq
+}
+
+func (s *asbStream) send(b []byte) {
+	s.wmu.Lock()
+	defer s.wmu.Unlock()
+	_, _ = s.conn.Write(b)
+}
+
+func (s *asbStream) submit(dir, ep uint32, out []byte, iso []usbip.IsoPacketDescriptor, inLen uint32) uint32 {
+	seq := s.nextSeq(dir == usbip.DirIn)
+	numberOfPackets := uint32(0xFFFFFFFF)
+	if len(iso) > 0 {
+		numberOfPackets = uint32(len(iso))
+	}
+	bufLen := inLen
+	if dir == usbip.DirOut {
+		bufLen = uint32(len(out))
+	}
+	cmd := usbip.CmdSubmit{
+		Basic:             usbip.HeaderBasic{Command: usbip.CmdSubmitCode, Seqnum: seq, Dir: dir, Ep: ep},
+		TransferBufferLen: bufLen,
+		NumberOfPackets:   numberOfPackets,
+	}
+	var b bytes.Buffer
+	_ = cmd.Write(&b)
+	b.Write(out)
+	_ = binary.Write(&b, binary.BigEndian, iso)
+	s.send(b.Bytes())
+	return seq
+}
+
+func (s *asbStream) unlink(target uint32) uint32 {
+	seq := s.nextSeq(false)
+	var b bytes.Buffer
+	_ = (&usbip.CmdUnlink{Basic: usbip.HeaderBasic{Command: usbip.CmdUnlinkCode, Seqnum: seq}, UnlinkSeqnum: target}).Write(&b)
+	s.send(b.Bytes())
+	return seq
+}
+
+func (s *asbStream) next(t *testing.T, timeout time.Duration) asbReply {
+	t.Helper()
+	select {
+	case r := <-s.replies:
+		return r
+	case <-time.After(timeout):
+		t.Fatalf("no USB/IP reply within %v", timeout)
+		return asbReply{}
+	}
+}
+
+func (s *asbStream) quiet(timeout time.Duration) []asbReply {
+	var out []asbReply
+	for {
+		select {
+		case r := <-s.replies:
+			out = append(out, r)
+		case <-time.After(timeout):
+			return out
+		}
+	}
+}
+
+func asbSpin(d time.Duration) {
+	for end := time.Now().Add(d); time.Now().Before(end); {
+	}
+}
+
+func TestASBInterruptINUnlinkRacingCompletionRepliesOnce(t *testing.T) {
+	s := newASBStream(t, 0, nil)
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for v := uint8(0); ; v++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			_ = s.ds.UpdateASBInputState(asbNeutralInput(0, v))
+			asbSpin(30 * time.Microsecond)
+		}
+	}()
+	const rounds = 3000
+	targets := map[uint32]uint32{}
+	rng := rand.New(rand.NewSource(7))
+	for i := 0; i < rounds; i++ {
+		target := s.submit(usbip.DirIn, 4, nil, nil, 64)
+		asbSpin(time.Duration(rng.Intn(120)) * time.Microsecond)
+		targets[s.unlink(target)] = target
+	}
+	close(stop)
+	wg.Wait()
+
+	submitAt := map[uint32][]int{}
+	unlinkAt := map[uint32]int{}
+	unlinkStatus := map[uint32]int32{}
+	var replies []asbReply
+	for len(unlinkStatus) < rounds {
+		r := s.next(t, 2*time.Second)
+		replies = append(replies, r)
+		if r.cmd == usbip.RetUnlinkCode {
+			unlinkStatus[targets[r.seq]] = r.status
+			unlinkAt[targets[r.seq]] = len(replies)
+		}
+	}
+	replies = append(replies, s.quiet(20*time.Millisecond)...)
+	for i, r := range replies {
+		if r.cmd == usbip.RetSubmitCode {
+			submitAt[r.seq] = append(submitAt[r.seq], i+1)
+		}
+	}
+	resetOnly, completedFirst, violations := 0, 0, 0
+	for _, target := range targets {
+		subs := submitAt[target]
+		switch {
+		case unlinkStatus[target] == -104 && len(subs) == 0:
+			resetOnly++
+		case unlinkStatus[target] == 0 && len(subs) == 1 && subs[0] < unlinkAt[target]:
+			completedFirst++
+		default:
+			violations++
+			if violations <= 5 {
+				t.Errorf("seq %d: RET_UNLINK status %d at reply %d, RET_SUBMIT at replies %v", target, unlinkStatus[target], unlinkAt[target], subs)
+			}
+		}
+	}
+	t.Logf("rounds=%d reset-only=%d completed-then-unlinked=%d violations=%d", rounds, resetOnly, completedFirst, violations)
+}
