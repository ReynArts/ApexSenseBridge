+func TestASBInterruptINReportCountersStayMonotonic(t *testing.T) {
+	s := newASBStream(t, time.Millisecond, nil)
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		tk := time.NewTicker(time.Millisecond)
+		defer tk.Stop()
+		for v, end := uint8(0), time.Now().Add(150*time.Millisecond); time.Now().Before(end); v++ {
+			select {
+			case <-stop:
+				return
+			case <-tk.C:
+			}
+			_ = s.ds.UpdateASBInputState(asbNeutralInput(0, v))
+		}
+	}()
+	defer func() {
+		close(stop)
+		wg.Wait()
+	}()
+	for i := 0; i < 4; i++ {
+		s.submit(usbip.DirIn, 4, nil, nil, 64)
+	}
+	reports, violations := 0, 0
+	var last []byte
+	for end := time.Now().Add(400 * time.Millisecond); time.Now().Before(end); {
+		r := s.next(t, time.Second)
+		if r.cmd != usbip.RetSubmitCode || len(r.payload) != 64 {
+			continue
+		}
+		s.submit(usbip.DirIn, 4, nil, nil, 64)
+		reports++
+		if last != nil {
+			counterStep := int8(r.payload[7] - last[7])
+			timestampStep := int32(binary.LittleEndian.Uint32(r.payload[28:32]) - binary.LittleEndian.Uint32(last[28:32]))
+			if counterStep <= 0 || timestampStep < 0 {
+				violations++
+				if violations <= 5 {
+					t.Errorf("report %d: counter %d after %d, timestamp step %d", reports, r.payload[7], last[7], timestampStep)
+				}
+			}
+		}
+		last = r.payload
+	}
+	t.Logf("reports=%d violations=%d", reports, violations)
+}
