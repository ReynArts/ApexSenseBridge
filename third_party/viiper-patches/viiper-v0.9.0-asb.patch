+//
+//export SetDualSenseASBRawOutputCallback
+func SetDualSenseASBRawOutputCallback(handle C.DSDeviceHandle, cb C.DSASBRawOutputCallback, callbackContext C.uintptr_t) bool {
+	dh := cgo.Handle(handle)
+	dhw, ok := dh.Value().(*deviceHandleWrapper)
+	if !ok {
+		return false
+	}
+	dsDevice, ok := dhw.device.(*dualsense.DualSense)
+	if !ok {
+		return false
+	}
+	if cb == nil {
+		dsDevice.SetRawOutputCallback(nil)
+		return true
+	}
+	dsDevice.SetRawOutputCallback(func(frame dualsense.FeedbackFrame) {
+		encoded, err := frame.MarshalBinary()
+		if err != nil || len(encoded) == 0 {
+			return
+		}
+		C.viiper_call_ds_asb_raw_output(
+			cb,
+			callbackContext,
+			(*C.uint8_t)(unsafe.Pointer(&encoded[0])),
+			C.uint32_t(len(encoded)),
+		)
+	})
+	return true
+}
