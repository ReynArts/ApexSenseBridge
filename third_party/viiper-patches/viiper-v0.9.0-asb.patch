+		}
+		candidate := filepath.Join(programFiles, "USBip", "usbip.exe")
+		if info, err := os.Stat(candidate); err == nil && !info.IsDir() {
+			return candidate, nil
+		}
+	}
+
+	return "", fmt.Errorf("usbip.exe was not found in PATH or the standard USBip installation directory")
