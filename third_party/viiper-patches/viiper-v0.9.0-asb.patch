+func TestASBIsoCompletionsStayInSubmissionOrder(t *testing.T) {
+	s := newASBStream(t, time.Millisecond, nil)
+	var burst bytes.Buffer
+	var seqs []uint32
+	for i := 0; i < 64; i++ {
+		seq := s.nextSeq(false)
+		seqs = append(seqs, seq)
+		_ = (&usbip.CmdSubmit{
+			Basic:             usbip.HeaderBasic{Command: usbip.CmdSubmitCode, Seqnum: seq, Dir: usbip.DirOut, Ep: 1},
+			TransferBufferLen: 384,
+			NumberOfPackets:   1,
+		}).Write(&burst)
+		burst.Write(asbPCM(48, 1000, -1000))
+		_ = binary.Write(&burst, binary.BigEndian, asbIsoPackets(1, 384))
+	}
+	s.send(burst.Bytes())
+	reordered := 0
+	var last uint32
+	for i := range seqs {
+		r := s.next(t, 2*time.Second)
+		if r.cmd != usbip.RetSubmitCode || r.seq < last {
+			reordered++
+			if reordered <= 3 {
+				t.Errorf("completion %d: seq %d after seq %d", i, r.seq, last)
+			}
+			continue
+		}
+		last = r.seq
+	}
+	t.Logf("ISO OUT completions out of submission order: %d of %d", reordered, len(seqs))
+}
