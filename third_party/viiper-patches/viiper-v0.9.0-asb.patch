+	if feedback.EnableBits1 != 0x0F || feedback.EnableBits2 != 0xD7 ||
+		feedback.RumbleRight != 68 || feedback.RumbleLeft != 215 ||
+		feedback.RightTriggerEffect[0] != 0x21 || feedback.RightTriggerEffect[10] != 0xAA ||
+		feedback.LeftTriggerEffect[0] != 0x05 || feedback.LeftTriggerEffect[10] != 0xBB ||
+		feedback.EnableBits3 != 0x04 || feedback.LightbarRed != 21 ||
