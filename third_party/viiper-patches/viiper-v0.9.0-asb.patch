+// SetDualSenseASBInputState updates a DualSense from ApexSenseBridge's compact
+// 33-byte input format. This extension preserves the exact behavior of the
+// patched sidecar when libVIIPER is hosted in-process.
+//
+//export SetDualSenseASBInputState
+func SetDualSenseASBInputState(handle C.DSDeviceHandle, data *C.uint8_t, size C.uint32_t) bool {
+	if data == nil || size != 33 {
+		return false
+	}
+	dh := cgo.Handle(handle)
+	dhw, ok := dh.Value().(*deviceHandleWrapper)
+	if !ok {
+		return false
