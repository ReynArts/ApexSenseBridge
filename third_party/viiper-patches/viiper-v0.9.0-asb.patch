+func TestASBInterruptINReportsFollowInputOrder(t *testing.T) {
+	s := newASBStream(t, time.Millisecond, nil)
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		input := asbNeutralInput(0, 0)
+		start := time.Now()
+		for seq := uint32(1); ; seq++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			binary.LittleEndian.PutUint32(input[19:23], seq)
+			_ = s.ds.UpdateASBInputState(input)
+			switch elapsed := time.Since(start); {
+			case elapsed < 150*time.Millisecond:
+			case elapsed < 300*time.Millisecond:
+				asbSpin(500 * time.Microsecond)
+			default:
+				asbSpin(time.Duration(3500+seq%1000) * time.Microsecond)
+			}
+		}
+	}()
+	defer func() {
+		close(stop)
+		wg.Wait()
+	}()
+	for i := 0; i < 3; i++ {
+		s.submit(usbip.DirIn, 4, nil, nil, 64)
+	}
+	reports, backwards := 0, 0
+	var last uint32
+	for end := time.Now().Add(450 * time.Millisecond); time.Now().Before(end); {
+		r := s.next(t, time.Second)
+		if r.cmd != usbip.RetSubmitCode || len(r.payload) != 64 {
+			continue
+		}
+		s.submit(usbip.DirIn, 4, nil, nil, 64)
+		reports++
+		if seq := binary.LittleEndian.Uint32(r.payload[16:20]); seq < last {
+			backwards++
+			if backwards <= 5 {
+				t.Errorf("report %d carries input %d after input %d", reports, seq, last)
+			}
+		} else {
+			last = seq
+		}
+	}
+	t.Logf("reports=%d backwards=%d last-input=%d", reports, backwards, last)
+}
