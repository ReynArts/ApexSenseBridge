+func processIsoSubmit(ctx context.Context, dev usb.Device, ep uint32, dir uint32, out []byte, isoPackets []usbip.IsoPacketDescriptor) ([]byte, []usbip.IsoPacketDescriptor) {
+	isoDev, ok := dev.(usb.IsoTransferDevice)
+	if !ok {
+		return dev.HandleTransfer(ctx, ep, dir, out), isoPackets
+	}
+	packets := make([]usb.IsoPacket, len(isoPackets))
+	for i, pkt := range isoPackets {
+		packets[i] = usb.IsoPacket{
+			Offset: pkt.Offset, Length: pkt.Length,
+			ActualLength: pkt.ActualLength, Status: pkt.Status,
+		}
+	}
+	data, usbPackets := isoDev.HandleIsoTransfer(ep, dir, out, packets)
+	respPackets := make([]usbip.IsoPacketDescriptor, len(usbPackets))
+	for i, pkt := range usbPackets {
+		respPackets[i] = usbip.IsoPacketDescriptor{
+			Offset: pkt.Offset, Length: pkt.Length,
+			ActualLength: pkt.ActualLength, Status: pkt.Status,
+		}
+	}
+	return data, respPackets
