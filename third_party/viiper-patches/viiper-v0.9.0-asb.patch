+func TestASBPacedIsoOutRestartAfterUnlink(t *testing.T) {
+	s := newASBStream(t, time.Millisecond, nil)
+	if err := s.ds.UpdateASBInputState(asbNeutralInput(0xC0, 0)); err != nil {
+		t.Fatal(err)
+	}
+	submitOut := func(packets int) uint32 {
+		return s.submit(usbip.DirOut, 1, asbPCM(packets*48, 3000, -3000), asbIsoPackets(packets, 384), 0)
+	}
+	waitFor := func(t *testing.T, seq uint32) asbReply {
+		t.Helper()
+		for {
+			if r := s.next(t, 2*time.Second); r.seq == seq {
+				return r
+			}
+		}
+	}
+
+	s.retryTiming(t, "whole backlog unlinked", func(t *testing.T) (string, bool) {
+		var backlog []uint32
+		for i := 0; i < 20; i++ {
+			backlog = append(backlog, submitOut(10))
+		}
+		var lastUnlink uint32
+		for _, seq := range backlog {
+			lastUnlink = s.unlink(seq)
+		}
+		if r := waitFor(t, lastUnlink); r.cmd != usbip.RetUnlinkCode || r.status != -104 {
+			return fmt.Sprintf("RET_UNLINK of the backlog tail: %+v", r), false
+		}
+		start := time.Now()
+		r := waitFor(t, submitOut(1))
+		elapsed := r.at.Sub(start)
+		return fmt.Sprintf("first 1-packet URB after unlinking 20 x 10 packets completed after %v", elapsed), r.cmd == usbip.RetSubmitCode && elapsed <= 25*time.Millisecond
+	})
+
+	s.retryTiming(t, "unlinked tail rewinds to the last pending deadline", func(t *testing.T) (string, bool) {
+		first, second, tail := submitOut(10), submitOut(10), submitOut(10)
+		if r := waitFor(t, s.unlink(tail)); r.cmd != usbip.RetUnlinkCode || r.status != -104 {
+			return fmt.Sprintf("RET_UNLINK of the tail: %+v", r), false
+		}
+		next := submitOut(1)
+		var order []uint32
+		var secondAt, nextAt time.Time
+		for len(order) < 3 {
+			r := s.next(t, 2*time.Second)
+			if r.cmd != usbip.RetSubmitCode {
+				continue
+			}
+			order = append(order, r.seq)
+			switch r.seq {
+			case second:
+				secondAt = r.at
+			case next:
+				nextAt = r.at
+			}
+		}
+		gap := nextAt.Sub(secondAt)
+		return fmt.Sprintf("completion order %v (want %d %d %d), new URB completed %v after the last pending one", order, first, second, next, gap),
+			order[0] == first && order[1] == second && order[2] == next && gap <= 6*time.Millisecond
+	})
+}
