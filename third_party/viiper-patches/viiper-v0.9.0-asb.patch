+	}
+	pcm := make([]byte, 8*48*8)
+	packets := []usb.IsoPacket{{Offset: 0, Length: uint32(len(pcm))}}
+	ds.HandleIsoTransfer(1, usbip.DirOut, pcm, packets)
+	if waveformFrames != 0 {
