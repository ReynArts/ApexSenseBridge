@@ -0,0 +1,95 @@
+package usb
+
+import (
+	"bufio"
+	"bytes"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+type nonTCPAddr string
+
+func (a nonTCPAddr) Network() string { return "test" }
+func (a nonTCPAddr) String() string  { return string(a) }
+
+func TestIsLoopbackClient(t *testing.T) {
+	tests := []struct {
+		name string
+		addr net.Addr
+		want bool
+	}{
+		{name: "IPv4 loopback", addr: &net.TCPAddr{IP: net.ParseIP("127.0.0.1")}, want: true},
+		{name: "IPv6 loopback", addr: &net.TCPAddr{IP: net.ParseIP("::1")}, want: true},
+		{name: "LAN IPv4", addr: &net.TCPAddr{IP: net.ParseIP("192.168.1.50")}, want: false},
+		{name: "public IPv4", addr: &net.TCPAddr{IP: net.ParseIP("203.0.113.10")}, want: false},
+		{name: "non TCP", addr: nonTCPAddr("127.0.0.1"), want: false},
+		{name: "nil", addr: nil, want: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := isLoopbackClient(tt.addr); got != tt.want {
+				t.Fatalf("isLoopbackClient(%v) = %v, want %v", tt.addr, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestIsoOutCompletionDeadline(t *testing.T) {
+	now := time.Unix(100, 0)
+	previous := now.Add(40 * time.Millisecond)
+	next, delay := isoOutCompletionDeadline(now, previous, 6, false)
+	if !next.Equal(previous) || delay != isoOutSubmitDelay {
+		t.Fatalf("legacy pacing changed: next=%v delay=%v", next, delay)
+	}
+
+	next, delay = isoOutCompletionDeadline(now, time.Time{}, 6, true)
+	if want := now.Add(6 * time.Millisecond); !next.Equal(want) || delay != 6*time.Millisecond {
+		t.Fatalf("first paced URB: next=%v delay=%v, want %v/6ms", next, delay, want)
+	}
+
+	secondNow := now.Add(time.Millisecond)
+	second, secondDelay := isoOutCompletionDeadline(secondNow, next, 6, true)
+	if want := now.Add(12 * time.Millisecond); !second.Equal(want) || secondDelay != 11*time.Millisecond {
+		t.Fatalf("queued paced URB: next=%v delay=%v, want %v/11ms", second, secondDelay, want)
+	}
+
+	third, thirdDelay := isoOutCompletionDeadline(second, second, 0, true)
+	if want := second.Add(time.Millisecond); !third.Equal(want) || thirdDelay != time.Millisecond {
+		t.Fatalf("empty paced URB: next=%v delay=%v, want %v/1ms", third, thirdDelay, want)
+	}
+
+	lateNow := next.Add(time.Millisecond)
+	late, lateDelay := isoOutCompletionDeadline(lateNow, next, 6, true)
+	if want := next.Add(6 * time.Millisecond); !late.Equal(want) || lateDelay != 5*time.Millisecond {
+		t.Fatalf("slightly late paced URB drifted: next=%v delay=%v, want %v/5ms", late, lateDelay, want)
+	}
+
+	veryLateNow := next.Add(7 * time.Millisecond)
+	reset, resetDelay := isoOutCompletionDeadline(veryLateNow, next, 6, true)
+	if want := veryLateNow.Add(6 * time.Millisecond); !reset.Equal(want) || resetDelay != 6*time.Millisecond {
+		t.Fatalf("stale paced timeline was not reset: next=%v delay=%v, want %v/6ms", reset, resetDelay, want)
+	}
+}
+
+func TestFlushBeforeBlockReaderFlushesOnlyWhenInputIsDrained(t *testing.T) {
+	flushes := 0
+	r := &flushBeforeBlockReader{
+		r:     bufio.NewReader(bytes.NewReader([]byte("abcdef"))),
+		flush: func() error { flushes++; return nil },
+	}
+	buf := make([]byte, 2)
+	for i := 0; i < 3; i++ {
+		if _, err := io.ReadFull(r, buf); err != nil {
+			t.Fatal(err)
+		}
+		if flushes != 1 {
+			t.Fatalf("read %d: %d flushes while input was buffered, want 1", i, flushes)
+		}
+	}
+	if _, err := r.Read(buf); err != io.EOF || flushes != 2 {
+		t.Fatalf("drained read: err=%v flushes=%d, want EOF after a second flush", err, flushes)
+	}
+}
