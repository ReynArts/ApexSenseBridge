<Window x:Class="ApexSenseBridgeTray.ControllerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_ControllerPickerTitle}" Width="500" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApexSenseBridgeTray;component/Themes/ConsoleTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PickerRow" TargetType="Border" BasedOn="{StaticResource SettingRow}">
                <Setter Property="MinHeight" Value="64"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="12,8,18,8"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="PickerChip" TargetType="Border">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="CornerRadius" Value="21"/>
                <Setter Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Margin" Value="0,0,14,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PickerName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="PickerSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
            <Style x:Key="CurrentCheck" TargetType="Border">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ConsoleWindowFrame}" MouseLeftButtonDown="OnWindowDrag">
        <Grid Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource WindowCloseBtn}" Click="OnCloseClick" VerticalAlignment="Top"/>
                <Border Style="{StaticResource IconBubble}" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" Background="#331E6FE8">
                    <Path Style="{StaticResource ControllerIconPath}" Stroke="White"/>
                </Border>
                <TextBlock Text="{DynamicResource Loc_ControllerPickerTitle}" FontSize="19" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer x:Name="ScrollControllers" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-8,-8,-8,0">
                <StackPanel x:Name="PnlControllers" Margin="8"/>
            </ScrollViewer>

            <TextBlock x:Name="TxtLocked" Grid.Row="2" Text="{DynamicResource Loc_ControllerPickerLocked}" TextWrapping="Wrap"
                       FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" Visibility="Collapsed"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <StackPanel Style="{StaticResource GamepadActionItem}">
                    <Border Style="{StaticResource XboxBtnB}"><Rectangle Style="{StaticResource XboxTextB}"/></Border>
                    <TextBlock Text="{DynamicResource Loc_Gamepad_Back}" Style="{StaticResource GamepadActionLabel}"/>
                </StackPanel>
                <StackPanel x:Name="HintSelect" Style="{StaticResource GamepadActionItem}" Margin="0">
                    <Border Style="{StaticResource XboxBtnA}"><Rectangle Style="{StaticResource XboxTextA}"/></Border>
                    <TextBlock Text="{DynamicResource Loc_Gamepad_Select}" Style="{StaticResource GamepadActionLabel}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
