<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════════════════
         Console theme shared by the Tray console windows.
         Merging this dictionary into a window overrides the shared theme
         keys from ThemeManager: console surfaces always render dark.
         Rounded shapes use explicit heights with CornerRadius = Height / 2
         so pills never distort.
         ═══════════════════════════════════════════════════════════════════ -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBackground" Color="#060A16"/>
    <SolidColorBrush x:Key="CardBackground" Color="#B3111A31"/>
    <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="FooterBackground" Color="#00000000"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#1B2540"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#3A4768"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AAB4CC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6E7995"/>
    <SolidColorBrush x:Key="BadgeActiveBg" Color="#2610B981"/>
    <SolidColorBrush x:Key="BadgeActiveFg" Color="#34D399"/>
    <SolidColorBrush x:Key="BadgeStandbyBg" Color="#1F5B8CFF"/>
    <SolidColorBrush x:Key="BadgeStandbyFg" Color="#8DB7FF"/>
    <SolidColorBrush x:Key="FeaturePillBg" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="FeaturePillBorder" Color="#00000000"/>
    <SolidColorBrush x:Key="PlayStationBlue" Color="#1E6FE8"/>
    <SolidColorBrush x:Key="PlayStationBluePressed" Color="#185CC4"/>
    <SolidColorBrush x:Key="PlayStationBlueActive" Color="#124A9E"/>
    <SolidColorBrush x:Key="TileHoverBorder" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="TrackBackground" Color="#2A3552"/>
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#1CFFFFFF"/>

    <!-- Gamepad focus: crisp white ring on a lifted fill, soft blue halo (keeps text contrast). -->
    <SolidColorBrush x:Key="GamepadFocusBorder" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GamepadFocusFill" Color="#2C3F72"/>
    <Color x:Key="GamepadFocusGlowColor">#7FA8FF</Color>
    <DropShadowEffect x:Key="GamepadFocusGlow" BlurRadius="18" ShadowDepth="0" Color="#7FA8FF" Opacity="0.45"/>
    <!-- Crisp focus ring placed 6 px outside a templated item (set CornerRadius = item radius + 6).
         Replaces blurred glows, which were cut off by scroll viewers. -->
    <Style x:Key="FocusRing" TargetType="Border">
        <Setter Property="Margin" Value="-6"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="2.5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <LinearGradientBrush x:Key="ConsoleBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E1D45" Offset="0"/>
        <GradientStop Color="#081128" Offset="0.45"/>
        <GradientStop Color="#04060E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Deep raspberry → ember: white bold text keeps a readable contrast on both ends. -->
    <LinearGradientBrush x:Key="SupportGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D61F5B" Offset="0"/>
        <GradientStop Color="#E5501C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SupportGradientHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E8336D" Offset="0"/>
        <GradientStop Color="#F2632C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SupportAccent" Color="#E0285F"/>

    <!-- Window frame: margin larger than the shadow so the blur never gets clipped by the window bounds. -->
    <Style x:Key="ConsoleWindowFrame" TargetType="Border">
        <Setter Property="Margin" Value="40"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{StaticResource ConsoleBackdrop}"/>
        <Setter Property="BorderBrush" Value="#29FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opaque frame for non-layered windows: no outer margin or shadow, DWM rounds the corners. -->
    <Style x:Key="ConsoleWindowFrameFlat" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ConsoleBackdrop}"/>
        <Setter Property="BorderBrush" Value="#29FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ═══ Icons ═══ -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconBubble" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="#1FFFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Round icon chip used for feature icons on game cards. -->
    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="#B3060A16"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <!-- Adaptive trigger glyph: Trigger button labelled R2 (instantly readable at small sizes).
         Use with <ContentControl Template="{StaticResource TriggerGlyph}" Width=".." Height=".."/>. -->
    <ControlTemplate x:Key="TriggerGlyph" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Border Width="20" Height="17" CornerRadius="9,9,3.5,3.5" Background="White">
                <TextBlock Text="R2" FontSize="9.5" FontWeight="Bold" Foreground="#0A1430"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
            </Border>
        </Viewbox>
    </ControlTemplate>

    <!-- Haptics / vibration: solid controller with vibration waves on both sides. -->
    <DrawingImage x:Key="IconHaptic">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 L 24,24 L 0,24 Z"/>
                <GeometryDrawing Brush="White"
                                 Geometry="M 9,7.5 L 15,7.5 C 16.4,7.5 17.5,8.5 17.6,9.8 L 18.1,14 C 18.1,15.4 17.1,16.5 15.8,16.5 C 15.1,16.5 14.5,16.1 14.1,15.7 L 13.4,15 C 13.1,14.7 12.7,14.6 12.3,14.6 L 11.7,14.6 C 11.3,14.6 10.9,14.7 10.6,15 L 9.9,15.7 C 9.5,16.1 8.9,16.5 8.2,16.5 C 6.9,16.5 5.9,15.4 5.9,14 L 6.4,9.8 C 6.5,8.5 7.6,7.5 9,7.5 Z"/>
                <GeometryDrawing Geometry="M 3.4,9.4 C 2.6,10.8 2.6,13.2 3.4,14.6 M 20.6,9.4 C 21.4,10.8 21.4,13.2 20.6,14.6 M 0.9,7.4 C -0.5,10 -0.5,14 0.9,16.6 M 23.1,7.4 C 24.5,10 24.5,14 23.1,16.6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Touchpad remapping: touch surface with a fingertip. -->
    <DrawingImage x:Key="IconTouchpad">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 L 24,24 L 0,24 Z"/>
                <GeometryDrawing Geometry="M 5,5 L 19,5 C 20.7,5 22,6.3 22,8 L 22,14 C 22,15.7 20.7,17 19,17 L 5,17 C 3.3,17 2,15.7 2,14 L 2,8 C 2,6.3 3.3,5 5,5 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="1.8" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="White" Geometry="M 14.5,11 A 2.5,2.5 0 1 1 9.5,11 A 2.5,2.5 0 1 1 14.5,11 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Outline geometries for stroked icon paths (settings rows). -->

    <!-- ═══ Sliders & progress ═══ -->
    <!-- Fill uses the slider Foreground (blue by default, R/G/B sliders override it). -->
    <Style x:Key="EffectSlider" TargetType="Slider">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackBackground}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Foreground="{TemplateBinding Foreground}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.5"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConsoleProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource TrackBackground}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Switches & checks ═══ -->
    <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0,0,0"
                                 HorizontalAlignment="Left" Fill="{DynamicResource TextMuted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="22" Height="22" CornerRadius="11"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.6">
                        <Path x:Name="Tick" Data="M 6,11 L 9.5,14.5 L 16,8" Stroke="White"
                              StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExecutableCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Item" CornerRadius="10" Padding="12,9" Margin="0,1" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="#1FFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource GamepadFocusFill}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Shell" CornerRadius="12" Background="{DynamicResource SurfaceSubtle}" Padding="14,0" BorderThickness="1.5" BorderBrush="{DynamicResource CardBorder}"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Margin="14,0,30,0" VerticalAlignment="Center"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" Focusable="False">
                            <Border Background="#121A30" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="500" MaxHeight="240">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Gamepad glyphs (Xbox layout of the physical APEX) ═══ -->
    <Style x:Key="XboxBtnA" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="XboxTextA" TargetType="Rectangle">
        <Setter Property="Fill" Value="#2EBB4F"/>
        <Setter Property="OpacityMask">
            <Setter.Value><ImageBrush ImageSource="/ApexSenseBridgeTray;component/Resources/xbox-button-a.png"/></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="XboxBtnB" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="XboxTextB" TargetType="Rectangle">
        <Setter Property="Fill" Value="#F05252"/>
        <Setter Property="OpacityMask">
            <Setter.Value><ImageBrush ImageSource="/ApexSenseBridgeTray;component/Resources/xbox-button-b.png"/></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="XboxBtnX" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="XboxTextX" TargetType="Rectangle">
        <Setter Property="Fill" Value="#3B82F6"/>
        <Setter Property="OpacityMask">
            <Setter.Value><ImageBrush ImageSource="/ApexSenseBridgeTray;component/Resources/xbox-button-x.png"/></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="XboxBtnY" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="XboxTextY" TargetType="Rectangle">
        <Setter Property="Fill" Value="#F5C542"/>
        <Setter Property="OpacityMask">
            <Setter.Value><ImageBrush ImageSource="/ApexSenseBridgeTray;component/Resources/xbox-button-y.png"/></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GamepadBadgePill" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GamepadBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GamepadActionItem" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>
    <Style x:Key="GamepadActionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
    </Style>

    <Style x:Key="ControllerIconPath" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Data" Value="M 6,12 L 10,12 M 8,10 L 8,14 M 15,12.5 L 15.01,12.5 M 18,10.5 L 18.01,10.5 M 17.3,6 L 6.7,6 C 4.5,6 2.7,7.6 2.6,9.8 L 2,15 C 2,17.2 3.8,19 6,19 C 7.2,19 8.1,18.3 8.7,17.6 L 10.1,16.2 C 10.5,15.8 11.1,15.5 11.7,15.5 L 12.3,15.5 C 12.9,15.5 13.5,15.8 13.9,16.2 L 15.3,17.6 C 15.9,18.3 16.8,19 18,19 C 20.2,19 22,17.2 22,15 L 21.4,9.8 C 21.3,7.6 19.5,6 17.3,6 Z"/>
    </Style>

    <!-- ═══ Tabs & chips ═══ -->
    <Style x:Key="NavSegmentButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#8C97B2"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="0,0,30,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Margin="0,4,0,7" VerticalAlignment="Center"/>
                        <Border x:Name="Underline" Grid.Row="1" Height="3" Width="26" CornerRadius="1.5"
                                Background="White" HorizontalAlignment="Left" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="#D5DBEA"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterTabButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder" Height="30" CornerRadius="15" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock x:Name="TabTxt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                            <Setter TargetName="TabTxt" Property="Foreground" Value="#0A1020"/>
                            <Setter TargetName="TabTxt" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TileHoverBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Buttons (pills: MinHeight 36, radius 18; BorderBrush bound for the gamepad ring) ═══ -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="18"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#2EFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Circular icon button (36x36). -->
    <Style x:Key="BtnRound" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Tiny circular button (clear search): 24x24, radius 12. -->
    <Style x:Key="BtnTinyRound" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#1FFFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="Background" Value="#24EF4444"/>
        <Setter Property="Foreground" Value="#FF8A8A"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#40EF4444"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Always-visible support call to action. Fixed height 38 → perfect pill (radius 19). -->
    <Style x:Key="BtnSupport" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Pulsing crisp outline detached from the pill (no blur that gets cut off). -->
                        <Border x:Name="Halo" Margin="-4" CornerRadius="23" BorderBrush="{DynamicResource SupportGradient}"
                                BorderThickness="2" Opacity="0.45" IsHitTestVisible="False"/>
                        <Border x:Name="bg" CornerRadius="19" Padding="6,0,16,0" Background="{DynamicResource SupportGradient}"
                                BorderBrush="#59FFFFFF" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#5A0A1E" Opacity="0.6"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SupportGradientHover}"/>
                        </Trigger>
                        <!-- Started from a property trigger (not Loaded) so the named halo always exists,
                             including for support buttons that start collapsed. -->
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HaloPulse">
                                    <Storyboard RepeatBehavior="3x" AutoReverse="True" FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                                                         From="0.15" To="0.85" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="HaloPulse"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseBtn" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="17">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#24FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Surfaces ═══ -->
    <!-- Hover only changes style-level values: a gamepad/keyboard focus sets local values and wins. -->
    <Style x:Key="ConsoleTile" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CC1A2647"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingRow" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,16,18,10"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="4,0,0,12"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ValueLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Feature / info pill: height 26 → radius 13. Content is always vertically centred
         (implicit styles below apply to every child, so a bare TextBlock cannot drift to the top). -->
    <Style x:Key="FeaturePill" TargetType="Border">
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="StackPanel">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource FeaturePillBg}"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- Thin outline icon used inside pills (lighter than row icons). -->
    <Style x:Key="PillIconPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>

    <!-- Chevrons: Stretch=Uniform maps the geometry bounds to the element, so they are always optically centred. -->
    <Style x:Key="ChevronPath" TargetType="Path">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="White"/>
        <Setter Property="StrokeThickness" Value="2.2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Geometry x:Key="GeoChevronLeft">M 7,1 L 1,7 L 7,13</Geometry>
    <Geometry x:Key="GeoChevronRight">M 1,1 L 7,7 L 1,13</Geometry>

    <!-- "New" ribbon for recently added games (issue #29). Height 22 → radius 11. -->
    <Style x:Key="NewBadge" TargetType="Border">
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="{DynamicResource SupportGradient}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NewBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Floating shelf arrow (mouse users): 40x40 circle, appears when the shelf is hovered. -->
    <Style x:Key="ShelfArrowButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="20" Background="#D90B1226" BorderBrush="#4DFFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#F21E6FE8"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FeaturePillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FeaturePillIcon" TargetType="Image">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Small status tag (manual fix, excluded): height 22 → radius 11. -->
    <Style x:Key="StatusTag" TargetType="Border">
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- List rows bound to IsSelected (certified games). -->
    <Style x:Key="ConsoleCardItemStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            </Trigger>
            <!-- Selected: lifted fill; the crisp ring is a sibling FocusRing in the item template. -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource GamepadFocusFill}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
