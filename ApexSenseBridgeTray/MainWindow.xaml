<Window x:Class="ApexSenseBridgeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexSenseBridge"
        Icon="Resources/logo.png"
        Height="600" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- ══════════════════════════════════════════════════════════
             TOGGLE SWITCH — Fluent-style pill toggle (replaces checkbox)
             ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5">
                                <Grid>
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                             Fill="{DynamicResource TextMuted}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             CHECKBOX — Custom checkbox (4px rounded)
             ══════════════════════════════════════════════════════════ -->
        <Style x:Key="PsCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,0,10,0">
                                <Border x:Name="Box" CornerRadius="4" Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5"/>
                                <Path x:Name="Check" Data="M 3.5,9 L 7,12.5 L 14.5,4.5"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             PRIMARY BUTTON — Sleek Rounded Rectangle (CornerRadius 6)
             ══════════════════════════════════════════════════════════ -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             SECONDARY BUTTON — Sleek Rounded Rectangle (CornerRadius 6)
             ══════════════════════════════════════════════════════════ -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             INLINE SMALL BUTTON — Sleek Rounded Rectangle (CornerRadius 6)
             ══════════════════════════════════════════════════════════ -->
        <Style x:Key="BtnSmall" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         OUTER SHELL — Rounded window with border (simulates Mica)
         ══════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="12" Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            MouseLeftButtonDown="OnWindowDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ─────────────────────────────────────────────
                 TITLE BAR — Custom drag-able chrome with Official Logo
                 ───────────────────────────────────────────── -->
            <Border Grid.Row="0" Padding="20,14,16,10" Background="Transparent">
                <DockPanel>
                    <!-- Close + Minimise -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="─" Style="{StaticResource BtnSecondary}" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                BorderThickness="0" Click="OnHideWindowClick"/>
                        <Button Content="✕" Style="{StaticResource BtnSecondary}" Padding="6,2" FontSize="10"
                                BorderThickness="0" Click="OnHideWindowClick"/>
                    </StackPanel>

                    <!-- Official App Logo & Branding -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="Resources/logo.png" Height="40" Width="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ApexSenseBridge" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Pont DualSense → Flydigi APEX 5"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ─────────────────────────────────────────────
                 SCROLLABLE CONTENT AREA
                 ───────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
                <StackPanel>

                    <!-- ══════════ CARD 1 — SESSION STATUS ══════════ -->
                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="20,16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Status Badge (CornerRadius 6) -->
                                <Border x:Name="BadgeStatus" CornerRadius="6" Padding="10,3,10,3" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Background="{DynamicResource BadgeStandbyBg}">
                                    <TextBlock x:Name="TxtStatusBadge" Text="● En veille" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BadgeStandbyFg}"/>
                                </Border>

                                <!-- Active Game Title -->
                                <TextBlock x:Name="TxtActiveGame" Text="Aucun jeu actif" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="En attente d'un jeu compatible..." FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" x:Name="TxtWaitHint"/>
                            </StackPanel>

                            <!-- Right-side Feature Badges (vertical stack) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border CornerRadius="6" Background="{DynamicResource FeaturePillBg}"
                                        BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                        Padding="10,4" Margin="0,0,0,5" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtActiveProfile" Text="Standard" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PlayStationBlue}"/>
                                </Border>
                                <Border x:Name="PillTriggers" CornerRadius="6" Background="{DynamicResource FeaturePillBg}"
                                        BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                        Padding="10,4" Margin="0,0,0,5" HorizontalAlignment="Right" Opacity="0.4">
                                    <TextBlock Text="Gâchettes" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <Border x:Name="PillHaptics" CornerRadius="6" Background="{DynamicResource FeaturePillBg}"
                                        BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                        Padding="10,4" HorizontalAlignment="Right" Opacity="0.4">
                                    <TextBlock Text="Haptique" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══════════ CARD 2 — DETECTION SETTINGS ══════════ -->
                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="20,16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Détection automatique" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <!-- Auto-detect master toggle -->
                            <DockPanel Margin="0,0,0,12">
                                <CheckBox x:Name="ChkAutoDetect" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnAutoDetectChanged" Unchecked="OnAutoDetectChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Activer la détection" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Active le pont quand un jeu compatible est lancé"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,12"/>

                            <!-- Sub-criteria -->
                            <StackPanel x:Name="PnlTriggerCriteria" Margin="0,0,0,0">
                                <TextBlock Text="Lancer le pont uniquement pour :" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,10,10"/>

                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="ChkTriggerAdaptive" Style="{StaticResource PsCheckBox}"
                                              DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Checked="OnTriggerCriteriaChanged" Unchecked="OnTriggerCriteriaChanged"/>
                                    <TextBlock Text="Jeux avec gâchettes adaptatives" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <DockPanel>
                                    <CheckBox x:Name="ChkTriggerHaptic" Style="{StaticResource PsCheckBox}"
                                              DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Checked="OnTriggerCriteriaChanged" Unchecked="OnTriggerCriteriaChanged"/>
                                    <TextBlock Text="Jeux avec retour haptique" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══════════ CARD 3 — CONFIGURATION ══════════ -->
                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="20,16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Configuration" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <!-- Notifications toggle -->
                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="ChkNotifications" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Notifications" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Alerte Windows lors de l'activation du pont"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,14"/>

                            <!-- Manual bridge override -->
                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="ChkManualBridge" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnManualBridgeChanged" Unchecked="OnManualBridgeChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Forcer l'activation permanente" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Active le pont en continu sans attendre la détection d'un jeu"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,14"/>

                            <!-- Software Update Row -->
                            <DockPanel>
                                <Button Content="Vérifier" Style="{StaticResource BtnSmall}" DockPanel.Dock="Right"
                                        VerticalAlignment="Center" Click="OnCheckUpdatesClick"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mise à jour du logiciel" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtVersionInfo" Text="ApexSenseBridge v0.3.0"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══════════ OPTIONAL UPDATE BANNER ══════════ -->
                    <Border x:Name="BannerUpdate" CornerRadius="8" Background="{DynamicResource PlayStationBlue}"
                            Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
                        <DockPanel>
                            <Button Content="Télécharger" Style="{StaticResource BtnSecondary}"
                                    Background="White" Foreground="{DynamicResource PlayStationBlue}"
                                    BorderThickness="0" DockPanel.Dock="Right" Padding="12,5" FontSize="11.5" FontWeight="SemiBold"
                                    Click="OnDownloadUpdateClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUpdateTitle" Text="Mise à jour disponible !" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TxtUpdateSubtitle" Text="Une nouvelle version est prête au téléchargement"
                                           FontSize="11" Foreground="#E0F2FE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ══════════ CARD 4 — DATABASE & GAMES ══════════ -->
                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDatabaseInfo" Text="— jeux certifiés" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Base de données PCGamingWiki" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Liste des jeux" Style="{StaticResource BtnPrimary}"
                                        Padding="14,7" Margin="0,0,8,0" Click="OnOpenGameListClick"/>
                                <Button Content="Synchroniser" Style="{StaticResource BtnSmall}"
                                        Click="OnUpdateDatabaseClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ─────────────────────────────────────────────
                 FOOTER — Accent strip
                 ───────────────────────────────────────────── -->
            <Border Grid.Row="2" CornerRadius="0,0,12,12" Padding="16,10,16,14"
                    Background="{DynamicResource FooterBackground}">
                <DockPanel>
                    <TextBlock Text="ApexSenseBridge actif en arrière-plan" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <Button Content="Masquer" Style="{StaticResource BtnSecondary}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Click="OnHideWindowClick"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
