<Window x:Class="ApexSenseBridgeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexSenseBridge"
        Icon="Resources/app.ico"
        Height="630" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5">
                                <Grid>
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                             Fill="{DynamicResource TextMuted}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PsCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,0,10,0">
                                <Border x:Name="Box" CornerRadius="4" Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5"/>
                                <Path x:Name="Check" Data="M 3.5,9 L 7,12.5 L 14.5,4.5"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangOptionButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="5" Padding="10,4" Margin="0,0,4,0"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <TextBlock x:Name="TabTxt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="TabTxt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSmall" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            MouseLeftButtonDown="OnWindowDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,14,16,10" Background="Transparent">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="─" Style="{StaticResource BtnSecondary}" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                BorderThickness="0" Click="OnHideWindowClick"/>
                        <Button Content="✕" Style="{StaticResource BtnSecondary}" Padding="6,2" FontSize="10"
                                BorderThickness="0" Click="OnHideWindowClick"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="Resources/logo.png" Height="40" Width="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_AppName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Loc_AppSubtitle}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
                <StackPanel>

                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="20,16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border x:Name="BadgeStatus" CornerRadius="6" Padding="10,3,10,3" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Background="{DynamicResource BadgeStandbyBg}">
                                    <TextBlock x:Name="TxtStatusBadge" Text="{DynamicResource Loc_StatusBadgeStandby}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BadgeStandbyFg}"/>
                                </Border>

                                <TextBlock x:Name="TxtActiveGame" Text="{DynamicResource Loc_NoActiveGame}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Loc_WaitingHint}" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" x:Name="TxtWaitHint"/>
                                
                                <Button x:Name="BtnExcludeCurrentGame" Content="{DynamicResource Loc_BtnExcludeCurrent}" Style="{StaticResource BtnSecondary}"
                                        Padding="10,4" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Visibility="Collapsed" Click="OnExcludeCurrentGameClick"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border CornerRadius="6" Background="{DynamicResource FeaturePillBg}"
                                        BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                        Padding="10,4" Margin="0,0,0,5" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtActiveProfile" Text="Standard" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PlayStationBlue}"/>
                                </Border>
                                <Border x:Name="PillTriggers" CornerRadius="6" Background="{DynamicResource FeaturePillBg}"
                                        BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                        Padding="10,4" Margin="0,0,0,5" HorizontalAlignment="Right" Opacity="0.4">
                                    <TextBlock Text="{DynamicResource Loc_PillTriggers}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <Border x:Name="PillHaptics" CornerRadius="6" Background="{DynamicResource FeaturePillBg}"
                                        BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                        Padding="10,4" HorizontalAlignment="Right" Opacity="0.4">
                                    <TextBlock Text="{DynamicResource Loc_PillHaptics}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="20,16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SectionAutoDetect}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,12">
                                <CheckBox x:Name="ChkAutoDetect" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnAutoDetectChanged" Unchecked="OnAutoDetectChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_EnableDetection}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Loc_EnableDetectionHint}"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,12"/>

                            <StackPanel x:Name="PnlTriggerCriteria" Margin="0,0,0,0">
                                <TextBlock Text="{DynamicResource Loc_LaunchCriteria}" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,10,10"/>

                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="ChkTriggerAdaptive" Style="{StaticResource PsCheckBox}"
                                              DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Checked="OnTriggerCriteriaChanged" Unchecked="OnTriggerCriteriaChanged"/>
                                    <TextBlock Text="{DynamicResource Loc_CriteriaAdaptive}" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <DockPanel>
                                    <CheckBox x:Name="ChkTriggerHaptic" Style="{StaticResource PsCheckBox}"
                                              DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Checked="OnTriggerCriteriaChanged" Unchecked="OnTriggerCriteriaChanged"/>
                                    <TextBlock Text="{DynamicResource Loc_CriteriaHaptic}" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="20,16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SectionConfig}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                            <!-- Language Selector -->
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <RadioButton x:Name="RadLangEn" Content="English" Style="{StaticResource LangOptionButton}"
                                                 Checked="OnLanguageOptionChecked"/>
                                    <RadioButton x:Name="RadLangFr" Content="Français" Style="{StaticResource LangOptionButton}"
                                                 Checked="OnLanguageOptionChecked"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_Language}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Loc_LanguageHint}"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="ChkNotifications" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_Notifications}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Loc_NotificationsHint}"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox x:Name="ChkManualBridge" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnManualBridgeChanged" Unchecked="OnManualBridgeChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_ManualBridge}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Loc_ManualBridgeHint}"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,14"/>

                            <DockPanel>
                                <Button Content="{DynamicResource Loc_BtnCheck}" Style="{StaticResource BtnSmall}" DockPanel.Dock="Right"
                                        VerticalAlignment="Center" Click="OnCheckUpdatesClick"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_SoftwareUpdate}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtVersionInfo" Text="ApexSenseBridge v0.5.0"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BannerUpdate" CornerRadius="8" Background="{DynamicResource PlayStationBlue}"
                            Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
                        <DockPanel>
                            <Button Content="{DynamicResource Loc_BtnDownload}" Style="{StaticResource BtnSecondary}"
                                    Background="White" Foreground="{DynamicResource PlayStationBlue}"
                                    BorderThickness="0" DockPanel.Dock="Right" Padding="12,5" FontSize="11.5" FontWeight="SemiBold"
                                    Click="OnDownloadUpdateClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUpdateTitle" Text="{DynamicResource Loc_UpdateBannerTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TxtUpdateSubtitle" Text="{DynamicResource Loc_UpdateBannerSubtitle}"
                                           FontSize="11" Foreground="#E0F2FE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDatabaseInfo" Text="—" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="{DynamicResource Loc_DatabaseTitle}" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource Loc_BtnGameList}" Style="{StaticResource BtnPrimary}"
                                        Padding="14,7" Margin="0,0,8,0" Click="OnOpenGameListClick"/>
                                <Button Content="{DynamicResource Loc_BtnSync}" Style="{StaticResource BtnSmall}"
                                        Click="OnUpdateDatabaseClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" CornerRadius="0,0,12,12" Padding="16,10,16,14"
                    Background="{DynamicResource FooterBackground}">
                <DockPanel>
                    <TextBlock Text="{DynamicResource Loc_FooterStatus}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Loc_BtnHide}" Style="{StaticResource BtnSecondary}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Click="OnHideWindowClick"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
