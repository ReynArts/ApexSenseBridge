<Window x:Class="ApexSenseBridgeTray.RearButtonMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rear Buttons" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApexSenseBridgeTray;component/Themes/ConsoleTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RearRow" TargetType="Border" BasedOn="{StaticResource SettingRow}">
                <Setter Property="Height" Value="64"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="RearButtonName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RearButtonStatus" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#7F8DAD"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
            <!-- Self-contained dark dropdown: the window does not inherit the
                 executable picker's item style, so popup colors are set here. -->
            <Style x:Key="RearItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#E6ECFA"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Item" CornerRadius="8" Padding="12,8" Margin="0,1" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Item" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Item" Property="Background" Value="#2C3F72"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RearActionCombo" TargetType="ComboBox">
                <Setter Property="Width" Value="170"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#E6ECFA"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource RearItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Shell" CornerRadius="10" Background="#1B2238"
                                                    BorderThickness="1" BorderBrush="#3A4050">
                                                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#8C97B2" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Shell" Property="Background" Value="#252C44"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Shell" Property="BorderBrush" Value="#2979FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="#E6ECFA"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       VerticalOffset="6" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="#121A30" BorderBrush="#3A4050" BorderThickness="1" CornerRadius="12"
                                            Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="260">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ConsoleWindowFrameFlat}" CornerRadius="22" MouseLeftButtonDown="OnWindowDrag">
        <Grid Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource WindowCloseBtn}" Click="OnCloseClick" VerticalAlignment="Top"/>
                <Border Style="{StaticResource IconBubble}" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" Background="#331E6FE8">
                    <Ellipse Width="16" Height="16" Stroke="#FFFFFF" StrokeThickness="2"/>
                </Border>
                <TextBlock Text="Rear Buttons" FontSize="19" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="TxtInstructions" Grid.Row="1" TextWrapping="Wrap" FontSize="13"
                       Foreground="#AEB9D3" Margin="0,0,0,18"
                       Text="Press each rear button once. Its row lights up when the controller reports it. Then choose what it should do."/>

            <ScrollViewer x:Name="ScrollRearButtons" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-8,-8,-8,0">
                <StackPanel x:Name="PnlRearButtons" Margin="8"/>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtRearStatus" VerticalAlignment="Center" Foreground="#AEB9D3" FontSize="12" TextWrapping="Wrap"/>
                <Button x:Name="BtnSaveRearBindings" Grid.Column="1" Content="Save"
                        Style="{StaticResource BtnPrimary}" FontSize="14"
                        Click="OnSaveRearBindingsClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>