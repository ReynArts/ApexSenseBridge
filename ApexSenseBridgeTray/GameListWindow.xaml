<Window x:Class="ApexSenseBridgeTray.GameListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexSenseBridge — Jeux compatibles"
        Icon="Resources/app.ico"
        Height="680" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="ExcludeCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" CornerRadius="6" Padding="12,6"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Icon" Data="M 2,6 L 5,9 L 10,3"
                                      Stroke="{DynamicResource BadgeActiveFg}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Txt" Text="Inclus" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26EF4444"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#80EF4444"/>
                                <Setter TargetName="Icon" Property="Data" Value="M 2,2 L 8,8 M 8,2 L 2,8"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="#EF4444"/>
                                <Setter TargetName="Txt" Property="Text" Value="Exclu"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTabButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="6" Padding="12,6" Margin="0,0,6,0"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <TextBlock x:Name="TabTxt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="TabTxt" Property="Foreground" Value="White"/>
                                <Setter TargetName="TabTxt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            MouseLeftButtonDown="OnWindowDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,14,16,10" Background="Transparent">
                <DockPanel>
                    <Button Content="✕" Style="{StaticResource BtnSecondary}" Padding="6,2" FontSize="10"
                            BorderThickness="0" DockPanel.Dock="Right" VerticalAlignment="Top"
                            Click="OnCloseClick"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="Resources/logo.png" Height="36" Width="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Jeux compatibles DualSense" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Consultez les jeux certifiés et gérez les exclusions automatiques"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Padding="20,4,20,10">
                <StackPanel>
                    <Border CornerRadius="6" Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                            Padding="12,7" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="M410.587,371.351l-50.044-50.044l-39.866-39.866c20.505-28.842,32.685-63.996,32.685-102.009 c0-97.424-79.263-176.687-176.684-176.687C79.251,2.745,0,82.008,0,179.432c0,97.423,79.251,176.675,176.678,176.675 c40.698,0,78.116-13.963,108.01-37.167l68.508,68.508c0.841,0.841,1.784,1.509,2.705,2.207l18.194,18.188L410.587,371.351z M176.689,314.548c-74.503-0.006-135.111-60.622-135.111-135.111c0-74.5,60.614-135.108,135.111-135.108 c74.498,0,135.108,60.608,135.108,135.108c0,30.998-10.59,59.507-28.218,82.333c-5.833,7.537-12.374,14.49-19.642,20.654 C240.374,302.409,209.94,314.548,176.689,314.548z"
                                      Fill="{DynamicResource TextMuted}"/>
                            </Viewbox>

                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center"
                                     TextChanged="OnSearchTextChanged" CaretBrush="{DynamicResource PlayStationBlue}"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Rechercher un jeu..."
                                       FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Visible"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Style="{StaticResource BtnSecondary}"
                                    Padding="4,1" FontSize="9" BorderThickness="0" Visibility="Collapsed"
                                    Click="OnClearSearchClick"/>
                        </Grid>
                    </Border>

                    <DockPanel>
                        <TextBlock x:Name="TxtStats" Text="0 jeu affiché" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadAll" Content="Tous" Style="{StaticResource FilterTabButton}"
                                         IsChecked="True" Checked="OnFilterTabChanged"/>
                            <RadioButton x:Name="RadAdaptive" Content="Gâchettes" Style="{StaticResource FilterTabButton}"
                                         Checked="OnFilterTabChanged"/>
                            <RadioButton x:Name="RadHaptic" Content="Haptique" Style="{StaticResource FilterTabButton}"
                                         Checked="OnFilterTabChanged"/>
                            <RadioButton x:Name="RadExcluded" Content="Exclus" Style="{StaticResource FilterTabButton}"
                                         Checked="OnFilterTabChanged"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,4,20,8">
                <ItemsControl x:Name="LstGames">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,8" Opacity="{Binding CardOpacity}">
                                <DockPanel>
                                    <CheckBox Style="{StaticResource ExcludeCheckBox}" DockPanel.Dock="Right"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                              Click="OnGameExcludedToggled"/>

                                    <Border Width="34" Height="48" CornerRadius="6" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Center"
                                            DockPanel.Dock="Left">
                                        <Grid>
                                            <Viewbox Width="16" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Opacity="0.35" Visibility="{Binding PlaceholderVisibility}">
                                                <Path Data="M 3,2 L 13,2 A 1,1 0 0,1 14,3 L 14,15 A 1,1 0 0,1 13,16 L 3,16 A 1,1 0 0,1 2,15 L 2,3 A 1,1 0 0,1 3,2 Z M 5,6 L 11,6 M 5,9 L 11,9 M 5,12 L 9,12"
                                                      Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconVisibility}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        
                                        <WrapPanel Orientation="Horizontal">
                                            <Border CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                    BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                                    Padding="7,2" Margin="0,0,6,3"
                                                    Visibility="{Binding AdaptiveVisibility}">
                                                <TextBlock Text="Gâchettes adaptatives" FontSize="10" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>

                                            <Border CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                    BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                                    Padding="7,2" Margin="0,0,6,3"
                                                    Visibility="{Binding HapticVisibility}">
                                                <TextBlock Text="Retour haptique" FontSize="10" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>

                                            <Border CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                    BorderBrush="{DynamicResource FeaturePillBorder}" BorderThickness="1"
                                                    Padding="7,2" Margin="0,0,6,3"
                                                    Visibility="{Binding RemappingVisibility}">
                                                <TextBlock Text="Remapping pavé tactile" FontSize="10" FontWeight="Medium"
                                                           Foreground="{DynamicResource PlayStationBlue}"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" CornerRadius="0,0,12,12" Padding="20,12,20,14"
                    Background="{DynamicResource FooterBackground}">
                <DockPanel>
                    <TextBlock Text="Les exclusions sont automatiquement sauvegardées."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <Button Content="Fermer" Style="{StaticResource BtnPrimary}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Click="OnCloseClick"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
