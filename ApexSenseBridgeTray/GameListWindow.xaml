<Window x:Class="ApexSenseBridgeTray.GameListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexSenseBridge"
        Icon="Resources/app.ico"
        Height="720" Width="1120"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="XboxBtnA" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextA" TargetType="Rectangle">
            <Setter Property="Fill" Value="#2EBB4F"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-a.png"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="XboxBtnB" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextB" TargetType="Rectangle">
            <Setter Property="Fill" Value="#F05252"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-b.png"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="XboxBtnX" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextX" TargetType="Rectangle">
            <Setter Property="Fill" Value="#3B82F6"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-x.png"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="XboxBtnY" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextY" TargetType="Rectangle">
            <Setter Property="Fill" Value="#F5C542"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-y.png"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GamepadBadgePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GamepadBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GamepadActionItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="GamepadActionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="6"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5">
                            <Path x:Name="Tick" Data="M 5,11 L 9,15 L 17,7" Stroke="White"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controller Status Icon -->
        <Style x:Key="ControllerIconPath" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Data" Value="M 6,12 L 10,12 M 8,10 L 8,14 M 15,12.5 L 15.01,12.5 M 18,10.5 L 18.01,10.5 M 17.3,6 L 6.7,6 C 4.5,6 2.7,7.6 2.6,9.8 L 2,15 C 2,17.2 3.8,19 6,19 C 7.2,19 8.1,18.3 8.7,17.6 L 10.1,16.2 C 10.5,15.8 11.1,15.5 11.7,15.5 L 12.3,15.5 C 12.9,15.5 13.5,15.8 13.9,16.2 L 15.3,17.6 C 15.9,18.3 16.8,19 18,19 C 20.2,19 22,17.2 22,15 L 21.4,9.8 C 21.3,7.6 19.5,6 17.3,6 Z"/>
        </Style>

        <!-- Navigation Tabs Button -->
        <Style x:Key="NavSegmentButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="6" Padding="18,8"
                                Background="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Sub-Tabs -->
        <Style x:Key="FilterTabButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="5" Padding="12,5" Margin="0,0,6,0"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="Transparent" BorderThickness="0">
                            <TextBlock x:Name="TabTxt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="TabTxt" Property="Foreground" Value="White"/>
                                <Setter TargetName="TabTxt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#1AEF4444"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#4DEF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33EF4444"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33EF4444"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleCardItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                    <Setter Property="BorderThickness" Value="1.6"/>
                    <Setter Property="Background" Value="#101018"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="0"
                                              Color="#0070D1" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource WindowBackground}"
            BorderBrush="Transparent" BorderThickness="0"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Nav Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Dynamic Content -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAGGABLE) -->
            <Border Grid.Row="0" Padding="22,14,16,10" Background="Transparent"
                    MouseLeftButtonDown="OnWindowDrag">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Top Bar Controller Indicator -->
                        <Border x:Name="BadgeHeaderController" CornerRadius="8"
                                Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="0"
                                Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconHeaderController" Style="{StaticResource ControllerIconPath}"
                                      Stroke="{DynamicResource TextMuted}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtHeaderController" Text="APEX" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Content="&#x2500;" Style="{StaticResource WindowCloseBtn}" Margin="0,0,4,0"
                                Click="OnMinimizeClick"/>
                        <Button Content="&#x2715;" Style="{StaticResource WindowCloseBtn}"
                                Click="OnCloseClick"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                BorderBrush="Transparent" BorderThickness="0">
                            <Image Source="Resources/logo.png" Height="36" Width="36" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc_AppName}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. PRIMARY NAVIGATION SEGMENTED SWITCHER -->
            <Border Grid.Row="1" Padding="22,0,22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HintBumperLeft" Grid.Column="0" Style="{StaticResource GamepadBadgePill}" Margin="0,0,10,0" Visibility="Collapsed">
                        <TextBlock Text="LB" Style="{StaticResource GamepadBadgeText}"/>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBackground}"
                            BorderBrush="Transparent" BorderThickness="0"
                            Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="NavTabDashboard" Grid.Column="0"
                                         Style="{StaticResource NavSegmentButton}"
                                         IsChecked="True" Checked="OnNavTabChanged">
                                <TextBlock Text="{DynamicResource Loc_NavDashboard}" VerticalAlignment="Center"/>
                            </RadioButton>

                            <RadioButton x:Name="NavTabCertified" Grid.Column="1"
                                         Style="{StaticResource NavSegmentButton}"
                                         Checked="OnNavTabChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_NavCertifiedGames}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="10" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtNavCertifiedCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavTabLearned" Grid.Column="2"
                                         Style="{StaticResource NavSegmentButton}"
                                         Checked="OnNavTabChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_NavLearnedExecutables}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="10" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtNavLearnedCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavTabSettings" Grid.Column="3"
                                         Style="{StaticResource NavSegmentButton}"
                                         Checked="OnNavTabChanged">
                                <TextBlock Text="{DynamicResource Loc_NavSettings}" VerticalAlignment="Center"/>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <Border x:Name="HintBumperRight" Grid.Column="2" Style="{StaticResource GamepadBadgePill}" Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="RB" Style="{StaticResource GamepadBadgeText}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. DYNAMIC CONTENT AREA -->
            <Grid Grid.Row="2">

                <!-- ══════════ TAB 0: ACCUEIL / DASHBOARD (IMMERSIVE CONSOLE) ══════════ -->
                <Grid x:Name="PanelDashboard" Visibility="Visible" Margin="22,0,22,6">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Controller & Bridge Hero Card -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Central Hub Stats & Quick Actions -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Popular / Certified Shelf -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HERO BANNER: Controller Status & Quick Bridge -->
                    <Border Grid.Row="0" CornerRadius="12" Background="{DynamicResource CardBackground}"
                            BorderBrush="Transparent" BorderThickness="0"
                            Padding="22,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status & Capabilities -->
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Border x:Name="BadgeDashboardStatus" CornerRadius="6" Padding="10,3" Margin="0,0,10,0"
                                            Background="{DynamicResource BadgeStandbyBg}">
                                        <TextBlock x:Name="TxtDashboardStatus" Text="{DynamicResource Loc_StatusBadgeStandby}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BadgeStandbyFg}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="TxtDashboardGameTitle" Text="{DynamicResource Loc_NoActiveGame}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <TextBlock x:Name="TxtDashboardHint" Visibility="Collapsed"
                                           FontSize="12" Foreground="{DynamicResource TextMuted}"/>

                                <WrapPanel x:Name="PnlDashboardFeatures" Orientation="Horizontal">
                                    <Border x:Name="BadgeDashAdaptive" CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Loc_PillTriggers}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <Border x:Name="BadgeDashHaptic" CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Loc_PillHaptics}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <Border x:Name="BadgeDashTouchpad" CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Loc_PillTouchpad}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource PlayStationBlue}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Hidden placeholders to retain code-behind bindings -->
                                <Border x:Name="PnlDashboardActiveCover" Visibility="Collapsed">
                                    <Image x:Name="ImgDashboardActiveCover"/>
                                </Border>
                                <StackPanel x:Name="PnlDashboardStandbyCover" Visibility="Collapsed"/>
                            </StackPanel>
                                <Image x:Name="ImgDashboardController" Grid.Column="1" Width="180" Height="108"
                                       Margin="12,-8,0,-8" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Right: Manual Bridge Quick Console Tile -->
                            <Border x:Name="TileManualBridge" Grid.Column="1" CornerRadius="10"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="Transparent" BorderThickness="2"
                                    Padding="18,14" Margin="16,0,0,0" Width="260"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    MouseLeftButtonDown="OnToggleManualBridgeClick">
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="BadgeManualBridgeToggle" DockPanel.Dock="Right" CornerRadius="15" Width="52" Height="28"
                                            Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Ellipse x:Name="DotManualBridgeToggle" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                 Fill="{DynamicResource TextMuted}"/>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_ManualBridge}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CENTRAL HUB CARDS: Jeux Certifiés & Exécutables Appris -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Jeux Certifiés Hub -->
                        <Border x:Name="TileJumpGames" Grid.Column="0" CornerRadius="10"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="Transparent" BorderThickness="1.6"
                                Padding="20,16" Cursor="Hand"
                                MouseLeftButtonDown="OnJumpToGamesClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_NavCertifiedGames}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtDashCountGames" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource PlayStationBlue}" Margin="0,4,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Exécutables Appris Hub -->
                        <Border x:Name="TileJumpLearned" Grid.Column="2" CornerRadius="10"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="Transparent" BorderThickness="1.6"
                                Padding="20,16" Cursor="Hand"
                                MouseLeftButtonDown="OnJumpToLearnedClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_NavLearnedExecutables}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtDashCountLearned" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource PlayStationBlue}" Margin="0,4,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- HORIZONTAL SHELF: Jeux Certifiés Recommandés (Steam Big Picture / PS5 style) -->
                    <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource CardBackground}"
                            BorderBrush="Transparent" BorderThickness="0"
                            Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_NavCertifiedGames}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </DockPanel>

                            <ScrollViewer x:Name="ScrollDashboardShelf" Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl x:Name="LstDashboardFeatured">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="145" Height="205" Margin="0,0,12,4" CornerRadius="8"
                                                    Padding="7" Cursor="Hand"
                                                    MouseLeftButtonDown="OnDashboardFeaturedGameClicked">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource GamepadFocusBorder}"/>
                                                                <Setter Property="Background" Value="#101018"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="0"
                                                                                          Color="#0070D1" Opacity="0.8"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Cover Poster -->
                                                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True"
                                                            Background="#161E2E">
                                                        <Grid>
                                                            <Border Background="{Binding MonogramBackground}" Visibility="{Binding PlaceholderVisibility}">
                                                                <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold"
                                                                           Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Opacity="0.88"/>
                                                            </Border>
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding IconVisibility}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Title & Badges -->
                                                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Border CornerRadius="3" Background="{DynamicResource FeaturePillBg}"
                                                                    Padding="4,1" Margin="0,0,4,0" Visibility="{Binding AdaptiveVisibility}">
                                                                <TextBlock Text="{DynamicResource Loc_PillTriggers}" FontSize="8.5"
                                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Background="{DynamicResource FeaturePillBg}"
                                                                    Padding="4,1" Visibility="{Binding HapticVisibility}">
                                                                <TextBlock Text="{DynamicResource Loc_PillHaptics}" FontSize="8.5"
                                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════ TAB 1: JEUX CERTIFIÉS (MASTER-DETAIL) ══════════ -->
                <Grid x:Name="PanelCertifiedGames" Visibility="Collapsed" Margin="22,0,22,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="540"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Master List -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Bar & Filters -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <!-- Search Bar -->
                            <Border CornerRadius="6" Background="{DynamicResource ControlBackground}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="12,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M410.587,371.351l-50.044-50.044l-39.866-39.866c20.505-28.842,32.685-63.996,32.685-102.009 c0-97.424-79.263-176.687-176.684-176.687C79.251,2.745,0,82.008,0,179.432c0,97.423,79.251,176.675,176.678,176.675 c40.698,0,78.116-13.963,108.01-37.167l68.508,68.508c0.841,0.841,1.784,1.509,2.705,2.207l18.194,18.188L410.587,371.351z M176.689,314.548c-74.503-0.006-135.111-60.622-135.111-135.111c0-74.5,60.614-135.108,135.111-135.108 c74.498,0,135.108,60.608,135.108,135.108c0,30.998-10.59,59.507-28.218,82.333c-5.833,7.537-12.374,14.49-19.642,20.654 C240.374,302.409,209.94,314.548,176.689,314.548z"
                                              Fill="{DynamicResource TextMuted}"/>
                                    </Viewbox>

                                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center"
                                             TextChanged="OnSearchTextChanged" CaretBrush="{DynamicResource PlayStationBlue}"/>
                                    <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="{DynamicResource Loc_SearchPlaceholder}"
                                               FontSize="12.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Visibility="Visible"/>
                                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="&#x2715;" Style="{StaticResource BtnSecondary}"
                                             Padding="4,1" FontSize="9" BorderThickness="0" Visibility="Collapsed"
                                             Click="OnClearSearchClick"/>
                                </Grid>
                            </Border>

                            <!-- Sub-Filter Chips -->
                            <DockPanel>
                                <TextBlock x:Name="TxtStats" Text="&#x2014;" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadAll" Content="{DynamicResource Loc_TabAll}" Style="{StaticResource FilterTabButton}"
                                                 IsChecked="True" Checked="OnFilterTabChanged"/>
                                    <RadioButton x:Name="RadAdaptive" Content="{DynamicResource Loc_TabTriggers}" Style="{StaticResource FilterTabButton}"
                                                 Checked="OnFilterTabChanged"/>
                                    <RadioButton x:Name="RadHaptic" Content="{DynamicResource Loc_TabHaptics}" Style="{StaticResource FilterTabButton}"
                                                 Checked="OnFilterTabChanged"/>
                                    <RadioButton x:Name="RadExcluded" Content="{DynamicResource Loc_TabExcluded}" Style="{StaticResource FilterTabButton}"
                                                 Checked="OnFilterTabChanged"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- Scrollable Cards List -->
                        <ScrollViewer x:Name="ScrollCertified" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="LstGames">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ConsoleCardItemStyle}"
                                                Opacity="{Binding CardOpacity}"
                                                MouseLeftButtonDown="OnGameCardClicked">
                                            <DockPanel LastChildFill="True">
                                                <!-- Cover Thumbnail -->
                                                <Border Width="32" Height="44" CornerRadius="4"
                                                        BorderBrush="Transparent" BorderThickness="0"
                                                        ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                        DockPanel.Dock="Left">
                                                    <Grid>
                                                        <Border Background="{Binding MonogramBackground}" Visibility="{Binding PlaceholderVisibility}">
                                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.88"/>
                                                        </Border>
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding IconVisibility}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Title & Badges -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,4"/>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Border CornerRadius="3" Background="{DynamicResource FeaturePillBg}"
                                                                BorderBrush="Transparent" BorderThickness="0"
                                                                Padding="5,1" Margin="0,0,5,2"
                                                                Visibility="{Binding AdaptiveVisibility}">
                                                            <TextBlock Text="{DynamicResource Loc_PillTriggers}" FontSize="9.5"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="3" Background="{DynamicResource FeaturePillBg}"
                                                                BorderBrush="Transparent" BorderThickness="0"
                                                                Padding="5,1" Margin="0,0,5,2"
                                                                Visibility="{Binding HapticVisibility}">
                                                            <TextBlock Text="{DynamicResource Loc_PillHaptics}" FontSize="9.5"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="3" Background="#26EF4444"
                                                                BorderBrush="#80EF4444" BorderThickness="0"
                                                                Padding="5,1" Margin="0,0,5,2"
                                                                Visibility="{Binding ExcludedBadgeVisibility}">
                                                            <TextBlock Text="{DynamicResource Loc_StateExcluded}" FontSize="9.5"
                                                                       Foreground="#EF4444" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Column: Detail Pane for Selected Game -->
                    <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource CardBackground}"
                            BorderBrush="Transparent" BorderThickness="0"
                            Padding="20,18" Margin="0,0,0,0">
                        <Grid>
                            <!-- Empty Selection State -->
                            <TextBlock x:Name="TxtDetailEmpty" Text="{DynamicResource Loc_DetailNoGame}"
                                       FontSize="13" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                            <!-- Active Detail Content -->
                            <ScrollViewer x:Name="ScrollDetail" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel x:Name="PnlDetailContent">
                                    <!-- High-Res Cover Poster -->
                                    <Border Width="130" Height="185" CornerRadius="8"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Grid>
                                            <Border x:Name="PnlDetailMonogram" Background="#161E2E" Visibility="Visible">
                                                <TextBlock x:Name="TxtDetailInitials" Text="AS" FontSize="28" FontWeight="Bold"
                                                           Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image x:Name="ImgDetailCover" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <!-- Game Title -->
                                    <TextBlock x:Name="TxtDetailTitle" Text="Game Title" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- Features Pills -->
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                                        <Border x:Name="BadgeDetailAdaptive" CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                BorderBrush="Transparent" BorderThickness="0"
                                                Padding="8,3" Margin="3">
                                            <TextBlock Text="{DynamicResource Loc_CriteriaAdaptive}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                        <Border x:Name="BadgeDetailHaptic" CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                BorderBrush="Transparent" BorderThickness="0"
                                                Padding="8,3" Margin="3">
                                            <TextBlock Text="{DynamicResource Loc_CriteriaHaptic}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                        <Border x:Name="BadgeDetailTouchpad" CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                BorderBrush="Transparent" BorderThickness="0"
                                                Padding="8,3" Margin="3" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource Loc_PillTouchpad}" FontSize="11"
                                                       Foreground="{DynamicResource PlayStationBlue}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- APEX Profile Horizontal Switcher -->
                                    <Border CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            Padding="14,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_ApexProfile}" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"
                                                       HorizontalAlignment="Center"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="BtnProfileLeft" Grid.Column="0" Style="{StaticResource BtnSecondary}"
                                                        Width="34" Height="34" Padding="10" Click="OnCycleProfileLeftClick">
                                                    <Path Data="M 9,2 L 4,7 L 9,12" Stroke="{DynamicResource TextPrimary}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Button>

                                                <TextBlock x:Name="TxtDetailApexProfile" Grid.Column="1"
                                                           Text="{DynamicResource Loc_ApexProfileKeep}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PlayStationBlue}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <Button x:Name="BtnProfileRight" Grid.Column="2" Style="{StaticResource BtnSecondary}"
                                                        Width="34" Height="34" Padding="10" Click="OnCycleProfileRightClick">
                                                    <Path Data="M 4,2 L 9,7 L 4,12" Stroke="{DynamicResource TextPrimary}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    <!-- Exclude / Include Quick Button -->
                                    <Button x:Name="BtnDetailToggleExclude" Style="{StaticResource BtnSecondary}"
                                            Padding="14,8" HorizontalAlignment="Stretch"
                                            Click="OnDetailToggleExcludeClick">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Style="{StaticResource XboxBtnX}" Margin="0,0,8,0">
                                                <Rectangle Style="{StaticResource XboxTextX}"/>
                                            </Border>
                                            <TextBlock x:Name="TxtDetailExcludeAction" Text="{DynamicResource Loc_BtnExcludeCurrent}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════ TAB 2: EXÉCUTABLES APPRIS ══════════ -->
                <Grid x:Name="PanelLearnedExecutables" Visibility="Collapsed" Margin="22,0,22,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="0,0,0,10">
                        <StackPanel>
                            <!-- Search Bar Input for Learned Items -->
                            <Border CornerRadius="6" Background="{DynamicResource ControlBackground}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="12,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource XboxBtnY}" Margin="0,0,8,0">
                                        <Rectangle Style="{StaticResource XboxTextY}"/>
                                    </Border>

                                    <Viewbox Grid.Column="1" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M410.587,371.351l-50.044-50.044l-39.866-39.866c20.505-28.842,32.685-63.996,32.685-102.009 c0-97.424-79.263-176.687-176.684-176.687C79.251,2.745,0,82.008,0,179.432c0,97.423,79.251,176.675,176.678,176.675 c40.698,0,78.116-13.963,108.01-37.167l68.508,68.508c0.841,0.841,1.784,1.509,2.705,2.207l18.194,18.188L410.587,371.351z M176.689,314.548c-74.503-0.006-135.111-60.622-135.111-135.111c0-74.5,60.614-135.108,135.111-135.108 c74.498,0,135.108,60.608,135.108,135.108c0,30.998-10.59,59.507-28.218,82.333c-5.833,7.537-12.374,14.49-19.642,20.654 C240.374,302.409,209.94,314.548,176.689,314.548z"
                                              Fill="{DynamicResource TextMuted}"/>
                                    </Viewbox>

                                    <TextBox x:Name="TxtSearchLearned" Grid.Column="2" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center"
                                             TextChanged="OnSearchLearnedTextChanged" CaretBrush="{DynamicResource PlayStationBlue}"/>
                                    <TextBlock x:Name="TxtSearchLearnedPlaceholder" Grid.Column="2"
                                               Text="{DynamicResource Loc_LearnedSearchPlaceholder}"
                                               FontSize="12.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Visibility="Visible"/>
                                    <Button x:Name="BtnClearSearchLearned" Grid.Column="3" Content="&#x2715;" Style="{StaticResource BtnSecondary}"
                                            Padding="4,1" FontSize="9" BorderThickness="0" Visibility="Collapsed"
                                            Click="OnClearSearchLearnedClick"/>
                                </Grid>
                            </Border>

                            <!-- Actions Toolbar & Count -->
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="TxtLearnedStats" Text="&#x2014;" FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnSelectAllLearned" Content="{DynamicResource Loc_BtnSelectAll}" Style="{StaticResource BtnSecondary}"
                                            Margin="0,0,6,0" Click="OnSelectAllLearnedClick"/>
                                    <Button x:Name="BtnExportLearned" Content="{DynamicResource Loc_BtnExportLearned}"
                                            Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                            IsEnabled="False" Click="OnExportLearnedClick"/>
                                    <Button x:Name="BtnDeleteLearned" Content="{DynamicResource Loc_BtnDeleteLearned}"
                                            Style="{StaticResource BtnDanger}"
                                            IsEnabled="False" Click="OnDeleteLearnedClick"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Learned Cards List -->
                    <ScrollViewer x:Name="ScrollLearned" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Grid>
                            <ItemsControl x:Name="LstLearned">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8"
                                                Padding="14,12" Margin="0,0,0,8"
                                                MouseLeftButtonDown="OnLearnedItemClicked">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGamepadFocused}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GamepadFocusBorder}"/>
                                                            <Setter Property="Background" Value="#101018"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="0"
                                                                                      Color="#0070D1" Opacity="0.8"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                                          DockPanel.Dock="Left" Cursor="Hand"/>

                                                <Button Style="{StaticResource BtnDanger}" Padding="8,4" FontSize="11"
                                                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                                        ToolTip="{DynamicResource Loc_BtnDeleteSingle}"
                                                        Click="OnDeleteSingleLearnedItemClick">
                                                    <TextBlock Text="&#x2715;" FontSize="11"/>
                                                </Button>

                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding GameTitle}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <Border CornerRadius="4" Background="{DynamicResource ControlBackground}"
                                                                BorderBrush="Transparent" BorderThickness="0"
                                                                Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Executable}" FontSize="11"
                                                                       FontFamily="Consolas, Segoe UI" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PlayStationBlue}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                                    <WrapPanel Orientation="Horizontal">
                                                        <Border CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                                BorderBrush="Transparent" BorderThickness="0"
                                                                Padding="6,2" Margin="0,0,6,2">
                                                            <TextBlock Text="{Binding DetectionMethod}" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                                BorderBrush="Transparent" BorderThickness="0"
                                                                Padding="6,2" Margin="0,0,6,2">
                                                            <TextBlock Text="{Binding SessionsDisplay}" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="4" Background="{DynamicResource FeaturePillBg}"
                                                                BorderBrush="Transparent" BorderThickness="0"
                                                                Padding="6,2" Margin="0,0,6,2">
                                                            <TextBlock Text="{Binding LastSeenDisplay}" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State View -->
                            <StackPanel x:Name="PnlLearnedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="20,40" Visibility="Collapsed">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4">
                                        <Path Data="M 2,6 L 22,6 A 2,2 0 0,1 24,8 L 24,18 A 2,2 0 0,1 22,20 L 2,20 A 2,2 0 0,1 0,18 L 0,8 A 2,2 0 0,1 2,6 Z M 5,11 L 5,15 M 3,13 L 7,13 M 17,11 L 17,11.01 M 19,13 L 19,13.01 M 15,13 L 15,13.01 M 17,15 L 17,15.01"
                                              Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_LearnedEmpty}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLearnedEmptySubtitle" Text="{DynamicResource Loc_LearnedEmptySubtitle}"
                                           FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="360" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════ TAB 3: PARAMÈTRES (CONSOLE 2-COLONNES EXPANSIVE) ══════════ -->
                <ScrollViewer x:Name="ScrollSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="22,4,22,6" Focusable="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLONNE GAUCHE: MOTEUR DE DÉTECTION & CRITÈRES -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="22,18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_SectionDetectionEngine}" FontSize="14.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                                    <!-- Auto-Detect Toggle -->
                                    <Border x:Name="TileSettingAutoDetect" CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="1.6"
                                            Padding="16,12" Margin="0,0,0,14" Cursor="Hand"
                                            MouseLeftButtonDown="OnSettingAutoDetectToggled">
                                        <DockPanel LastChildFill="True">
                                            <Border x:Name="BadgeSettingAutoDetect" DockPanel.Dock="Right" CornerRadius="12" Width="40" Height="22"
                                                    Background="{DynamicResource ControlBackground}"
                                                    BorderBrush="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center">
                                                <Ellipse x:Name="DotSettingAutoDetect" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                         Fill="{DynamicResource TextMuted}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_EnableDetection}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Criteria Sub-toggles -->
                                    <StackPanel x:Name="PnlSettingCriteria">
                                        <TextBlock Text="{DynamicResource Loc_LaunchCriteria}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                                        <Border x:Name="TileSettingAdaptive" CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                                BorderBrush="Transparent" BorderThickness="1.6"
                                                Padding="14,11" Margin="0,0,0,8" Cursor="Hand"
                                                MouseLeftButtonDown="OnSettingAdaptiveToggled">
                                            <DockPanel>
                                                <Border x:Name="BadgeSettingAdaptive" DockPanel.Dock="Right" CornerRadius="10" Width="34" Height="18"
                                                        Background="{DynamicResource ControlBackground}"
                                                        BorderBrush="Transparent" BorderThickness="0"
                                                        VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotSettingAdaptive" Width="10" Height="10" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                             Fill="{DynamicResource TextMuted}"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Loc_CriteriaAdaptive}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <Border x:Name="TileSettingHaptic" CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                                BorderBrush="Transparent" BorderThickness="1.6"
                                                Padding="14,11" Cursor="Hand"
                                                MouseLeftButtonDown="OnSettingHapticToggled">
                                            <DockPanel>
                                                <Border x:Name="BadgeSettingHaptic" DockPanel.Dock="Right" CornerRadius="10" Width="34" Height="18"
                                                        Background="{DynamicResource ControlBackground}"
                                                        BorderBrush="Transparent" BorderThickness="0"
                                                        VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotSettingHaptic" Width="10" Height="10" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                             Fill="{DynamicResource TextMuted}"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Loc_CriteriaHaptic}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- COLONNE DROITE: PRÉFÉRENCES & SYSTÈME -->
                        <StackPanel Grid.Column="2">
                            <!-- Préférences -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="22,18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_SectionSystemPreferences}" FontSize="14.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                                    <!-- Notifications Toggle -->
                                    <Border x:Name="TileSettingNotifications" CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="1.6"
                                            Padding="16,12" Margin="0,0,0,12" Cursor="Hand"
                                            MouseLeftButtonDown="OnSettingNotificationsToggled">
                                        <DockPanel LastChildFill="True">
                                            <Border x:Name="BadgeSettingNotifications" DockPanel.Dock="Right" CornerRadius="12" Width="40" Height="22"
                                                    Background="{DynamicResource ControlBackground}"
                                                    BorderBrush="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center">
                                                <Ellipse x:Name="DotSettingNotifications" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                         Fill="{DynamicResource TextMuted}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_Notifications}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Lightbar Sync Toggle -->
                                    <Border x:Name="TileSettingSyncLightbar" CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="1.6"
                                            Padding="16,12" Margin="0,0,0,12" Cursor="Hand"
                                            MouseLeftButtonDown="OnSettingSyncLightbarToggled">
                                        <DockPanel LastChildFill="True">
                                            <Border x:Name="BadgeSettingSyncLightbar" DockPanel.Dock="Right" CornerRadius="12" Width="40" Height="22"
                                                    Background="{DynamicResource ControlBackground}"
                                                    BorderBrush="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center">
                                                <Ellipse x:Name="DotSettingSyncLightbar" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                         Fill="{DynamicResource TextMuted}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_SyncLightbar}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Language Switcher -->
                                    <Border x:Name="TileSettingLanguage" CornerRadius="8" Background="{DynamicResource ControlBackground}"
                                            BorderBrush="Transparent" BorderThickness="2" Cursor="Hand"
                                            Padding="16,12" MouseLeftButtonDown="OnLanguagePickerClick">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCurrentLanguage" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PlayStationBlue}" VerticalAlignment="Center"/>
                                                <Path Data="M 2,2 L 7,7 L 2,12" Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="8" Height="14" Stretch="Uniform" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_Language}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Updates Section -->
                            <!-- Diagnostic & Test de la Manette -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="22,18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_SectionControllerDiagnostic}" FontSize="14.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Loc_ControllerDiagnosticDesc}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Content="{DynamicResource Loc_BtnOpenControllerTest}" Style="{StaticResource BtnPrimary}"
                                            HorizontalAlignment="Left" Padding="16,8" Click="OnOpenControllerTestClick"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="22,18">
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="BtnCheckUpdates" Content="{DynamicResource Loc_BtnCheck}"
                                            Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right"
                                            VerticalAlignment="Center" Click="OnCheckUpdatesClick"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtVersionInfo" Text="ApexSenseBridge" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtUpdateStatus" Text="{DynamicResource Loc_SoftwareUpdate}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 4. FOOTER: CONSOLE GAMEPAD HUD -->
            <Border Grid.Row="3" CornerRadius="0,0,14,14" Padding="22,12,22,14"
                    Background="{DynamicResource FooterBackground}">
                <DockPanel LastChildFill="True">
                    <Button Content="{DynamicResource Loc_BtnClose}" Style="{StaticResource BtnPrimary}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Click="OnCloseClick"/>

                    <!-- Gamepad Action HUD -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <StackPanel x:Name="PnlGamepadHud" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- [LB/RB] Tabs -->
                            <StackPanel x:Name="HudTabs" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource GamepadBadgePill}">
                                    <TextBlock Text="LB / RB" Style="{StaticResource GamepadBadgeText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Tabs}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>

                            <!-- [A] Select -->
                            <StackPanel x:Name="HudSelect" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnA}">
                                    <Rectangle Style="{StaticResource XboxTextA}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Select}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>

                            <!-- [B] Close -->
                            <StackPanel x:Name="HudBack" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnB}">
                                    <Rectangle Style="{StaticResource XboxTextB}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Back}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>

                            <!-- [X] Action -->
                            <StackPanel x:Name="HudActionX" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnX}">
                                    <Rectangle Style="{StaticResource XboxTextX}"/>
                                </Border>
                                <TextBlock x:Name="TxtHudActionX" Text="{DynamicResource Loc_Gamepad_ToggleExclude}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>

                            <!-- [Y] Search -->
                            <StackPanel x:Name="HudActionY" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnY}">
                                    <Rectangle Style="{StaticResource XboxTextY}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Search}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>

                            <!-- [RS] Scroll -->
                            <StackPanel x:Name="HudScroll" Style="{StaticResource GamepadActionItem}" Margin="0">
                                <Border Style="{StaticResource GamepadBadgePill}">
                                    <TextBlock Text="RS" Style="{StaticResource GamepadBadgeText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Scroll}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
