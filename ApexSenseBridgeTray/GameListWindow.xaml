<Window x:Class="ApexSenseBridgeTray.GameListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexSenseBridge"
        Icon="Resources/app.ico"
        Height="740" Width="1160"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- ═══ Console palette (PS5-like) ═══
             Local overrides of the shared theme keys: this window is a console
             surface and always renders dark, whatever the Windows app theme. -->
        <SolidColorBrush x:Key="WindowBackground" Color="#060A16"/>
        <SolidColorBrush x:Key="CardBackground" Color="#B3111A31"/>
        <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="FooterBackground" Color="#00000000"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#1B2540"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#3A4768"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAB4CC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#68738F"/>
        <SolidColorBrush x:Key="BadgeActiveBg" Color="#2610B981"/>
        <SolidColorBrush x:Key="BadgeActiveFg" Color="#34D399"/>
        <SolidColorBrush x:Key="BadgeStandbyBg" Color="#1F5B8CFF"/>
        <SolidColorBrush x:Key="BadgeStandbyFg" Color="#8DB7FF"/>
        <SolidColorBrush x:Key="FeaturePillBg" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="FeaturePillBorder" Color="#00000000"/>
        <SolidColorBrush x:Key="PlayStationBlue" Color="#1E6FE8"/>
        <SolidColorBrush x:Key="PlayStationBluePressed" Color="#185CC4"/>
        <SolidColorBrush x:Key="PlayStationBlueActive" Color="#124A9E"/>
        <SolidColorBrush x:Key="GamepadFocusBorder" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TileHoverBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="TrackBackground" Color="#2A3552"/>

        <LinearGradientBrush x:Key="ConsoleBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0E1D45" Offset="0"/>
            <GradientStop Color="#081128" Offset="0.45"/>
            <GradientStop Color="#04060E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SupportGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4D7E" Offset="0"/>
            <GradientStop Color="#FF8A3D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SupportGradientHover" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF6A93" Offset="0"/>
            <GradientStop Color="#FFA25E" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══ Icons ═══ -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconBubble" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Controls ═══ -->
        <Style x:Key="EffectSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="Root">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackBackground}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="{DynamicResource PlayStationBlue}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#1E6FE8" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch rendered from the CheckBox state (grip vibrations). -->
        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0,0,0"
                                     HorizontalAlignment="Left" Fill="{DynamicResource TextMuted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExecutableCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="8"/></Style></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="10" Background="{DynamicResource ControlBackground}" Padding="12,9" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></Border></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Margin="12,0,28,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#121A30" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="500" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Gamepad glyphs (Xbox layout of the physical APEX) ═══ -->
        <Style x:Key="XboxBtnA" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextA" TargetType="Rectangle">
            <Setter Property="Fill" Value="#2EBB4F"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-a.png"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="XboxBtnB" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextB" TargetType="Rectangle">
            <Setter Property="Fill" Value="#F05252"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-b.png"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="XboxBtnX" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextX" TargetType="Rectangle">
            <Setter Property="Fill" Value="#3B82F6"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-x.png"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="XboxBtnY" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="XboxTextY" TargetType="Rectangle">
            <Setter Property="Fill" Value="#F5C542"/>
            <Setter Property="OpacityMask">
                <Setter.Value><ImageBrush ImageSource="Resources/xbox-button-y.png"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GamepadBadgePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GamepadBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GamepadActionItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style x:Key="GamepadActionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="11"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.6">
                            <Path x:Name="Tick" Data="M 6,11 L 9.5,14.5 L 16,8" Stroke="White"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControllerIconPath" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Data" Value="M 6,12 L 10,12 M 8,10 L 8,14 M 15,12.5 L 15.01,12.5 M 18,10.5 L 18.01,10.5 M 17.3,6 L 6.7,6 C 4.5,6 2.7,7.6 2.6,9.8 L 2,15 C 2,17.2 3.8,19 6,19 C 7.2,19 8.1,18.3 8.7,17.6 L 10.1,16.2 C 10.5,15.8 11.1,15.5 11.7,15.5 L 12.3,15.5 C 12.9,15.5 13.5,15.8 13.9,16.2 L 15.3,17.6 C 15.9,18.3 16.8,19 18,19 C 20.2,19 22,17.2 22,15 L 21.4,9.8 C 21.3,7.6 19.5,6 17.3,6 Z"/>
        </Style>

        <!-- Top-level console tabs: text + white underline on the active tab. -->
        <Style x:Key="NavSegmentButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8C97B2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Margin="0,4,0,7" VerticalAlignment="Center"/>
                            <Border x:Name="Underline" Grid.Row="1" Height="3" Width="26" CornerRadius="1.5"
                                    Background="White" HorizontalAlignment="Left" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="#D5DBEA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTabButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="15" Padding="14,5" Margin="0,0,6,0"
                                Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="1">
                            <TextBlock x:Name="TabTxt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabTxt" Property="Foreground" Value="#0A1020"/>
                                <Setter TargetName="TabTxt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TileHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons bind BorderBrush/BorderThickness so the gamepad focus ring is visible on every button. -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="20"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#24EF4444"/>
            <Setter Property="Foreground" Value="#FF8A8A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40EF4444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Always-visible support call to action: warm gradient that stands out on the blue console. -->
        <Style x:Key="BtnSupport" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="20" Padding="14,7,16,7" Background="{DynamicResource SupportGradient}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FF5A78" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SupportGradientHover}"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         From="0.25" To="0.8" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="17">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tile used by dashboard actions and settings rows (gamepad focus = white ring set from code). -->
        <Style x:Key="ConsoleTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16,18,10"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FeaturePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource FeaturePillBg}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>

        <Style x:Key="ConsoleCardItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="Background" Value="#26FFFFFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.35"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small feature icons shared by game cards (less text than labelled pills). -->
        <Geometry x:Key="GeoTrigger">M 6,21 L 6,10 C 6,5.5 9,3 13,3 L 19,3 L 19,8 L 14,8 C 12,8 11,9 11,11 L 11,21 Z</Geometry>
        <Geometry x:Key="GeoHaptic">M 2,12 C 4,6 6,6 8,12 C 10,18 12,18 14,12 C 16,6 18,6 20,12 C 21,15 22,15 22,15</Geometry>
        <Geometry x:Key="GeoTouchpad">M 3,6 L 21,6 L 21,18 L 3,18 Z M 12,6 L 12,12</Geometry>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource ConsoleBackdrop}"
            BorderBrush="#26FFFFFF" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <!-- Ambient light: soft blue halo in the upper right, like the PS5 home background. -->
            <Ellipse Width="760" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-220,-220,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#552A6BFF" Offset="0"/>
                        <GradientStop Color="#002A6BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="620" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-240,0,0,-200" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33163C9E" Offset="0"/>
                        <GradientStop Color="#00163C9E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ 1. TOP BAR (draggable) ═══ -->
                <Border Grid.Row="0" Padding="26,16,16,4" Background="Transparent" MouseLeftButtonDown="OnWindowDrag">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSupportKofi" Style="{StaticResource BtnSupport}"
                                    ToolTip="{DynamicResource Loc_SupportProjectDescription}"
                                    Margin="0,0,14,0" Click="OnSupportKofiClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12,21 C 10,19 3,14 3,8.5 C 3,5.5 5.2,3.5 8,3.5 C 9.8,3.5 11.2,4.5 12,5.8 C 12.8,4.5 14.2,3.5 16,3.5 C 18.8,3.5 21,5.5 21,8.5 C 21,14 14,19 12,21 Z"
                                          Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc_SupportShort}" VerticalAlignment="Center"/>
                                    <Border x:Name="HintSupportMenu" Style="{StaticResource GamepadBadgePill}" Margin="10,0,0,0"
                                            BorderBrush="#B3FFFFFF" Background="#26FFFFFF" Visibility="Collapsed">
                                        <TextBlock Text="&#x2630;" Style="{StaticResource GamepadBadgeText}" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border x:Name="BadgeHeaderController" CornerRadius="16"
                                    Background="#14FFFFFF" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconHeaderController" Style="{StaticResource ControllerIconPath}"
                                          Stroke="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtHeaderController" Text="APEX" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtClock" FontSize="15" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <Button Content="&#x2500;" Style="{StaticResource WindowCloseBtn}" Margin="0,0,2,0" Click="OnMinimizeClick"/>
                            <Button Content="&#x2715;" Style="{StaticResource WindowCloseBtn}" Click="OnCloseClick"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Resources/logo.png" Height="32" Width="32" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Loc_AppName}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═══ 2. CONSOLE TABS (LB / RB) ═══ -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="26,8,26,14">
                    <Border x:Name="HintBumperLeft" Style="{StaticResource GamepadBadgePill}" Margin="0,0,18,4" Visibility="Collapsed">
                        <TextBlock Text="LB" Style="{StaticResource GamepadBadgeText}"/>
                    </Border>

                    <RadioButton x:Name="NavTabDashboard" Style="{StaticResource NavSegmentButton}"
                                 IsChecked="True" Checked="OnNavTabChanged">
                        <TextBlock Text="{DynamicResource Loc_NavDashboard}"/>
                    </RadioButton>
                    <RadioButton x:Name="NavTabCertified" Style="{StaticResource NavSegmentButton}" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc_NavCertifiedGames}"/>
                            <TextBlock x:Name="TxtNavCertifiedCount" Text="0" FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Top"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTabLearned" Style="{StaticResource NavSegmentButton}" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc_NavLearnedExecutables}"/>
                            <TextBlock x:Name="TxtNavLearnedCount" Text="0" FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Top"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTabSettings" Style="{StaticResource NavSegmentButton}" Checked="OnNavTabChanged">
                        <TextBlock Text="{DynamicResource Loc_NavSettings}"/>
                    </RadioButton>

                    <Border x:Name="HintBumperRight" Style="{StaticResource GamepadBadgePill}" Margin="-12,0,0,4" Visibility="Collapsed">
                        <TextBlock Text="RB" Style="{StaticResource GamepadBadgeText}"/>
                    </Border>
                </StackPanel>

                <!-- ═══ 3. CONTENT ═══ -->
                <Grid Grid.Row="2">

                    <!-- ────────── TAB 0 : HOME ────────── -->
                    <Grid x:Name="PanelDashboard" Visibility="Visible" Margin="26,0,26,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HERO: active game over its blurred cover art + controller -->
                        <Grid Grid.Row="0" MinHeight="176" Margin="0,0,0,14">
                            <Border x:Name="PnlDashboardActiveCover" Visibility="Collapsed" IsHitTestVisible="False" Margin="-26,-40,-26,-10">
                                <Border.OpacityMask>
                                    <RadialGradientBrush Center="0.3,0.5" GradientOrigin="0.3,0.5" RadiusX="0.7" RadiusY="0.8">
                                        <GradientStop Color="#C0000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.OpacityMask>
                                <Image x:Name="ImgDashboardActiveCover" Stretch="UniformToFill" Opacity="0.45">
                                    <Image.Effect><BlurEffect Radius="28"/></Image.Effect>
                                </Image>
                            </Border>
                            <StackPanel x:Name="PnlDashboardStandbyCover" Visibility="Collapsed"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,24,0">
                                    <Border x:Name="BadgeDashboardStatus" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left"
                                            Margin="0,0,0,10" Background="{DynamicResource BadgeStandbyBg}">
                                        <TextBlock x:Name="TxtDashboardStatus" Text="{DynamicResource Loc_StatusBadgeStandby}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BadgeStandbyFg}"/>
                                    </Border>
                                    <TextBlock x:Name="TxtDashboardGameTitle" Text="{DynamicResource Loc_NoActiveGame}"
                                               FontSize="34" FontWeight="Light" Foreground="White"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="96" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="PnlDashboardFeatures" Orientation="Horizontal">
                                        <Border x:Name="BadgeDashAdaptive" Style="{StaticResource FeaturePill}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoTrigger}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Loc_PillTriggers}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="BadgeDashHaptic" Style="{StaticResource FeaturePill}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoHaptic}" Style="{StaticResource IconPath}" Width="12" Height="11" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Loc_PillHaptics}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="BadgeDashTouchpad" Style="{StaticResource FeaturePill}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoTouchpad}" Style="{StaticResource IconPath}" Width="12" Height="10" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Loc_PillTouchpad}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtDashboardHint" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextMuted}" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Grid Grid.Column="1" Width="300" Height="180" VerticalAlignment="Center">
                                    <Ellipse Width="300" Height="190" IsHitTestVisible="False"
                                             Visibility="{Binding Visibility, ElementName=ImgDashboardController}">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#702C74FF" Offset="0"/>
                                                <GradientStop Color="#002C74FF" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Faint silhouette while no exact controller picture is available. -->
                                    <Path IsHitTestVisible="False" Width="190" Height="140">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource ControllerIconPath}">
                                                <Setter Property="Stroke" Value="#2EFFFFFF"/>
                                                <Setter Property="StrokeThickness" Value="1.2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=ImgDashboardController}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Image x:Name="ImgDashboardController" Width="270" Height="170" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.6"/>
                                        </Image.Effect>
                                    </Image>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- QUICK ACTIONS (or guided recovery when a session was interrupted) -->
                        <Border x:Name="PnlSessionRecovery" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,16" Padding="20,16"
                                CornerRadius="16" Background="#26F59E0B" BorderBrush="#80F59E0B" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock x:Name="TxtRecoveryTitle" FontSize="15" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtRecoverySteps" FontSize="12" Foreground="#FCD58A" Margin="0,7,0,5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtRecoveryHint" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnResumeSession" Content="{DynamicResource Loc_RecoveryResume}" Style="{StaticResource BtnPrimary}" Click="OnResumeSessionClick" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnDismissRecovery" Content="{DynamicResource Loc_RecoveryDismiss}" Style="{StaticResource BtnSecondary}" Click="OnDismissRecoveryClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="PnlDashboardCounts" Grid.Row="1" Margin="0,0,0,16" Height="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="TileManualBridge" Grid.Column="0" Style="{StaticResource ConsoleTile}"
                                    MouseLeftButtonDown="OnToggleManualBridgeClick">
                                <DockPanel LastChildFill="True">
                                    <Border Style="{StaticResource IconBubble}" DockPanel.Dock="Left" Margin="0,0,14,0" Background="#331E6FE8">
                                        <Path Data="M 13,2 L 4,14 L 11,14 L 10,22 L 20,9 L 13,9 Z" Style="{StaticResource IconPath}" Width="17" Height="17"/>
                                    </Border>
                                    <Border x:Name="BadgeManualBridgeToggle" DockPanel.Dock="Right" CornerRadius="12" Width="46" Height="26"
                                            Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotManualBridgeToggle" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                 Fill="{DynamicResource TextMuted}"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc_ManualBridge}" FontSize="14" Foreground="White"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                               ToolTip="{DynamicResource Loc_ManualBridgeHint}"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="TileJumpGames" Grid.Column="2" Style="{StaticResource ConsoleTile}"
                                    MouseLeftButtonDown="OnJumpToGamesClick">
                                <DockPanel>
                                    <Border Style="{StaticResource IconBubble}" DockPanel.Dock="Left" Margin="0,0,14,0">
                                        <Path Data="M 3,3 L 10,3 L 10,10 L 3,10 Z M 14,3 L 21,3 L 21,10 L 14,10 Z M 3,14 L 10,14 L 10,21 L 3,21 Z M 14,14 L 21,14 L 21,21 L 14,21 Z"
                                              Style="{StaticResource IconPath}" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDashCountGames" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{DynamicResource Loc_NavCertifiedGames}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border x:Name="TileJumpLearned" Grid.Column="4" Style="{StaticResource ConsoleTile}"
                                    MouseLeftButtonDown="OnJumpToLearnedClick">
                                <DockPanel>
                                    <Border Style="{StaticResource IconBubble}" DockPanel.Dock="Left" Margin="0,0,14,0">
                                        <Path Data="M 9,11 L 12,14 L 21,4 M 20,12 L 20,19 C 20,20 19,21 18,21 L 5,21 C 4,21 3,20 3,19 L 3,6 C 3,5 4,4 5,4 L 15,4"
                                              Style="{StaticResource IconPath}" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDashCountLearned" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{DynamicResource Loc_NavLearnedExecutables}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- GAME SHELF -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Loc_NavCertifiedGames}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="2,0,0,6"/>

                            <ScrollViewer x:Name="ScrollDashboardShelf" Grid.Row="1"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="LstDashboardFeatured" Margin="4,8,4,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="132" Margin="0,0,16,0" Cursor="Hand"
                                                        MouseLeftButtonDown="OnDashboardFeaturedGameClicked">
                                                <Border x:Name="Poster" Height="176" CornerRadius="14" BorderThickness="2"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="Background" Value="#161E36"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="White"/>
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="White" Opacity="0.4"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border CornerRadius="12" ClipToBounds="True">
                                                        <Grid>
                                                            <Border Background="{Binding MonogramBackground}" CornerRadius="12" Visibility="{Binding PlaceholderVisibility}">
                                                                <TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Light"
                                                                           Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border CornerRadius="12" Visibility="{Binding IconVisibility}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                                                <Border Width="22" Height="22" CornerRadius="11" Background="#B3060A16" Margin="0,0,4,0"
                                                                        Visibility="{Binding AdaptiveVisibility}" ToolTip="{DynamicResource Loc_PillTriggers}">
                                                                    <Path Data="{StaticResource GeoTrigger}" Style="{StaticResource IconPath}" Width="10" Height="10" StrokeThickness="1.5"/>
                                                                </Border>
                                                                <Border Width="22" Height="22" CornerRadius="11" Background="#B3060A16"
                                                                        Visibility="{Binding HapticVisibility}" ToolTip="{DynamicResource Loc_PillHaptics}">
                                                                    <Path Data="{StaticResource GeoHaptic}" Style="{StaticResource IconPath}" Width="11" Height="9" StrokeThickness="1.5"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="12" Margin="2,8,2,0"
                                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ────────── TAB 1 : CERTIFIED GAMES ────────── -->
                    <Grid x:Name="PanelCertifiedGames" Visibility="Collapsed" Margin="26,0,26,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <Border CornerRadius="20" Background="#14FFFFFF" Padding="14,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M 10,3 A 7,7 0 1 0 10.001,3 Z M 15.5,15.5 L 21,21"
                                              Style="{StaticResource IconPath}" Stroke="{DynamicResource TextMuted}" Width="14" Height="14" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center"
                                                 TextChanged="OnSearchTextChanged" CaretBrush="White"/>
                                        <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="{DynamicResource Loc_SearchPlaceholder}"
                                                   FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                        <Button x:Name="BtnClearSearch" Grid.Column="2" Content="&#x2715;" Style="{StaticResource BtnSecondary}"
                                                Padding="6,1" FontSize="9" Visibility="Collapsed" Click="OnClearSearchClick"/>
                                        <Border Grid.Column="3" Style="{StaticResource XboxBtnY}" Margin="8,0,0,0">
                                            <Rectangle Style="{StaticResource XboxTextY}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <DockPanel>
                                    <TextBlock x:Name="TxtStats" Text="&#x2014;" FontSize="11.5"
                                               Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadAll" Content="{DynamicResource Loc_TabAll}" Style="{StaticResource FilterTabButton}"
                                                     IsChecked="True" Checked="OnFilterTabChanged"/>
                                        <RadioButton x:Name="RadAdaptive" Content="{DynamicResource Loc_TabTriggers}" Style="{StaticResource FilterTabButton}"
                                                     Checked="OnFilterTabChanged"/>
                                        <RadioButton x:Name="RadHaptic" Content="{DynamicResource Loc_TabHaptics}" Style="{StaticResource FilterTabButton}"
                                                     Checked="OnFilterTabChanged"/>
                                        <RadioButton x:Name="RadExcluded" Content="{DynamicResource Loc_TabExcluded}" Style="{StaticResource FilterTabButton}"
                                                     Checked="OnFilterTabChanged"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <ScrollViewer x:Name="ScrollCertified" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl x:Name="LstGames">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ConsoleCardItemStyle}"
                                                    Opacity="{Binding CardOpacity}"
                                                    MouseLeftButtonDown="OnGameCardClicked">
                                                <DockPanel LastChildFill="True">
                                                    <Border Width="38" Height="52" CornerRadius="8" ClipToBounds="True" Margin="0,0,14,0"
                                                            VerticalAlignment="Center" DockPanel.Dock="Left">
                                                        <Grid>
                                                            <Border Background="{Binding MonogramBackground}" CornerRadius="8" Visibility="{Binding PlaceholderVisibility}">
                                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border CornerRadius="8" Visibility="{Binding IconVisibility}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                                                        <Border CornerRadius="10" Background="#26F59E0B" Padding="8,2" Margin="0,0,6,0"
                                                                ToolTip="{DynamicResource Loc_ManualFixHint}" Visibility="{Binding ManualFixVisibility}">
                                                            <TextBlock Text="{DynamicResource Loc_PillManualFix}" FontSize="10.5" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border CornerRadius="10" Background="#26EF4444" Padding="8,2" Margin="0,0,6,0"
                                                                Visibility="{Binding ExcludedBadgeVisibility}">
                                                            <TextBlock Text="{DynamicResource Loc_StateExcluded}" FontSize="10.5" Foreground="#FF8A8A" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Width="26" Height="26" CornerRadius="13" Background="#14FFFFFF" Margin="0,0,4,0"
                                                                Visibility="{Binding AdaptiveVisibility}" ToolTip="{DynamicResource Loc_PillTriggers}">
                                                            <Path Data="{StaticResource GeoTrigger}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.5"/>
                                                        </Border>
                                                        <Border Width="26" Height="26" CornerRadius="13" Background="#14FFFFFF"
                                                                Visibility="{Binding HapticVisibility}" ToolTip="{DynamicResource Loc_PillHaptics}">
                                                            <Path Data="{StaticResource GeoHaptic}" Style="{StaticResource IconPath}" Width="12" Height="10" StrokeThickness="1.5"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Detail of the selected game -->
                        <Border Grid.Column="2" CornerRadius="20" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="20,20,20,14">
                            <Grid>
                                <TextBlock x:Name="TxtDetailEmpty" Text="{DynamicResource Loc_DetailNoGame}"
                                           FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <ScrollViewer x:Name="ScrollDetail" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <StackPanel x:Name="PnlDetailContent">
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="104" Height="146" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.55"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Border x:Name="PnlDetailMonogram" Background="#1B2747" CornerRadius="12">
                                                        <TextBlock x:Name="TxtDetailInitials" Text="AS" FontSize="30" FontWeight="Light"
                                                                   Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image x:Name="ImgDetailCover" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,104,146" RadiusX="12" RadiusY="12"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                                                <TextBlock x:Name="TxtDetailTitle" Text="Game Title" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                <WrapPanel>
                                                    <Border x:Name="BadgeDetailAdaptive" Style="{StaticResource FeaturePill}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource GeoTrigger}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Loc_PillTriggers}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                                       ToolTip="{DynamicResource Loc_CriteriaAdaptive}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="BadgeDetailHaptic" Style="{StaticResource FeaturePill}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource GeoHaptic}" Style="{StaticResource IconPath}" Width="12" Height="10" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Loc_PillHaptics}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                                       ToolTip="{DynamicResource Loc_CriteriaHaptic}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="BadgeDetailManualFix" Style="{StaticResource FeaturePill}" Background="#26F59E0B"
                                                            ToolTip="{DynamicResource Loc_ManualFixHint}" Visibility="Collapsed">
                                                        <TextBlock Text="{DynamicResource Loc_PillManualFix}" FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border x:Name="BadgeDetailTouchpad" Style="{StaticResource FeaturePill}" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource GeoTouchpad}" Style="{StaticResource IconPath}" Width="12" Height="10" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Loc_PillTouchpad}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- APEX profile: D-pad left/right -->
                                        <Border CornerRadius="16" Background="#12FFFFFF" Padding="8" Margin="0,0,0,10"
                                                ToolTip="{DynamicResource Loc_ApexProfileHint}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnProfileLeft" Grid.Column="0" Style="{StaticResource BtnSecondary}"
                                                        Width="36" Height="36" Padding="0" Click="OnCycleProfileLeftClick">
                                                    <Path Data="M 9,2 L 4,7 L 9,12" Stroke="White" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Loc_ApexProfile}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtDetailApexProfile" Text="{DynamicResource Loc_ApexProfileKeep}"
                                                               FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="BtnProfileRight" Grid.Column="2" Style="{StaticResource BtnSecondary}"
                                                        Width="36" Height="36" Padding="0" Click="OnCycleProfileRightClick">
                                                    <Path Data="M 4,2 L 9,7 L 4,12" Stroke="White" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Button x:Name="BtnDetailToggleExclude" Style="{StaticResource BtnSecondary}"
                                                Padding="14,9" HorizontalAlignment="Stretch" Margin="0,0,0,18"
                                                Click="OnDetailToggleExcludeClick">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border Style="{StaticResource XboxBtnX}" Margin="0,0,8,0">
                                                    <Rectangle Style="{StaticResource XboxTextX}"/>
                                                </Border>
                                                <TextBlock x:Name="TxtDetailExcludeAction" Text="{DynamicResource Loc_BtnExcludeCurrent}"
                                                           FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Advanced: optional executable association -->
                                        <TextBlock Text="{DynamicResource Loc_GameExecutable}" ToolTip="{DynamicResource Loc_GameExecutableHint}"
                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,6"/>
                                        <ComboBox x:Name="CmbGameExecutable" Style="{StaticResource ExecutableCombo}" DisplayMemberPath="Label"
                                                  SelectionChanged="OnGameExecutableChanged" Margin="0,0,0,6"
                                                  ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock x:Name="TxtExecutablePath" Foreground="{DynamicResource TextMuted}" FontSize="10.5"
                                                   TextWrapping="Wrap" Margin="4,0,0,8"/>
                                        <Button Content="{DynamicResource Loc_BrowseExecutable}" Style="{StaticResource BtnSecondary}"
                                                HorizontalAlignment="Left" Padding="14,6" FontSize="11.5" Click="OnBrowseGameExecutable"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ────────── TAB 2 : LEARNED EXECUTABLES ────────── -->
                    <Grid x:Name="PanelLearnedExecutables" Visibility="Collapsed" Margin="26,0,26,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Border CornerRadius="20" Background="#14FFFFFF" Padding="14,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M 10,3 A 7,7 0 1 0 10.001,3 Z M 15.5,15.5 L 21,21"
                                          Style="{StaticResource IconPath}" Stroke="{DynamicResource TextMuted}" Width="14" Height="14" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TxtSearchLearned" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center"
                                             TextChanged="OnSearchLearnedTextChanged" CaretBrush="White"/>
                                    <TextBlock x:Name="TxtSearchLearnedPlaceholder" Grid.Column="1"
                                               Text="{DynamicResource Loc_LearnedSearchPlaceholder}"
                                               FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <Button x:Name="BtnClearSearchLearned" Grid.Column="2" Content="&#x2715;" Style="{StaticResource BtnSecondary}"
                                            Padding="6,1" FontSize="9" Visibility="Collapsed" Click="OnClearSearchLearnedClick"/>
                                    <Border Grid.Column="3" Style="{StaticResource XboxBtnY}" Margin="8,0,0,0">
                                        <Rectangle Style="{StaticResource XboxTextY}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="TxtLearnedStats" Text="&#x2014;" FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnSelectAllLearned" Content="{DynamicResource Loc_BtnSelectAll}" Style="{StaticResource BtnSecondary}"
                                            Margin="0,0,8,0" Click="OnSelectAllLearnedClick"/>
                                    <Button x:Name="BtnExportLearned" Content="{DynamicResource Loc_BtnExportLearned}"
                                            Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"
                                            IsEnabled="False" Click="OnExportLearnedClick"/>
                                    <Button x:Name="BtnDeleteLearned" Content="{DynamicResource Loc_BtnDeleteLearned}"
                                            Style="{StaticResource BtnDanger}" IsEnabled="False" Click="OnDeleteLearnedClick"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <ScrollViewer x:Name="ScrollLearned" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <Grid>
                                <ItemsControl x:Name="LstLearned">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="14" Padding="14,11" Margin="0,0,8,8" Cursor="Hand"
                                                    MouseLeftButtonDown="OnLearnedItemClicked">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0DFFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#17FFFFFF"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsGamepadFocused}" Value="True">
                                                                <Setter Property="BorderBrush" Value="White"/>
                                                                <Setter Property="Background" Value="#26FFFFFF"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.35"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel LastChildFill="True">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}"
                                                              VerticalAlignment="Center" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                                                    <Button Style="{StaticResource BtnDanger}" Padding="9,5" DockPanel.Dock="Right"
                                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                                            ToolTip="{DynamicResource Loc_BtnDeleteSingle}" Click="OnDeleteSingleLearnedItemClick">
                                                        <TextBlock Text="&#x2715;" FontSize="10"/>
                                                    </Button>
                                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Border Style="{StaticResource FeaturePill}" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding SessionsDisplay}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource FeaturePill}" Margin="0">
                                                            <TextBlock Text="{Binding LastSeenDisplay}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                            <TextBlock Text="{Binding GameTitle}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="8" Background="#261E6FE8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Executable}" FontSize="11" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                                           Foreground="#8DB7FF"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DetectionMethod}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel x:Name="PnlLearnedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="20,50" Visibility="Collapsed">
                                    <Border Width="72" Height="72" CornerRadius="36" Background="#14FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,18">
                                        <Path Style="{StaticResource ControllerIconPath}" Stroke="{DynamicResource TextSecondary}"
                                              Width="34" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc_LearnedEmpty}" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtLearnedEmptySubtitle" Text="{DynamicResource Loc_LearnedEmptySubtitle}"
                                               FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               TextAlignment="Center" MaxWidth="380" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ────────── TAB 3 : SETTINGS ────────── -->
                    <ScrollViewer x:Name="ScrollSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Padding="26,0,26,4" Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: general -->
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_SectionDetectionEngine}" Style="{StaticResource SectionTitle}"/>

                                        <Border x:Name="TileSettingAutoDetect" Style="{StaticResource SettingRow}" Cursor="Hand"
                                                MouseLeftButtonDown="OnSettingAutoDetectToggled" ToolTip="{DynamicResource Loc_EnableDetectionHint}">
                                            <DockPanel>
                                                <Border x:Name="BadgeSettingAutoDetect" DockPanel.Dock="Right" CornerRadius="12" Width="44" Height="24"
                                                        Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                        BorderThickness="1.5" VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotSettingAutoDetect" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                             Fill="{DynamicResource TextMuted}"/>
                                                </Border>
                                                <Path DockPanel.Dock="Left" Data="M 12,3 A 9,9 0 1 0 12.001,3 Z M 12,8 A 4,4 0 1 0 12.001,8 Z"
                                                      Style="{StaticResource IconPath}" Width="17" Height="17" Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource Loc_EnableDetection}" Style="{StaticResource RowLabel}"/>
                                            </DockPanel>
                                        </Border>

                                        <StackPanel x:Name="PnlSettingCriteria" Margin="22,0,0,0">
                                            <Border x:Name="TileSettingAdaptive" Style="{StaticResource SettingRow}" Cursor="Hand"
                                                    MouseLeftButtonDown="OnSettingAdaptiveToggled" ToolTip="{DynamicResource Loc_LaunchCriteria}">
                                                <DockPanel>
                                                    <Border x:Name="BadgeSettingAdaptive" DockPanel.Dock="Right" CornerRadius="12" Width="44" Height="24"
                                                            Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                            BorderThickness="1.5" VerticalAlignment="Center">
                                                        <Ellipse x:Name="DotSettingAdaptive" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                                 Fill="{DynamicResource TextMuted}"/>
                                                    </Border>
                                                    <Path DockPanel.Dock="Left" Data="{StaticResource GeoTrigger}" Style="{StaticResource IconPath}"
                                                          Width="15" Height="15" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{DynamicResource Loc_CriteriaAdaptive}" Style="{StaticResource RowLabel}" FontSize="13"/>
                                                </DockPanel>
                                            </Border>
                                            <Border x:Name="TileSettingHaptic" Style="{StaticResource SettingRow}" Cursor="Hand"
                                                    MouseLeftButtonDown="OnSettingHapticToggled" ToolTip="{DynamicResource Loc_LaunchCriteria}">
                                                <DockPanel>
                                                    <Border x:Name="BadgeSettingHaptic" DockPanel.Dock="Right" CornerRadius="12" Width="44" Height="24"
                                                            Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                            BorderThickness="1.5" VerticalAlignment="Center">
                                                        <Ellipse x:Name="DotSettingHaptic" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                                 Fill="{DynamicResource TextMuted}"/>
                                                    </Border>
                                                    <Path DockPanel.Dock="Left" Data="{StaticResource GeoHaptic}" Style="{StaticResource IconPath}"
                                                          Width="16" Height="13" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{DynamicResource Loc_CriteriaHaptic}" Style="{StaticResource RowLabel}" FontSize="13"/>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_SectionSystemPreferences}" Style="{StaticResource SectionTitle}"/>

                                        <Border x:Name="TileSettingNotifications" Style="{StaticResource SettingRow}" Cursor="Hand"
                                                MouseLeftButtonDown="OnSettingNotificationsToggled" ToolTip="{DynamicResource Loc_NotificationsHint}">
                                            <DockPanel>
                                                <Border x:Name="BadgeSettingNotifications" DockPanel.Dock="Right" CornerRadius="12" Width="44" Height="24"
                                                        Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                        BorderThickness="1.5" VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotSettingNotifications" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                             Fill="{DynamicResource TextMuted}"/>
                                                </Border>
                                                <Path DockPanel.Dock="Left" Data="M 6,16 L 6,11 C 6,7.5 8.7,5 12,5 C 15.3,5 18,7.5 18,11 L 18,16 L 20,18 L 4,18 Z M 10,21 L 14,21"
                                                      Style="{StaticResource IconPath}" Width="16" Height="16" Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource Loc_Notifications}" Style="{StaticResource RowLabel}"/>
                                            </DockPanel>
                                        </Border>

                                        <Border x:Name="TileSettingLanguage" Style="{StaticResource SettingRow}" Cursor="Hand"
                                                MouseLeftButtonDown="OnLanguagePickerClick" ToolTip="{DynamicResource Loc_LanguageHint}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtCurrentLanguage" Style="{StaticResource ValueLabel}" Foreground="{DynamicResource TextSecondary}"/>
                                                    <Path Data="M 2,2 L 7,7 L 2,12" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7" Height="12" Stretch="Uniform" Margin="12,0,4,0"/>
                                                </StackPanel>
                                                <Path DockPanel.Dock="Left" Data="M 12,3 A 9,9 0 1 0 12.001,3 Z M 3,12 L 21,12 M 12,3 C 8,7 8,17 12,21 M 12,3 C 16,7 16,17 12,21"
                                                      Style="{StaticResource IconPath}" Width="16" Height="16" Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource Loc_Language}" Style="{StaticResource RowLabel}"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_SectionControllerDiagnostic}" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button x:Name="BtnOpenControllerTest" Style="{StaticResource BtnPrimary}" Margin="0,0,8,8"
                                                    ToolTip="{DynamicResource Loc_ControllerDiagnosticDesc}" Click="OnOpenControllerTestClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 3,12 L 7,12 L 10,5 L 14,19 L 17,12 L 21,12" Style="{StaticResource IconPath}"
                                                          Stroke="White" Width="14" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Loc_BtnTestController}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnPreparedLaunch" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                                    ToolTip="{DynamicResource Loc_PreparedLaunchHint}" Click="OnPreparedLaunchClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 7,4 L 19,12 L 7,20 Z" Fill="White" Stretch="Uniform" Width="10" Height="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Loc_PreparedLaunch}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnReportBug" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                                    ToolTip="{DynamicResource Loc_BugReportSectionDescription}" Click="OnReportBugClick">
                                                <TextBlock Text="{DynamicResource Loc_BugReportSectionTitle}"/>
                                            </Button>
                                        </WrapPanel>
                                        <DockPanel Margin="4,0,0,6">
                                            <Button x:Name="BtnCheckUpdates" Content="{DynamicResource Loc_BtnCheck}"
                                                    Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right"
                                                    VerticalAlignment="Center" Click="OnCheckUpdatesClick"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtVersionInfo" Text="ApexSenseBridge" FontSize="13" Foreground="White"/>
                                                <TextBlock x:Name="TxtUpdateStatus" Text="{DynamicResource Loc_SoftwareUpdate}" FontSize="11"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT: controller feel (per model) -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Path DockPanel.Dock="Left" Style="{StaticResource ControllerIconPath}" Stroke="{DynamicResource TextMuted}"
                                                  Width="17" Height="13" Margin="4,0,8,12" VerticalAlignment="Top"/>
                                            <TextBlock Text="{DynamicResource Loc_ControllerEffects}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtControllerCalibrationStatus" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="4,0,0,12" ToolTip="{DynamicResource Loc_EffectsHint}"/>

                                        <Border x:Name="TileSettingSyncLightbar" Style="{StaticResource SettingRow}" Cursor="Hand" Visibility="Collapsed"
                                                MouseLeftButtonDown="OnSettingSyncLightbarToggled" ToolTip="{DynamicResource Loc_SyncLightbarHint}">
                                            <DockPanel>
                                                <Border x:Name="BadgeSettingSyncLightbar" DockPanel.Dock="Right" CornerRadius="12" Width="44" Height="24"
                                                        Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                        BorderThickness="1.5" VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotSettingSyncLightbar" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                                                             Fill="{DynamicResource TextMuted}"/>
                                                </Border>
                                                <Path DockPanel.Dock="Left" Data="M 12,2 L 12,5 M 12,19 L 12,22 M 2,12 L 5,12 M 19,12 L 22,12 M 5,5 L 7,7 M 17,17 L 19,19 M 5,19 L 7,17 M 17,7 L 19,5 M 12,8 A 4,4 0 1 0 12.001,8 Z"
                                                      Style="{StaticResource IconPath}" Width="16" Height="16" Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource Loc_SyncLightbar}" Style="{StaticResource RowLabel}"/>
                                            </DockPanel>
                                        </Border>

                                        <StackPanel x:Name="PnlControllerEffects" Visibility="Collapsed">
                                            <Border x:Name="RowTriggerStrength" Style="{StaticResource SettingRow}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock x:Name="TxtTriggerStrength" DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"/>
                                                        <TextBlock Text="{DynamicResource Loc_TriggerStrength}" Style="{StaticResource RowLabel}"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SliderTriggerStrength" Style="{StaticResource EffectSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnEffectSettingChanged" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="RowVibrationStrength" Style="{StaticResource SettingRow}" ToolTip="{DynamicResource Loc_VibrationStrengthHint}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock x:Name="TxtVibrationStrength" DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"/>
                                                        <TextBlock Text="{DynamicResource Loc_VibrationStrength}" Style="{StaticResource RowLabel}"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SliderVibrationStrength" Style="{StaticResource EffectSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnEffectSettingChanged" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel x:Name="PnlApex4GyroSettings" Visibility="Collapsed">
                                                <Border x:Name="RowGyroStrength" Style="{StaticResource SettingRow}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock x:Name="TxtApex4GyroStrength" DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"/>
                                                            <TextBlock Text="{DynamicResource Loc_Apex4GyroStrength}" Style="{StaticResource RowLabel}"/>
                                                        </DockPanel>
                                                        <Slider x:Name="SliderApex4GyroStrength" Style="{StaticResource EffectSlider}" Minimum="25" Maximum="400" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="OnEffectSettingChanged" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="RowGyroYawStrength" Style="{StaticResource SettingRow}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock x:Name="TxtApex4GyroYawStrength" DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"/>
                                                            <TextBlock Text="{DynamicResource Loc_Apex4GyroYawStrength}" Style="{StaticResource RowLabel}"/>
                                                        </DockPanel>
                                                        <Slider x:Name="SliderApex4GyroYawStrength" Style="{StaticResource EffectSlider}" Minimum="25" Maximum="400" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="OnEffectSettingChanged" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel x:Name="PnlHapticThresholdSettings" Visibility="Collapsed">
                                                <Border x:Name="RowVibrationThreshold" Style="{StaticResource SettingRow}" ToolTip="{DynamicResource Loc_EffectsHint}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock x:Name="TxtVibrationThreshold" DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"/>
                                                            <TextBlock Text="{DynamicResource Loc_VibrationThreshold}" Style="{StaticResource RowLabel}"/>
                                                        </DockPanel>
                                                        <Slider x:Name="SliderVibrationThreshold" Style="{StaticResource EffectSlider}" Minimum="0" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnEffectSettingChanged" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Border x:Name="RowGripVibrations" Style="{StaticResource SettingRow}" Cursor="Hand"
                                                    MouseLeftButtonDown="OnGripVibrationsRowClick">
                                                <DockPanel>
                                                    <CheckBox x:Name="ChkGripVibrations" DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}"
                                                              VerticalAlignment="Center" Click="OnGripVibrationsChanged"/>
                                                    <TextBlock Text="{DynamicResource Loc_EnableRumble}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ 4. GAMEPAD HUD ═══ -->
                <Border Grid.Row="3" Padding="26,10,26,14" Background="{DynamicResource FooterBackground}" MinHeight="18">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="PnlGamepadHud" Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel x:Name="HudTabs" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource GamepadBadgePill}"><TextBlock Text="LB / RB" Style="{StaticResource GamepadBadgeText}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Tabs}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudAdjust" Style="{StaticResource GamepadActionItem}" Visibility="Collapsed">
                                <Border Style="{StaticResource GamepadBadgePill}"><TextBlock Text="&#x25C0; &#x25B6;" Style="{StaticResource GamepadBadgeText}" FontSize="8.5"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Adjust}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudFilter" Style="{StaticResource GamepadActionItem}" Visibility="Collapsed">
                                <Border Style="{StaticResource GamepadBadgePill}"><TextBlock Text="&#x29C9;" Style="{StaticResource GamepadBadgeText}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Filter}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudActionY" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnY}"><Rectangle Style="{StaticResource XboxTextY}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Search}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudActionX" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnX}"><Rectangle Style="{StaticResource XboxTextX}"/></Border>
                                <TextBlock x:Name="TxtHudActionX" Text="{DynamicResource Loc_Gamepad_ToggleExclude}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudScroll" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource GamepadBadgePill}"><TextBlock Text="RS" Style="{StaticResource GamepadBadgeText}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Scroll}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudSupport" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource GamepadBadgePill}"><TextBlock Text="&#x2630;" Style="{StaticResource GamepadBadgeText}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_SupportShort}" Style="{StaticResource GamepadActionLabel}" Foreground="#FF8FA8"/>
                            </StackPanel>
                            <StackPanel x:Name="HudBack" Style="{StaticResource GamepadActionItem}">
                                <Border Style="{StaticResource XboxBtnB}"><Rectangle Style="{StaticResource XboxTextB}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Back}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="HudSelect" Style="{StaticResource GamepadActionItem}" Margin="0">
                                <Border Style="{StaticResource XboxBtnA}"><Rectangle Style="{StaticResource XboxTextA}"/></Border>
                                <TextBlock Text="{DynamicResource Loc_Gamepad_Select}" Style="{StaticResource GamepadActionLabel}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
