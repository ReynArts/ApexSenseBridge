<Window x:Class="ApexSenseBridgeTray.LanguagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_LanguageTitle}" Height="660" Width="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApexSenseBridgeTray;component/Themes/ConsoleTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One language row: code chip, native name, check mark when current. Focus ring set from code. -->
            <Style x:Key="LanguageRow" TargetType="Border" BasedOn="{StaticResource SettingRow}">
                <Setter Property="Height" Value="56"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="12,0,18,0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="LanguageCode" TargetType="Border">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="CornerRadius" Value="19"/>
                <Setter Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Margin" Value="0,0,14,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LanguageCodeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LanguageName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="CurrentCheck" TargetType="Border">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ConsoleWindowFrame}" MouseLeftButtonDown="OnWindowDrag">
        <Grid Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource WindowCloseBtn}" Click="OnCloseClick" VerticalAlignment="Top"/>
                <Border Style="{StaticResource IconBubble}" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" Background="#331E6FE8">
                    <Path Data="M 12,3 A 9,9 0 1 0 12.001,3 Z M 3,12 L 21,12 M 12,3 C 8,7 8,17 12,21 M 12,3 C 16,7 16,17 12,21"
                          Style="{StaticResource IconPath}" Width="18" Height="18"/>
                </Border>
                <TextBlock Text="{DynamicResource Loc_LanguageTitle}" FontSize="19" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Rows are generated from LanguageCatalog (every embedded dictionary). The inner margin leaves room for the focus ring. -->
            <ScrollViewer x:Name="ScrollLanguages" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-8,-8,-8,0">
                <StackPanel x:Name="PnlLanguages" Margin="8"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <StackPanel Style="{StaticResource GamepadActionItem}">
                    <Border Style="{StaticResource XboxBtnB}"><Rectangle Style="{StaticResource XboxTextB}"/></Border>
                    <TextBlock Text="{DynamicResource Loc_Gamepad_Back}" Style="{StaticResource GamepadActionLabel}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource GamepadActionItem}" Margin="0">
                    <Border Style="{StaticResource XboxBtnA}"><Rectangle Style="{StaticResource XboxTextA}"/></Border>
                    <TextBlock Text="{DynamicResource Loc_Gamepad_Select}" Style="{StaticResource GamepadActionLabel}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
