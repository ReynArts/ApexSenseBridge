<Window x:Class="ApexSenseBridgeTray.ReportChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_BugReportWindowTitle}"
        Icon="Resources/app.ico"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApexSenseBridgeTray;component/Themes/ConsoleTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ChoiceButton" TargetType="Button">
                <Setter Property="Height" Value="62"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card" CornerRadius="18" Background="#14FFFFFF"
                                    BorderBrush="Transparent" BorderThickness="2" Padding="16,0,18,0">
                                <DockPanel LastChildFill="True">
                                    <Path DockPanel.Dock="Right" Data="{StaticResource GeoChevronRight}"
                                          Style="{StaticResource ChevronPath}" Width="6" Height="10" StrokeThickness="2"/>
                                    <Border Style="{StaticResource IconBubble}" Width="40" Height="40" CornerRadius="20"
                                            Margin="0,0,14,0" Background="{Binding Tag.Tint, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Path Data="{Binding Tag.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource IconPath}" Width="19" Height="19"
                                              Stroke="{Binding Tag.Stroke, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="White"/>
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource GamepadFocusFill}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ConsoleWindowFrame}">
        <Grid Margin="26,20,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18" Background="Transparent" MouseLeftButtonDown="OnWindowDrag">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource WindowCloseBtn}"
                        VerticalAlignment="Top" Click="OnCloseClick"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_BugReportWindowTitle}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1">
                <Button x:Name="BtnChoiceBug" Style="{StaticResource ChoiceButton}" Click="OnChoiceClick">
                    <TextBlock Text="{DynamicResource Loc_ReportCategoryBug}"/>
                </Button>
                <Button x:Name="BtnChoiceFeature" Style="{StaticResource ChoiceButton}" Click="OnChoiceClick">
                    <TextBlock Text="{DynamicResource Loc_ReportCategoryFeature}"/>
                </Button>
                <Button x:Name="BtnChoiceGame" Style="{StaticResource ChoiceButton}" Click="OnChoiceClick">
                    <TextBlock Text="{DynamicResource Loc_ReportCategoryGame}"/>
                </Button>
                <Button x:Name="BtnChoiceLogs" Style="{StaticResource ChoiceButton}" Click="OnChoiceClick">
                    <TextBlock Text="{DynamicResource Loc_BtnExportLogs}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
