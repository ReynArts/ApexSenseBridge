<Window x:Class="ApexSenseBridgeTray.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_BugReportWindowTitle}"
        Icon="Resources/app.ico"
        Width="760" Height="690" MinWidth="660" MinHeight="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayStationBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayStationBlueActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33EF4444"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConsentCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5"
                                    Margin="0,0,10,0">
                                <Path x:Name="Tick" Data="M 5,11 L 9,15 L 17,7" Stroke="White"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStationBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource WindowBackground}"
            BorderBrush="Transparent" BorderThickness="0" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="22,14,16,10" Background="Transparent"
                    MouseLeftButtonDown="OnWindowDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource WindowCloseBtn}"
                            Click="OnCloseClick"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_BugReportWindowTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Loc_BugReportWindowSubtitle}" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,4,22,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_BugReportTitleLabel}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <Border CornerRadius="7" Background="{DynamicResource ControlBackground}"
                            BorderBrush="Transparent" BorderThickness="1" Margin="0,0,0,14">
                        <TextBox x:Name="TxtReportTitle" Style="{StaticResource ReportTextBox}" MaxLength="120"
                                 TextChanged="OnRequiredFieldChanged"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Loc_BugReportDescriptionLabel}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <Border CornerRadius="7" Background="{DynamicResource ControlBackground}"
                            BorderBrush="Transparent" BorderThickness="1" Margin="0,0,0,14">
                        <TextBox x:Name="TxtReportDescription" Style="{StaticResource ReportTextBox}"
                                 Height="125" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 TextChanged="OnRequiredFieldChanged"/>
                    </Border>

                    <Border CornerRadius="10" Background="{DynamicResource CardBackground}"
                            BorderBrush="Transparent" BorderThickness="0" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Loc_BtnAddScreenshots}" Style="{StaticResource BtnSecondary}"
                                            Margin="0,0,8,0" Click="OnAddScreenshotsClick"/>
                                    <Button x:Name="BtnRemoveScreenshot" Content="{DynamicResource Loc_BtnRemoveScreenshot}"
                                            Style="{StaticResource BtnSecondary}" IsEnabled="False"
                                            Click="OnRemoveScreenshotClick"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_BugReportScreenshotsLabel}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Loc_BugReportScreenshotsHint}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <ListBox x:Name="LstScreenshots" Margin="0,12,0,0" MaxHeight="92"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondary}"
                                     SelectionChanged="OnScreenshotSelectionChanged"
                                     Visibility="Collapsed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="&#x25CF;" Foreground="{DynamicResource PlayStationBlue}"
                                                       FontSize="8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Background="{DynamicResource CardBackground}"
                            BorderBrush="Transparent" BorderThickness="0" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button Content="{DynamicResource Loc_BtnPreviewDiagnostics}" Style="{StaticResource BtnSecondary}"
                                        DockPanel.Dock="Right" Margin="12,0,0,0" Click="OnPreviewDiagnosticsClick"/>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_BugReportDiagnosticsTitle}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Loc_BugReportDiagnosticsHint}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <Border x:Name="PnlDiagnosticPreview" CornerRadius="7" Background="{DynamicResource ControlBackground}"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBox x:Name="TxtDiagnosticPreview" Style="{StaticResource ReportTextBox}"
                                         IsReadOnly="True" Height="150" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="10.5" VerticalContentAlignment="Top"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkConsent" Style="{StaticResource ConsentCheckBox}"
                              Checked="OnConsentChanged" Unchecked="OnConsentChanged">
                        <TextBlock Text="{DynamicResource Loc_BugReportConsent}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    </CheckBox>

                    <TextBlock Text="{DynamicResource Loc_BugReportPrivacyHint}" FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="32,7,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" CornerRadius="0,0,14,14" Padding="22,12,22,14"
                    Background="{DynamicResource FooterBackground}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{DynamicResource Loc_Cancel}" Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0" Click="OnCloseClick"/>
                        <Button x:Name="BtnContinueGithub" Content="{DynamicResource Loc_BtnContinueGithub}"
                                Style="{StaticResource BtnPrimary}" IsEnabled="False"
                                Click="OnContinueGithubClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtValidationHint" Text="{DynamicResource Loc_BugReportRequiredHint}"
                               Foreground="{DynamicResource TextMuted}" FontSize="10.5"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
