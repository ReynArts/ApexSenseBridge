<Window x:Class="ApexSenseBridgeTray.LearnedExecutablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_LearnedWindowTitle}"
        Icon="Resources/app.ico"
        Height="470" Width="860"
        MinHeight="360" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Loc_LearnedWindowTitle}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Loc_LearnedWindowHint}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11.5" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                Background="{DynamicResource CardBackground}" CornerRadius="7">
            <Grid>
                <DataGrid x:Name="GridBindings"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource CardBorder}"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource ControlBackground}"
                          SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc_LearnedGame}" Binding="{Binding GameTitle}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_LearnedExecutable}" Binding="{Binding Executable}" Width="1.5*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_LearnedMethod}" Binding="{Binding DetectionMethod}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_LearnedSessions}" Binding="{Binding SuccessfulSessions}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_LearnedLastSeen}" Binding="{Binding LastSeenDisplay}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEmpty"
                           Text="{DynamicResource Loc_LearnedEmpty}"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtCount" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Loc_BtnSelectAll}" Style="{StaticResource ActionButton}"
                        Click="OnSelectAllClick"/>
                <Button x:Name="BtnDelete" Content="{DynamicResource Loc_BtnDeleteLearned}"
                        Style="{StaticResource ActionButton}" IsEnabled="False" Click="OnDeleteClick"/>
                <Button x:Name="BtnExport" Content="{DynamicResource Loc_BtnExportLearned}"
                        Style="{StaticResource ActionButton}" IsEnabled="False" Click="OnExportClick"/>
                <Button Content="{DynamicResource Loc_BtnClose}" Style="{StaticResource ActionButton}"
                        Click="OnCloseClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
