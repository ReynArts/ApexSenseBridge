#include <windows.h>
#include <winver.h>

#ifndef ASB_VERSION_MAJOR
#define ASB_VERSION_MAJOR 0
#define ASB_VERSION_MINOR 6
#define ASB_VERSION_PATCH 1
#define ASB_VERSION_STRING "0.6.1"
#endif

// Application Icon
1 ICON "../../../assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ASB_VERSION_MAJOR,ASB_VERSION_MINOR,ASB_VERSION_PATCH,0
 PRODUCTVERSION ASB_VERSION_MAJOR,ASB_VERSION_MINOR,ASB_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ApexSenseBridge contributors\0"
            VALUE "FileDescription", "ApexSenseBridge native application\0"
            VALUE "FileVersion", ASB_VERSION_STRING ".0\0"
            VALUE "ProductName", "ApexSenseBridge\0"
            VALUE "ProductVersion", ASB_VERSION_STRING ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
